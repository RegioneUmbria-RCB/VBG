  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm:build-less-watch\" \"npm:serve\"",
    "serve": "ng serve",
    "build": "concurrently \"npm:build-less-once\" \"ng build\"",
    "build-prod": "concurrently \"npm:build-less-once\" \"ng build --configuration production\"",
    "postbuild-prod": "subwcrev.exe . version.txt.tpl dist\\version.txt",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "postinstall": "npm run build-less-once",
    "build-less-once": "less-watch-compiler src\\assets\\themes src\\assets\\themes --run-once",
    "build-less-watch": "less-watch-compiler src\\assets\\themes src\\assets\\themes"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.12",
