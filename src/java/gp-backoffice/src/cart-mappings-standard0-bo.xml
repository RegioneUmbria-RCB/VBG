		</value>
	</cart-mapping>

<!-- questo mapping imposta un valore per ogni stradario con il valore di istanza.comune.provincia
se mancano glil stradari allora inserisce una riga con valore NP -->
	<cart-mapping>
		<id-semantico>ATTIVITA.INDIRIZZO.PROVINCIA</id-semantico>
		<value indexed-property="istanzestradarios">
			<vbg-value >
				<campo-statico>comune.siglaprovincia</campo-statico>
			</vbg-value>
			<vbg-value>
				<valore-fisso>NP</valore-fisso>
			</vbg-value>
		</value>
	</cart-mapping>

<!-- questo mapping imposta un valore per ciascuno stradario recuperandone il CAP
se il cap è vuoto viene inserito 00000, se non ci sono record di stradario 
associati all'istanza viene inserita una sola riga con valore 00000 -->
	<cart-mapping>
		<id-semantico>ATTIVITA.INDIRIZZO.CAP</id-semantico>
		<value>
			<vbg-value if-property="istanzestradarios.cap">
				<campo-statico>istanzestradarios.cap</campo-statico>
			</vbg-value>
			<vbg-value>
				<valore-fisso>00000</valore-fisso>
			</vbg-value>
		</value>
		<value-processing>
			<value-replace>
				<replace-match>\D</replace-match>
				<replace-with></replace-with>
			</value-replace>
		</value-processing>
	</cart-mapping>

	<cart-mapping>
		<id-semantico>ATTIVITA.INDIRIZZO.VIA</id-semantico>
		<value>
			<vbg-value>
				<campo-statico>istanzestradarios.stradario.descrizioneCompleta</campo-statico>
			</vbg-value>
			<vbg-value>
				<valore-fisso>non specificata</valore-fisso>
			</vbg-value>
		</value>
	</cart-mapping>

	<cart-mapping>
		<id-semantico>ATTIVITA.INDIRIZZO.PRESENZA_CIVICO</id-semantico>
		<value indexed-property="istanzestradarios">
			<vbg-value if-property="istanzestradarios.civico" if-operator="EXISTS">
				<valore-fisso>Numero civico ed eventuali esponenti</valore-fisso>
			</vbg-value>
			<vbg-value if-property="istanzestradarios.civico" if-operator="NOT_EXISTS">
