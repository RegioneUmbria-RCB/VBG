		</value>
	</cart-mapping>

	<cart-mapping>
		<id-semantico>ATTIVITA.INDIRIZZO.ALTRI_DATI</id-semantico>
		<value value-elaboration="APPEND" indexed-property="istanzestradarios">
			<vbg-value if-property="istanzestradarios.esponente">
				<valore-fisso>/</valore-fisso>
			</vbg-value>
			<vbg-value>
				<campo-statico>istanzestradarios.esponente</campo-statico>
			</vbg-value>
			<vbg-value if-property="istanzestradarios.stradariocolore.colore">
				<valore-fisso> </valore-fisso>
			</vbg-value>
			<vbg-value>
				<campo-statico>istanzestradarios.stradariocolore.colore</campo-statico>
			</vbg-value>
			<vbg-value if-property="istanzestradarios.interno">
				<valore-fisso>, int.</valore-fisso>
			</vbg-value>
			<vbg-value>
				<campo-statico>istanzestradarios.interno</campo-statico>
			</vbg-value>
			<vbg-value if-property="istanzestradarios.esponenteinterno">
				<valore-fisso>/</valore-fisso>
			</vbg-value>
			<vbg-value>
				<campo-statico>istanzestradarios.esponenteinterno</campo-statico>
			</vbg-value>
			<vbg-value if-property="istanzestradarios.piano">
				<valore-fisso>, piano </valore-fisso>
			</vbg-value>
			<vbg-value>
				<campo-statico>istanzestradarios.piano</campo-statico>
			</vbg-value>
