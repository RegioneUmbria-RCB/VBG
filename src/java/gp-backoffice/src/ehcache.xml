<?xml version="1.0" encoding="UTF-8"?>
<ehcache updateCheck="false">
	<diskStore path="java.io.tmpdir/cache_backend" />
	<defaultCache maxElementsInMemory="500" eternal="true"
		overflowToDisk="false" memoryStoreEvictionPolicy="LRU" />
	<cache name="CACHE_MENU_KEY" maxElementsInMemory="100"
		maxElementsOnDisk="1000" eternal="true" overflowToDisk="true"
		diskSpoolBufferSizeMB="20" memoryStoreEvictionPolicy="LRU"
		diskPersistent="true" />
	<cache name="CACHE_OGGETTIDISABILITATI_KEY" maxElementsInMemory="100"
		maxElementsOnDisk="1000" eternal="true" overflowToDisk="true"
		diskSpoolBufferSizeMB="20" memoryStoreEvictionPolicy="LRU"
		diskPersistent="true" />
	<cache name="CACHE_CLASSIFICAZIONE_ATECO_KEY"
		maxElementsInMemory="10" maxElementsOnDisk="1000" eternal="true"
		overflowToDisk="true" diskSpoolBufferSizeMB="20"
		memoryStoreEvictionPolicy="LRU" diskPersistent="true" />
	<cache name="CACHE_ALBEROPROC_KEY" maxElementsInMemory="200"
		maxElementsOnDisk="100" eternal="true" overflowToDisk="true"
		diskSpoolBufferSizeMB="20" memoryStoreEvictionPolicy="LRU"
		diskPersistent="true" />
	<cache name="CACHE_HIBERNATE_VALIDATORS" maxElementsInMemory="500"
		maxElementsOnDisk="500" eternal="true" overflowToDisk="true"
		diskSpoolBufferSizeMB="20" memoryStoreEvictionPolicy="LRU"
		diskPersistent="true" />
	<cache name="CACHE_MIME_TYPES_KEY" maxElementsInMemory="2"
		maxElementsOnDisk="2" eternal="true" overflowToDisk="true"
		diskSpoolBufferSizeMB="20" memoryStoreEvictionPolicy="LRU"
		diskPersistent="true" />						
</ehcache>