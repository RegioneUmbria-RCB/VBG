<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://gruppoinit.it/sigepro/schemas/messages/movimentimail" elementFormDefault="qualified" xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
	xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://gruppoinit.it/sigepro/schemas/messages/movimentimail">
	<element name="MovimentiMailRequest">
		<complexType>
			<sequence>
				<element name="token" type="string" />
				<element name="software" type="string" />
				<element name="codicemovimento" type="string" minOccurs="0" maxOccurs="1" />
				<element name="messageId" type="string" minOccurs="0" maxOccurs="1" />
				<element name="mittente" type="string" />
				<element name="destinatario" type="string" />
				<element name="destinatariocc" type="string" minOccurs="0" maxOccurs="1" />
				<element name="destinatariobcc" type="string" minOccurs="0" maxOccurs="1" />
				<element name="oggetto" type="string" />
				<element name="corpo" type="string" />
				<element name="allegati" type="tns:AllegatoType" minOccurs="0" maxOccurs="unbounded" />
			</sequence>
		</complexType>
	</element>
	<element name="MovimentiMailResponse">
		<complexType>
			<sequence>
				<element name="id" type="integer" minOccurs="0" maxOccurs="1" />
			</sequence>
		</complexType>
	</element>
	
	
	<!-- Gestione salvataggio email inviata per gestione multi account -->
	
	
	<element name="MovimentiMailRequest2">
		<complexType>
			<sequence>
				<element name="token" type="string" />
				<element name="software" type="string" />
				<element name="idaccount" type="integer" minOccurs="0" maxOccurs="1" />
				<element name="codicemovimento" type="string" minOccurs="0" maxOccurs="1" />
				<element name="messageId" type="string" minOccurs="0" maxOccurs="1" />
				<element name="mittente" type="string" />
				<element name="destinatario" type="string" />
				<element name="destinatariocc" type="string" minOccurs="0" maxOccurs="1" />
				<element name="destinatariobcc" type="string" minOccurs="0" maxOccurs="1" />
				<element name="oggetto" type="string" />
				<element name="corpo" type="string" />
				<element name="allegati" type="tns:AllegatoType" minOccurs="0" maxOccurs="unbounded" />
			</sequence>
		</complexType>
	</element>
	<element name="MovimentiMailResponse2">
		<complexType>
			<sequence>
				<element name="id" type="integer" minOccurs="0" maxOccurs="1" />
			</sequence>
		</complexType>
	</element>
	
	
	<complexType name="AllegatoType">
		<sequence>
			<element name="id" type="integer" minOccurs="0" maxOccurs="1" />
			<element name="descrizione" type="string" minOccurs="0" maxOccurs="1" />
			<element name="fileName" type="string" />
			<element name="mimeType" type="string" minOccurs="0" maxOccurs="1" />
			<element name="binaryData" type="base64Binary" minOccurs="0" maxOccurs="1" xmime:expectedContentTypes="application/octet-stream" />
		</sequence>
	</complexType>
</schema>