<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:tns="http://gruppoinit.it/stradario" 
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
	name="StradarioWS"
	targetNamespace="http://gruppoinit.it/stradario" xmlns:xsd1="http://gruppoinit.it/anagrafici/stradario/types">
	<wsdl:types>
		<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
			<xsd:import namespace="http://gruppoinit.it/anagrafici/stradario/types"
				schemaLocation="stradario.xsd">
			</xsd:import>
		</xsd:schema>
	</wsdl:types>
	<wsdl:message name="CercaStradarioRequest">
		<wsdl:part name="parameters" element="xsd1:CercaStradarioRequest" />
	</wsdl:message>
	<wsdl:message name="CercaStradarioConCodiceViarioRequest">
		<wsdl:part name="parameters" element="xsd1:CercaStradarioConCodiceViarioRequest" />
	</wsdl:message>
	<wsdl:message name="CercaStradarioResponse">
		<wsdl:part element="xsd1:CercaStradarioResponse" name="parameters" />
	</wsdl:message>
	<wsdl:message name="CercaStradarioConCodiceViarioResponse">
		<wsdl:part element="xsd1:CercaStradarioConCodiceViarioResponse" name="parameters" />
	</wsdl:message>
	<wsdl:portType name="Stradario">
		<wsdl:operation name="CercaStradario">
			<wsdl:input message="tns:CercaStradarioRequest" />
			<wsdl:output message="tns:CercaStradarioResponse" />
		</wsdl:operation>
		<wsdl:operation name="CercaStradarioByCodiceViario">
			<wsdl:input message="tns:CercaStradarioConCodiceViarioRequest" />
