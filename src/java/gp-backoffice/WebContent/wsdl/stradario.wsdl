		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="StradarioWSSOAP" type="tns:Stradario">
		<soap:binding style="document"
			transport="http://schemas.xmlsoap.org/soap/http" />
		<wsdl:operation name="CercaStradario">
			<soap:operation soapAction="http://gruppoinit.it/stradario/CercaStradario" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="CercaStradarioByCodiceViario">
			<soap:operation soapAction="http://gruppoinit.it/stradario/CercaStradarioByCodiceViario" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>				
	</wsdl:binding>
	<wsdl:service name="StradarioService">
		<wsdl:port binding="tns:StradarioWSSOAP" name="StradarioWSSOAP">
			<soap:address location="http://localhost:8080/stradario/services/" />
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
