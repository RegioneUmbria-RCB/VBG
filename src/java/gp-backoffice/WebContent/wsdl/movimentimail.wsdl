	<wsdl:message name="MovimentiMailResponse">
		<wsdl:part element="sch:MovimentiMailResponse" name="MovimentiMailResponse" />
	</wsdl:message>
	
	<!-- request e response gestione multi account -->
	
	<wsdl:message name="MovimentiMailRequest2">
		<wsdl:part element="sch:MovimentiMailRequest2" name="MovimentiMailRequest2" />
	</wsdl:message>
	<wsdl:message name="MovimentiMailResponse2">
