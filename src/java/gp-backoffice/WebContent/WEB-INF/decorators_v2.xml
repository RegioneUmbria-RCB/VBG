<?xml version="1.0" encoding="UTF-8"?>
<decorators defaultdir="/WEB-INF/jsp/decorators_v2">
	<excludes>
        <pattern>/ajax/*</pattern>
        <pattern>/*/ajax*</pattern>
        <pattern>/axisservices/*</pattern>
        <pattern>/axisservices</pattern>
        <pattern>/services</pattern>
        <pattern>/services/*</pattern>
        <pattern>/servlet/*</pattern>
        <pattern>/json*</pattern>
        <pattern>/*/json*</pattern>        
        <pattern>/css/*</pattern>
        <pattern>/scripts/*</pattern>
        <pattern>/images/*</pattern>
        <pattern>/menu/*</pattern>
        <pattern>/externalresource/goToPopup.htm*</pattern>
        <pattern>/log4j/*</pattern>
        <pattern>/istanze/localizzaIstanzaStradario.htm*</pattern>
        <!-- escluso per permettere download di file txt -->
        <pattern>/file/download*</pattern>
        <pattern>/file/editDocApplet*</pattern>
        <pattern>/rssfeed/*</pattern>
        <pattern>/firmaDigitale/*</pattern>
        <pattern>/firmaDigitale2/*</pattern>
        <!-- decorators disattivati per UPGR4J 
        <pattern>/upgrade/*</pattern>
        -->
    </excludes>
    <!-- DECORATOR PER LA PAGINA DI LOGIN -->
    <decorator name="login" page="decorator_login.jsp">
    	<pattern>/welcome/login.htm</pattern>
    </decorator>
    <!-- DECORATOR PER LE PAGINE IN POPUP -->
    <decorator name="popup" page="decorator_popup.jsp">
    	<pattern>/*/popup*</pattern>
    </decorator>
    <!-- DECORATOR PRINCIPALE -->
    <decorator name="main" page="decorator_main.jsp">
        <pattern>/*</pattern>
    </decorator>
    <!-- DECORATOR PER I TEST DI CARICO -->
    <decorator name="test" page="decorator_empty.jsp">
        <pattern>/test/*</pattern>
    </decorator>
    <!-- DECORATOR PER LA STAMPA -->
    <decorator name="printable" page="decorator_printable.jsp"/>
  	<!-- DECORATOR PER INCLUDERE BACKOFFICE .NET  -->
    <decorator name="backofficeNET" page="decorator_backofficeNET.jsp">
    	<pattern>/externalresource/goTo.htm*</pattern>
    </decorator>
    <!-- DECORATOR PER UPGR4J -->
    <decorator name="upgr" page="decorator_upgr.jsp">
    	<pattern>/upgrade/*</pattern>
    </decorator>
    <!-- DECORATOR PER IMPORT -->
    <decorator name="import" page="decorator_import.jsp">
    	<pattern>/import/*</pattern>
    </decorator>
    <!-- DECORATOR PER VISUALIZZAZIONE MODULI CART IN BO -->
    <decorator name="cart" page="decorator_cart.jsp">
    	<pattern>/cart/caricaModulistica.htm*</pattern>
    </decorator>
	
</decorators>