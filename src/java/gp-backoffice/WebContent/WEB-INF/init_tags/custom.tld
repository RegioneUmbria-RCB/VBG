<?xml version="1.0" encoding="UTF-8"?>
<taglib version="2.0" xmlns="http://java.sun.com/xml/ns/j2ee"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd">
 <description>INIT Custom Tags</description>
 <display-name>INIT Custom Tags</display-name>
 <tlib-version>1.1</tlib-version>
 <short-name>inite</short-name>
 <uri>http://www.gruppoinit.it/tag/ext</uri>
 <function>
  <description>Costruisce l'url per le chiamate a funzionalità di backoffice .NET</description>
  <name>geturlto</name>
  <function-class>it.gruppoinit.pal.gp.core.constants.BackofficeNETConstants</function-class>
  <function-signature>java.lang.String getUrlTo(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean)</function-signature>
  <example>${inite:geturlto(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false)}</example>
 </function>
 <function>
  <description>Costruisce l'url per le chiamate a funzionalità di backoffice .NET passando in post i parametri della request</description>
  <name>geturltopost</name>
  <function-class>it.gruppoinit.pal.gp.core.constants.BackofficeNETConstants</function-class>
  <function-signature>java.lang.String getUrlToPost(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean)</function-signature>
  <example>${inite:geturltopost(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false)}</example>
 </function>
 <function>
  <description>Costruisce l'url per le chiamate a funzionalità delle schede dinamiche</description>
  <name>linkschede</name>
  <function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
  <function-signature>java.lang.String getLinkSchede(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, boolean, java.lang.Integer)</function-signature>
  <example>${inite:linkschede(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false, 1044)}</example>
 </function>
 <function>
  <description>Costruisce l'url per le chiamate a funzionalità delle schede dinamiche dei movimenti</description>
  <name>linkschedemovimento</name>
  <function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
  <function-signature>java.lang.String getLinkSchede(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, boolean, java.lang.Integer, java.lang.Integer)</function-signature>
  <example>${inite:linkschedemovimento(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false, 1044,50000)}</example>
 </function>
 
  <function>
	  <description>Costruisce l'url per le chiamate a funzionalità delle schede dinamiche DEI MERCATI</description>
	  <name>linkschedemercati</name> 
	  <function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
	  <function-signature>java.lang.String getLinkSchedeMercati(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, boolean,java.lang.Integer)</function-signature>
	  <example>${inite:linkschedemercati(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false, 1044,50000)}</example>
  </function>
 
 
 <function>
	  <description>Costruisce l'url per le chiamate a funzionalità delle schede dinamiche DEI POSTEGGI DI UN MERCATO</description>
	  <name>linkschedeposteggi</name> 
	  <function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
