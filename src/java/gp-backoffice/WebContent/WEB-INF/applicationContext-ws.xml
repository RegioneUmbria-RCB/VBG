	<jaxrs:server id="restService" address="/rest">
			<jaxrs:properties>
			   <entry key="org.apache.cxf.endpoint.private" value="true"/>
			</jaxrs:properties>
			<jaxrs:serviceBeans>
				<ref bean="anagrafeRestService" />
				<ref bean="decodificheRestService" />
				<ref bean="layoutRestService" />
				<ref bean="statusRestService" />
			</jaxrs:serviceBeans>
			<jaxrs:providers>
				<bean class="org.apache.cxf.jaxrs.provider.JSONProvider">
					<property name="dropRootElement" value="true" />
					<property name="supportUnwrapped" value="true" />
					<property name="ignoreNamespaces" value="true" />
					<property name="dropCollectionWrapperElement" value="true" />
				</bean>
			</jaxrs:providers>
	</jaxrs:server>
	
	<bean id="anagrafeRestService" class="it.gruppoinit.pal.gp.backoffice.web.rest.AnagrafeRestService" />
	<bean id="decodificheRestService" class="it.gruppoinit.pal.gp.backoffice.web.rest.DecodificheRestService" />
	<bean id="layoutRestService" class="it.gruppoinit.pal.gp.backoffice.web.rest.LayoutRestService" />
	<bean id="statusRestService" class="it.gruppoinit.pal.gp.backoffice.web.rest.StatusRestService" />
	
	
	<jaxrs:server id="restAuthHeaderService" address="/rest-private">
			<jaxrs:properties>
			   <entry key="org.apache.cxf.endpoint.private" value="true"/>
			</jaxrs:properties>
			<jaxrs:serviceBeans>
				<ref bean="comunicazioniRestService" />
				<ref bean="mercatiRestService" />
				<ref bean="istanzeRestService" />
				<ref bean="verticalizzazioniRestService" />
			</jaxrs:serviceBeans>
			<jaxrs:inInterceptors>
			     <ref bean="interceptorInHeaderAuth"/>
			</jaxrs:inInterceptors>
			<jaxrs:outInterceptors>
			     <ref bean="InterceptorOut"/>
			</jaxrs:outInterceptors>
			<jaxrs:providers>
				<bean class="org.apache.cxf.jaxrs.provider.JSONProvider">
					<property name="dropRootElement" value="true" />
					<property name="supportUnwrapped" value="true" />
					<property name="ignoreNamespaces" value="true" />
					<property name="dropCollectionWrapperElement" value="true" />
				</bean>
			</jaxrs:providers>
	</jaxrs:server>
	
	<bean id="comunicazioniRestService" class="it.gruppoinit.pal.gp.core.features.comunicazioni.massive.rest.ComunicazioniRestService" />
	
