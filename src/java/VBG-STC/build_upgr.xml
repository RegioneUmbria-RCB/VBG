<?xml version="1.0" encoding="UTF-8"?>
<project name="upgr" default="upgr_jar">
	<property name="lib-path" value="WebContent/WEB-INF/lib"></property>
	<property name="upgr_root" value="../Sigepro-UPGR"></property>
	<property name="upgr_classes" value="${upgr_root}/build/classes"></property>
	<!-- ================================= 
          target: upgr_jar crea il jar di upgr4j direttamente in WEB-INF/lib di STC             
         ================================= -->
    <target name="upgr_jar" description="crea il init-upgr4j.jar in WEB-INF/lib">
        <jar destfile="${lib-path}/init-upgr4j.jar" duplicate="add">
            <fileset dir="${upgr_classes}">
            		<exclude name="**/*Job*"/>
            </fileset>
        	<manifest>
        		<attribute name="Manifest-Version" value="1.0"/>
        	</manifest>
        </jar>
    </target>
	
	<!-- - - - - - - - - - - - - - - - - - 
          target: copy_upgr copia in Sigepro tutti i files 
          necessari per un war enterprise (che comprende UPGR)         
         - - - - - - - - - - - - - - - - - -->
    <target name="sync_upgr" depends="upgr_jar" description="copia in STC tutti i files necessari per UPGR">
    	<!-- 
            <copy  tofile="WebContent/WEB-INF/setup/setup.xsd" file="${upgr_root}/WebContent/WEB-INF/setup/setup.xsd" forceoverwrite="true"/>
         -->
    	<copy todir="WebContent/WEB-INF/jsp">
    		<fileset dir="${upgr_root}/WebContent/WEB-INF/jsp" id="upgr-jsp">
			    <include name="**/*.jsp"/>
			</fileset>
    	</copy>
    	
    	<sync todir="WebContent/images/upgr">
    		<fileset dir="${upgr_root}/WebContent/images/upgr" id="upgr-images">
    			<include name="**/*.png"/>
    			<include name="**/*.gif"/>
    			<include name="**/*.jpg"/>
    			<include name="**/*.jpeg"/>
			</fileset>
    	</sync>
    	<sync todir="WebContent/scripts-upgr">
    		<fileset dir="${upgr_root}/WebContent/scripts-upgr" id="upgr-js">
			    <include name="**/*.js"/>
    			<include name="**/*.css"/>
    			<include name="**/*.png"/>
    			<include name="**/*.gif"/>
    			<include name="**/*.html"/>
			</fileset>
    	</sync>
    	
    </target>

	<!-- - - - - - - - - - - - - - - - - - 
          target: clean_upgr elimina in Sigepro tutti i files di UPGR
          per predisporre la creazione di un war NON enterprise (che NON comprende UPGR)         
         - - - - - - - - - - - - - - - - - -->
    <target name="clean_upgr">
        <delete  file="WebContent/WEB-INF/setup/setup.xsd"/>
    	<delete file="${lib-path}/init-upgr4j.jar"/>
    	<delete dir="WebContent/scripts-upgr"/>
    	<delete dir="WebContent/css-upgr"/>
    	<delete dir="WebContent/WEB-INF/jsp/upgr"/>
    </target>
	
	<!-- - - - - - - - - - - - - - - - - - 
          target: name  crea il war di STC impacchettando 
          tutto quello che si trova nelle directory di sigepro2                    
         - - - - - - - - - - - - - - - - - -->
	<target name="war_stc" description="crea il .war di STC con i files presenti nel progetto STC">
		<war destfile="stc.war" basedir="WebContent" webxml="WebContent/WEB-INF/web.xml">
			<classes dir="build/classes"></classes>
		</war>
	</target>
	
	<!-- - - - - - - - - - - - - - - - - - 
          target: name  crea il war di STC Enterprise 
          integrando al suo interno anche UPGR4J                   
         - - - - - - - - - - - - - - - - - -->
	<target name="war_stc_upgr" depends="upgr_jar, sync_upgr" description="crea il .war di STC integrando al suo interno anche UPGR4J">
		<antcall target="war_stc"></antcall>
	</target>

	<!-- - - - - - - - - - - - - - - - - - 
          target: name  crea il war di STC non Enterprise 
          escludendo dal deploy i files di UPGR4J                   
         - - - - - - - - - - - - - - - - - -->
	<target name="war_stc_no_upgr" depends="clean_upgr" description="crea il .war di STC senza UPGR4J">
		<antcall target="war_stc"></antcall>
	</target>
</project>