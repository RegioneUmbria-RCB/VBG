<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report_statistiche_istanze_procedimento" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[]]>
	</queryString>
	<field name="scDescrizione" class="java.lang.String">
		<fieldDescription><![CDATA[alberoproc.vwAlberoproc.scDescrizione]]></fieldDescription>
	</field>
	<variable name="numero_istanze_procedimento" class="java.lang.Integer" resetType="Group" resetGroup="instanze_per_procedimento" calculation="Count">
		<variableExpression><![CDATA[$F{scDescrizione}]]></variableExpression>
	</variable>
	<group name="instanze_per_procedimento">
		<groupExpression><![CDATA[(($F{scDescrizione}!=null && $F{scDescrizione}.length()>0)?$F{scDescrizione}: "")]]></groupExpression>
		<groupHeader>
			<band/>
		</groupHeader>
		<groupFooter>
			<band height="24">
				<textField>
					<reportElement x="0" y="0" width="325" height="20"/>
					<textElement/>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{scDescrizione}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="325" y="0" width="230" height="20"/>
					<textElement/>
					<textFieldExpression class="java.lang.Integer"><![CDATA[$V{numero_istanze_procedimento}]]></textFieldExpression>
				</textField>
				<line>
					<reportElement x="0" y="20" width="555" height="1"/>
				</line>
			</band>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="43" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="555" height="32"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Istanze per procedimento]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="23" splitType="Stretch">
			<staticText>
				<reportElement x="325" y="0" width="230" height="20"/>
				<textElement>
					<font fontName="SansSerif" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Numero istanze]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="0" width="325" height="20"/>
				<textElement>
					<font fontName="SansSerif" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Procedimento]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band splitType="Stretch"/>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band height="339" splitType="Stretch">
			<pie3DChart>
				<chart>
					<reportElement x="0" y="0" width="555" height="287"/>
					<chartTitle/>
					<chartSubtitle/>
					<chartLegend/>
				</chart>
				<pieDataset>
					<keyExpression><![CDATA[$F{scDescrizione}]]></keyExpression>
					<valueExpression><![CDATA[$V{numero_istanze_procedimento}]]></valueExpression>
				</pieDataset>
				<pie3DPlot labelFormat="{1} ({2})">
					<plot/>
					<itemLabel color="#000000" backgroundColor="#FFFFFF"/>
				</pie3DPlot>
			</pie3DChart>
		</band>
	</summary>
</jasperReport>
