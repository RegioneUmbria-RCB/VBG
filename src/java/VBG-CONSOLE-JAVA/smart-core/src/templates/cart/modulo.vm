<div id="modulo_$helper.getIdModulo()" class="modulo-cart" title="${helper.escapeValueForHtmlAttribute($helper.modulo.help)}">
	#set($rowIndex = $helper.nuovoIndiceIdSemantico())
	#set($templateNestingLevel = -1)
	#if(!$pdfOutput)
		<ul>
		
		#foreach($quadro in $helper.Modulo.Quadro)
			#set($tooltiptext = ${helper.getQuadroHelp($quadro)})
			<li id="tab_quadro_${helper.getIdQuadro($quadro)}">
				<a class="quadro-cart-tab-title" href="#quadro_${helper.getIdQuadro($quadro)}" title="${helper.escapeValueForHtmlAttribute($tooltiptext)}">
					$quadro.Codice
					##span per contenere eventuali icone che indicano la presenza di errori di validazione dell'input di questo tab
					<span class="tab_error_image" id="quadro-${helper.getIdQuadro($quadro)}-errors" style="display:none;" title="">
						<label >(0)</label>
	                </span>
					##span per contenere eventuali icone che indicano la presenza di warnings di validazione dell'input di questo tab
					<span class="tab_warning_image" id="quadro-${helper.getIdQuadro($quadro)}-warnings" style="display:none;" title="">
						<label >(0)</label>
	                </span>
                </a>
			</li>
		#end
		
        </ul>
	#end
	
		
	
	
	
	#foreach($quadro in $helper.Modulo.Quadro)
	
		#parse("/cart/quadro.vm")
		#if($primoQuadro && $primoModulo && !$pdfOutput)
			#set($primoQuadro = false)
			<script >
			// $(document).ready(function(){
			$(function(){ 
				$('#quadro_attivo').val('${helper.getIdQuadro($quadro)}');
			});
            </script>
		#end
	#end
	
	
	#if(!$pdfOutput)
    	<script>
    	var tabs_modulo_$helper.getIdModuloForJsVariableName();
    	$(document).ready(function(){
    		tabs_modulo_$helper.getIdModuloForJsVariableName() = $( "#modulo_$helper.getIdModulo()" ).tabs();
			tabs_modulo_${helper.getIdModuloForJsVariableName()}.on("tabsbeforeactivate",null,selectQuadroTabHandler);
			$('#tab_${helper.getIdModulo()}').data('tabs_quadri', tabs_modulo_${helper.getIdModuloForJsVariableName()});
			$('#tab_${helper.getIdModulo()}').data('titolo_modulo', "${helper.modulo.titolo}");
			$('#tab_${helper.getIdModulo()}').data('riferimento_modulo', "${helper.getRiferimentoModulo($helper.modulo)}");
			riferimentiModuli[riferimentiModuli.length] = "${helper.getRiferimentoModulo($helper.modulo)}";
			idModuli[idModuli.length] = "${helper.getIdModulo()}";
			nomiModuli[nomiModuli.length] = "${helper.modulo.titolo}";
    	});
		
		var info_quadri_modulo_$helper.getIdModuloForJsVariableName() = [];
		#foreach($quadro in $helper.Modulo.Quadro)
			info_quadri_modulo_${helper.getIdModuloForJsVariableName()}[$velocityCount -1] = 
			{ 
				idQuadro: "${helper.getIdQuadro($quadro)}",
				attivo: ${helper.evaluateExpression($quadro.Attivo,$rowIndex)}
			};
    		##scrittura dello script che attiva e disattiva i folder dei quadri in base ai valori assunti da altri campi
    		#set($elementId = "tab_quadro_${helper.getIdQuadro($quadro)}")
			#set($jsScript = $helper.buildJavascriptToDynamicallyEnableElement($elementId,$quadro.Attivo,2))
			#if($jsScript != "")
    			$(document).ready(function(){
        			$jsScript
    			});
			#end
    	#end
    	
    	
    	
    	</script>
	#end
</div>
