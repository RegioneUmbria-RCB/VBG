			#set($isDinamico = $helper.isQuadroDinamico($quadron))
			#if($isDinamico)
				#set($jsScript = $helper.buildJavascriptToDynamicallyEnableElementStar($elementId))
			#else
				#set($jsScript = $helper.buildJavascriptToDynamicallyEnableElement($elementId,$quadro.Attivo,2))
			#end
			#if($jsScript != "")
				jQuery(function(){
        			$jsScript
    			});
			#end
    	#end
    	
		#foreach($quadro in $helper.QuadriAggiuntivi)
    	
    		info_quadri_modulo_${helper.getIdModuloForJsVariableName()}[$elCount + $velocityCount -1] = 
			{ 
				idQuadro: "${helper.getIdQuadroDinamico($quadro)}",
				attivo: true // TODO ${helper.evaluateExpression($quadro.Attivo,$rowIndex)}
			};
    		##scrittura dello script che attiva e disattiva i folder dei quadri in base ai valori assunti da altri campi
    		#set($elementId = "tab_quadro_${helper.getIdQuadroDinamico($quadro)}")
			#set($jsScript = $helper.buildJavascriptToDynamicallyEnableElementStar($elementId))
			#if($jsScript != "")
				jQuery(function(){
        			$jsScript
    			});
			#end
    	#end
		
    	</script>
    	
	#end
</div>
