			jQuery('#tab_${helper.getIdModulo()}').data('tabs_quadri', tabs_modulo_${helper.getIdModuloForJsVariableName()});
			jQuery('#tab_${helper.getIdModulo()}').data('titolo_modulo', "${helper.modulo.titolo}");
			jQuery('#tab_${helper.getIdModulo()}').data('riferimento_modulo', "${helper.getRiferimentoModulo($helper.modulo)}");
