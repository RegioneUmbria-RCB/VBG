			idModuli[idModuli.length] = "${helper.getIdModulo()}";
			nomiModuli[nomiModuli.length] = "${helper.modulo.titolo}";
    	});
		
		var info_quadri_modulo_$helper.getIdModuloForJsVariableName() = [];
		
		#set($elCount = 0);		
		#foreach($quadro in $helper.Modulo.Quadro)
			#set($qActive = true)
			#if($quadro.Attivo)
				#set($qActive = ${helper.evaluateExpression($quadro.Attivo,$rowIndex)})
			#end
    		#set($elCount = $elCount + 1);
			info_quadri_modulo_${helper.getIdModuloForJsVariableName()}[$velocityCount -1] = 
			{ 
				idQuadro: "${helper.getIdQuadro($quadro)}",
				attivo: $qActive
			};
			
    		##scrittura dello script che attiva e disattiva i folder dei quadri in base ai valori assunti da altri campi
