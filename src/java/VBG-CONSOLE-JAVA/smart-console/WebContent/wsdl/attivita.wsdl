<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:tns="http://gruppoinit.it/sigepro/definitions/attivita"
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://gruppoinit.it/sigepro/definitions/attivita"
	xmlns:sch="http://gruppoinit.it/sigepro/schemas/messages/attivita">
	<wsdl:types>
		<schema xmlns="http://www.w3.org/2001/XMLSchema"
			xmlns:sch="http://gruppoinit.it/sigepro/schemas/messages/attivita"
			xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://gruppoinit.it/sigepro/definitions/attivita"
			xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
			<import namespace="http://gruppoinit.it/sigepro/schemas/messages/attivita"
				schemaLocation="attivita.xsd" />
		</schema>		
	</wsdl:types>
	<wsdl:message name="SnapShotRequest">
		<wsdl:part element="sch:SnapShotRequest" name="parameters" />
	</wsdl:message>
	<wsdl:message name="SnapShotResponse">
		<wsdl:part element="sch:SnapShotResponse" name="parameters" />
	</wsdl:message>
	<wsdl:message name="AggiornaCampiSchedeRequest">
		<wsdl:part name="parameters" element="sch:AggiornaCampiSchedeRequest">
		</wsdl:part>
	</wsdl:message>
	<wsdl:message name="AggiornaCampiSchedeResponse">
		<wsdl:part name="parameters" element="sch:AggiornaCampiSchedeResponse"></wsdl:part>
	</wsdl:message>
	<wsdl:portType name="Attivita">
		<wsdl:operation name="SnapShot">
			<wsdl:input message="tns:SnapShotRequest" />
			<wsdl:output message="tns:SnapShotResponse" />
		</wsdl:operation>
		<wsdl:operation name="AggiornaCampiSchede">
			<wsdl:input message="tns:AggiornaCampiSchedeRequest"></wsdl:input>
			<wsdl:output message="tns:AggiornaCampiSchedeResponse"></wsdl:output>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="attivitaSOAP" type="tns:Attivita">
		<soap:binding style="document"
			transport="http://schemas.xmlsoap.org/soap/http" />
		<wsdl:operation name="SnapShot">
			<soap:operation soapAction="http://gruppoinit.it/sigepro/schemas/messages/attivita/SnapShot" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="AggiornaCampiSchede">
			<soap:operation soapAction="http://gruppoinit.it/sigepro/schemas/messages/attivita/AggiornaCampiSchede" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="Attivita">
		<wsdl:port binding="tns:attivitaSOAP" name="attivitaSOAP">
			<soap:address location="http://devel9:8080/vbg/services/" />
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
