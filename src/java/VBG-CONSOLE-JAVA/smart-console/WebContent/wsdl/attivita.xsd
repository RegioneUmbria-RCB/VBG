<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://gruppoinit.it/sigepro/schemas/messages/attivita"
	xmlns:xmime="http://www.w3.org/2005/05/xmlmime" elementFormDefault="qualified"
	targetNamespace="http://gruppoinit.it/sigepro/schemas/messages/attivita"
	xmlns:base="http://gruppoinit.it/sigepro/schemas/messages/base">
	<import id="oggettiBase" schemaLocation="backoffice_oggetti_base.xsd"
		namespace="http://gruppoinit.it/sigepro/schemas/messages/base" />
	<element name="SnapShotResponse">
		<complexType>
			<sequence>
				<element name="esito" type="base:EsitoOperazioneType" />
			</sequence>
		</complexType>
	</element>
	<element name="SnapShotRequest" type="tns:SnapShotRequestType"></element>
	<complexType name="SnapShotRequestType">
		<sequence>
			<element name="token" type="string"></element>
			<element name="software" type="string"></element>
			<element name="codiceAttivita" type="int"></element>
		</sequence>
	</complexType>
	<element name="AggiornaCampiSchedeResponse">
		<complexType>
			<sequence>
				<element name="esito" type="base:EsitoOperazioneType" />
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaCampiSchedeRequest" type="tns:AggiornaCampiSchedeRequestType">
	</element>
	<complexType name="AggiornaCampiSchedeRequestType">
		<sequence>
			<element name="token" type="string"></element>
			<element name="software" type="string"></element>
			<element name="codiceAttivita" type="int"></element>
			<element name="codiceIstanza" type="int" nillable="true"></element>
			<element name="codiceScheda" type="int" nillable="true"></element>
		</sequence>
	</complexType>
</schema>