<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
	version="2.0">
	<description>INIT Custom Tags</description>
	<display-name>INIT Custom Tags</display-name>
	<tlib-version>1.1</tlib-version>
	<short-name>inite</short-name>
	<uri>http://www.gruppoinit.it/tag/ext</uri>
	<function>
		<description>Costruisce l'url per le chiamate a funzionalità di backoffice .NET</description>
		<name>geturlto</name>
		<function-class>it.gruppoinit.pal.gp.core.constants.BackofficeNETConstants</function-class>
		<function-signature>java.lang.String getUrlTo(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean)</function-signature>
		<example>${inite:geturlto(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false)}</example>
	</function>
	<function>
		<description>Costruisce l'url per le chiamate a funzionalità di backoffice .NET passando in post i parametri della request</description>
		<name>geturltopost</name>
		<function-class>it.gruppoinit.pal.gp.core.constants.BackofficeNETConstants</function-class>
		<function-signature>java.lang.String getUrlToPost(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean)</function-signature>
		<example>${inite:geturltopost(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false)}</example>
	</function>
	<function>
		<description>Costruisce l'url per le chiamate a funzionalità delle schede dinamiche</description>
		<name>linkschede</name>
		<function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
		<function-signature>java.lang.String getLinkSchede(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean, java.lang.Integer)</function-signature>
		<example>${inite:linkschede(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false, 1044)}</example>
	</function>
	<function>
		<description>Costruisce l'url per le chiamate a funzionalità delle stampe di un istanza</description>
		<name>linkStampeIstanza</name>
		<function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
		<function-signature>java.lang.String getLinkStampeIstanza(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean, java.lang.Integer)</function-signature>
		<example>${inite:linkStampeIstanza(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false, 1044)}</example>
	</function>
	<function>
		<description>Costruisce l'url per le chiamate a funzionalità istanzeoneri</description>
		<name>linkIstanzeoneri</name>
		<function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
		<function-signature>java.lang.String getLinkIstanzeoneri(javax.servlet.http.HttpServletRequest, java.lang.String, java.lang.String, java.lang.String, boolean, java.lang.Integer)</function-signature>
		<example>${inite:linkIstanzeoneri(pageContext.request, "http://localhost:8080/backoffice/...", "http://localhost:8080/backend/...", "CO", false, 1044)}</example>
	</function>
	<function>
		<description>Verifica se l'installazione è di TipoEnterprise</description>
		<name>isEnterprise</name>
		<function-class>it.gruppoinit.pal.gp.backoffice.web.util.ApplicationLinkUtil</function-class>
		<function-signature>boolean isEnterprise()</function-signature>
		<example>${inite:isEnterprise()}</example>
	</function>
	<function>
		<description>Controlla se nell'oggetto collection esiste un oggetto da controllare</description>
		<name>contains</name>
		<function-class>it.gruppoinit.pal.gp.core.utils.Utilities</function-class>
		<function-signature>boolean contains(java.util.Set, java.lang.Object)</function-signature>
		<example>${inite:contains(collezione, object)}</example>
	</function>
	<function>
		<description>Controlla se nell'oggetto collection esiste un oggetto da controllare</description>
		<name>endsWith</name>
		<function-class>it.gruppoinit.pal.gp.core.utils.Utilities</function-class>
		<function-signature>boolean endsWith(java.lang.String, java.lang.String)</function-signature>
		<example>${inite:endsWith(word, suffix)}</example>
	</function>
	<function>
		<description>Ritorna dei messaggi di warnings settati da FlashMessages</description>
		<name>getWarnings</name>
		<function-class>it.gruppoinit.pal.gp.core.utils.Utilities</function-class>
		<function-signature>List getWarnings()</function-signature>
		<example>${inite:getWarnings()}</example>
	</function>
	<function>
		<description>Ritorna dei messaggi di infos settati da FlashMessages</description>
		<name>getInfos</name>
		<function-class>it.gruppoinit.pal.gp.core.utils.Utilities</function-class>
		<function-signature>List getInfos()</function-signature>
		<example>${inite:getInfos()}</example>
	</function>
</taglib>