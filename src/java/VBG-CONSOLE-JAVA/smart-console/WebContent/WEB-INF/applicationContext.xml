<?xml version="1.0" encoding="UTF-8"?>
<beans default-lazy-init="false"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:p="http://www.springframework.org/schema/p"
	xmlns:aop="http://www.springframework.org/schema/aop" xmlns:context="http://www.springframework.org/schema/context"
	xmlns:jee="http://www.springframework.org/schema/jee" xmlns:tx="http://www.springframework.org/schema/tx"
	xmlns:security="http://www.springframework.org/schema/security"
	xmlns:jms="http://www.springframework.org/schema/jms"
	xsi:schemaLocation="
			http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-2.5.xsd
			http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
			http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-2.5.xsd
			http://www.springframework.org/schema/jee http://www.springframework.org/schema/jee/spring-jee-2.5.xsd
			http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx-2.5.xsd
			http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-2.0.2.xsd
			http://www.springframework.org/schema/jms http://www.springframework.org/schema/jms/spring-jms.xsd">

	<context:annotation-config />
	  
	<bean id="cacheManager" destroy-method="shutdown" class="net.sf.ehcache.CacheManager">
		<property name="name" value="ehchache.xml"/>
	</bean>
	 
	<context:component-scan base-package="it.gruppoinit.pal.gp">
		<context:exclude-filter type="annotation"
			expression="org.springframework.stereotype.Controller" />
			<!-- 
		<context:exclude-filter type="annotation"
			expression="org.springframework.ws.server.endpoint.annotation.Endpoint" />
			 -->
	</context:component-scan>
	<context:component-scan base-package="it.gruppoinit.sigepro">
		<context:exclude-filter type="annotation"
			expression="org.springframework.stereotype.Controller" />
	</context:component-scan>
	<!-- services di UPGR4J -->
	<context:component-scan base-package="it.gruppoinit.upgr.service" />
	<context:component-scan base-package="it.gruppoinit.upgr.core.task" />
	<context:component-scan base-package="it.gruppoinit.pal.gp.backoffice.upgr.tasks" />
	<context:component-scan base-package="it.toscana.regione.suap.sem.service">
		<context:exclude-filter type="annotation"
			expression="org.springframework.stereotype.Controller" />
	</context:component-scan>
	

	<!-- file di configurazione (se modificato, modificare anche le costanti in WebConstants)-->
	<context:property-placeholder location="classpath:deploy.properties" />

	<!-- configurazione dei messaggi di gp-backoffice -->
	<bean id="messageSource" 
		class="org.springframework.context.support.ReloadableResourceBundleMessageSource"
		p:basenames="classpath:messages" p:cacheSeconds="3600">
		<!-- §§§BEGIN§§§ -->
		<property name="parentMessageSource" ref="upgrMessageSource"></property>
		<!-- §§§END§§§ -->
	</bean>
	<!-- configurazione dei messaggi di upgr4j -->
	<!-- §§§BEGIN§§§ -->
	<bean id="upgrMessageSource" 
		class="org.springframework.context.support.ReloadableResourceBundleMessageSource"
		p:basename="classpath:upgr-messages" >
	</bean>
	
			
	<!-- Aggiunta configurazione del DAO di UPGR4J che in VBG usa la classe 
	it.gruppoinit.pal.gp.core.domain.Versione per accedere alla tabella VERSIONE-->
	<bean id="versioneDao" class="it.gruppoinit.upgr.dao.impl.VersioneDAOImpl">
		<property name="versioneClassName" value="it.gruppoinit.pal.gp.core.domain.Versione"/>
		<property name="sessionFactory" ref="sessionFactory" />
	</bean>
	
	<bean id="upgrDao" class="it.gruppoinit.upgr.dao.impl.UpgradeProcedureDAOImpl">
		<property name="sessionFactory" ref="sessionFactory" />
	</bean>
	
	<!-- Configurazione VelocityEngine -->
	<bean id="velocityEngine" class="org.springframework.ui.velocity.VelocityEngineFactoryBean">
		<property name="resourceLoaderPath" value="classpath:templates/"/>
		<property name="velocityProperties">
	    	<value>
	      		directive.parse.max.depth=30
	    	</value>
	    </property>
	</bean>
	 <!-- Fine Configurazione VelocityEngine -->
	 
	<!-- §§§END§§§ -->
	<bean id="externalDBResolver"
		class="it.gruppoinit.pal.gp.core.utils.ExternalDBResolverWS">
		<property name="configurationProperties">
			<props>
				<prop key="ws.token.url">${ws.token.url}</prop>
				<prop key="ws.token.user">${ws.token.user}</prop>
				<prop key="ws.token.pwd">${ws.token.pwd}</prop>
				<prop key="ws.token.default.alias">${ws.token.default.alias}</prop>
			</props>
		</property>
	</bean>

	<bean id="dataSourceContainer" class="it.gruppoinit.pal.gp.core.dao.helper.DataSourceContainer">
		<property name="factoryWrappers">
			<map></map>
		</property>
		<property name="externalDBResolver" ref="externalDBResolver" />
		<property name="packageToScan" value="it.gruppoinit.pal.gp.core.domain" />
		<!--
			lasciare sempre settato l'handler per oracle. quello di default lo carica da solo
		-->
		<property name="lobHandler" ref="oracleLobHandler" />
	</bean>

	<bean id="sessionFactory" class="org.springframework.aop.framework.ProxyFactoryBean">
		<property name="proxyInterfaces">
			<list>
				<value>org.hibernate.SessionFactory</value>
			</list>
		</property>
		<property name="targetSource" ref="sessionFactoryTarget" />
	</bean>

	<bean id="defaultLobHandler" class="org.springframework.jdbc.support.lob.DefaultLobHandler" />

	<bean id="oracleLobHandler" class="org.springframework.jdbc.support.lob.OracleLobHandler">
		<property name="nativeJdbcExtractor" ref="nativeJdbcExtractor" />
	</bean>

	<bean id="nativeJdbcExtractor"
		class="org.springframework.jdbc.support.nativejdbc.C3P0NativeJdbcExtractor" />

	<bean id="sessionFactoryTarget"
		class="it.gruppoinit.pal.gp.core.dao.helper.SessionFactoryTargetSource">
		<property name="dataSourceContainer" ref="dataSourceContainer" />
	</bean>
	
	<bean name="openSessionInViewInterceptor"
		class="org.springframework.orm.hibernate3.support.OpenSessionInViewInterceptor">
		<property name="sessionFactory" ref="sessionFactory" />
		<property name="singleSession" value="true" />
	</bean>

	<bean id="transactionManager"
		class="org.springframework.orm.hibernate3.HibernateTransactionManager"
		p:sessionFactory-ref="sessionFactory" />
		
	<!-- ASPECTJ CONFIGURATION -->
	<aop:aspectj-autoproxy />
	
	<aop:config>
		<aop:pointcut id="webMethods"
			expression="execution(* (@org.springframework.stereotype.Controller *..*Controller).*(..))" />
		<aop:pointcut id="serviceMethods"
			expression="execution(* it.gruppoinit.pal.gp.core.service.*Service.*(..)) || execution(* it.gruppoinit.pal.gp.backoffice.upgr.tasks.*.run(..)) || execution(* it.gruppoinit.upgr.service.*Service.*(..)) || execution(* it.gruppoinit.upgr.core.task.*.run(..))" />
		<!-- pointcut per le operazioni di insert/update/delete sulla base dati sono comprese quelle di protocollazioni -->
		<aop:pointcut id="databaseModificationOperations"
			expression="(execution(* it.gruppoinit.pal.gp.core.service.*Service.insert*(..)) || execution(* it.gruppoinit.pal.gp.core.service.*Service.update*(..)) || execution(* it.gruppoinit.pal.gp.core.service.*Service.delete*(..)) || execution(* it.gruppoinit.pal.gp.core.service.*Service.protocolla*(..)) || execution(* it.gruppoinit.pal.gp.core.service.*Service.fascicola*(..))) and !(execution(* it.gruppoinit.pal.gp.core.service.ConfigurazioneutenteService.*(..))
			|| execution(* it.gruppoinit.pal.gp.core.service.ResponsabiliService.updatePassword(..)))" />
		<aop:advisor advice-ref="txAdvice" pointcut-ref="serviceMethods" />
		<aop:aspect id="auditSuFileAspect" ref="auditingSuFile">
			<aop:after-throwing method="trackServiceException" pointcut-ref="serviceMethods" throwing="exception"/>
			<aop:before method="trackWebLayer" pointcut-ref="webMethods" />
		</aop:aspect>
		<!-- COMMENTATO PER PROBLEMI DI CONFIGURAZIONE AUDIT
		<aop:aspect id="auditAspect" ref="audit" >
			<aop:after-throwing method="trackServiceException" pointcut-ref="serviceMethods" throwing="exception"/>
			<aop:before method="trackWebLayer" pointcut-ref="webMethods" />
		</aop:aspect>
		 -->
		<aop:aspect id="operatoreReadOnlySecurityAspectId" ref="operatoreReadOnlySecurityAspect" >
			<aop:before method="checkUserReadOnly" pointcut-ref="databaseModificationOperations" />			
		</aop:aspect>
				<!--
		     COMMENTATO, CODICE DELLA CHIAMATA è MESSO DEIRETTAMENTE NEL METODO
		     
			  Aspetto per la gestione degli ShapShot di una attività in seguito a una modifica di un record di Iattivita
		     (Es. Modifica denominazione,collegameto di una nuova istanza,scollegamento di un istanza,evento che modifica
		     la data di validità di un istanza che appartiene in un attività)  
		-->
		<!--       			  
		<aop:aspect id="iattivitaSnapShotAspectId" ref="iattivitaSnapShotAspect" >
			<aop:pointcut id="iattivitaSnapShotId" expression="execution(* it.gruppoinit.pal.gp.core.service.IAttivitaService.update(..)) &amp;&amp; args(entity)" />		
			<aop:after-returning method="doSnapShot" pointcut-ref="iattivitaSnapShotId"/>
			<aop:pointcut id="iattivitaSnapShotCollegaId" expression="(execution(* it.gruppoinit.pal.gp.core.service.IAttivitaService.updateCollegaIstanza(..)) &amp;&amp; args(istanza,attivita))" />		
			<aop:after-returning method="doSnapShotCollega" pointcut-ref="iattivitaSnapShotCollegaId"/>
			<aop:pointcut id="iattivitaSnapShotScollegaId" expression="(execution(* it.gruppoinit.pal.gp.core.service.IAttivitaService.updateScollega(..)) &amp;&amp; args(istanza,attivita))" />		
			<aop:after-returning method="doSnapShotScollega" pointcut-ref="iattivitaSnapShotScollegaId"/>
			<aop:pointcut id="istanzeCalcolaDataValiditaId" expression="execution(* it.gruppoinit.pal.gp.core.service.IAttivitaService.callSnapShotAspect(..)) &amp;&amp; args(codiceIstanza)" />	
			<aop:after-returning method="doSnapShotCalcolaDataValiditaIstanza" pointcut-ref="istanzeCalcolaDataValiditaId"/>
		</aop:aspect>
		-->
	</aop:config>
	
	<bean class="it.gruppoinit.pal.gp.backoffice.aop.SoftwareValidationAspect" />
	<bean class="it.gruppoinit.pal.gp.backoffice.aop.Validation" />
	<!-- 
	<bean id="istanzeSecurityAspect" class="it.gruppoinit.pal.gp.backoffice.aop.IstanzeSecurityAspect" />
	<bean id="movimentiSecurityAspect" class="it.gruppoinit.pal.gp.backoffice.aop.MovimentiSecurityAspect" />	
	<bean id="istanzeeventiAspect" class="it.gruppoinit.pal.gp.backoffice.aop.istanzeeventi.IstanzeeventiAspect" />	
	 -->
	<bean id="operatoreReadOnlySecurityAspect" class="it.gruppoinit.pal.gp.backoffice.aop.OperatoreReadOnlySecurityAspect" />
	<bean id="auditingSuFile" class="it.gruppoinit.pal.gp.backoffice.aop.AuditingSuFile" />
	<!-- 
	<bean id="iattivitaSnapShotAspect" class="it.gruppoinit.pal.gp.backoffice.aop.IattivitaSnapShotAspect" />
	 -->
	<tx:advice id="txAdvice" transaction-manager="transactionManager">
		<tx:attributes>
			<tx:method name="find*" propagation="REQUIRED" read-only="true" />
			<tx:method name="is*" propagation="REQUIRED" read-only="true" />
			<tx:method name="check*" propagation="REQUIRED" read-only="true" />
			<tx:method name="exist*" propagation="REQUIRED" read-only="true" />
			<tx:method name="count*" propagation="REQUIRED" read-only="true" />
			<tx:method name="setVersione" propagation="REQUIRES_NEW" />
			<tx:method name="runTaskInNewTransaction" propagation="REQUIRES_NEW" />			
			<tx:method name="bindDomainObject" propagation="REQUIRED" no-rollback-for="it.gruppoinit.pal.gp.core.service.exception.RecuperoDatiAnagraficaException"/>
			<tx:method name="*" propagation="REQUIRED" />
			<tx:method name="notificaStc" propagation="REQUIRED" no-rollback-for="it.gruppoinit.pal.gp.core.service.exception.STCNotificaAttivitaException" />
			<tx:method name="operazioniAutomatiche" propagation="REQUIRED" no-rollback-for="it.gruppoinit.pal.gp.core.service.exception.OperazioniAutomaticheException" />
			<tx:method name="insertEventiCheckCodiceFiscale" propagation="REQUIRED" no-rollback-for="it.gruppoinit.pal.gp.core.service.exception.OperazioniAutomaticheException" />
			<tx:method name="updateLoadModelloIstanza" propagation="REQUIRED" no-rollback-for="javax.script.ScriptException" />
			<tx:method name="updateSaveModelloIstanza" propagation="REQUIRED" no-rollback-for="javax.script.ScriptException" />
			<tx:method name="updateLoadCampoIstanza" propagation="REQUIRED" no-rollback-for="javax.script.ScriptException" />
			<tx:method name="updateSaveCampoIstanza" propagation="REQUIRED" no-rollback-for="javax.script.ScriptException" />			
			<tx:method name="updateChangeCampoIstanza" propagation="REQUIRED" no-rollback-for="javax.script.ScriptException" />
			<tx:method name="findByRuoloType" propagation="REQUIRED" no-rollback-for="it.gruppoinit.pal.gp.core.service.exception.BusinessValidationException" />
			<tx:method name="registraEventoDomandaRFC239" propagation="REQUIRES_NEW" />
		</tx:attributes>
	</tx:advice>

    <bean id="taskExecutor" class="org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor">
		<property name="corePoolSize" value="10" />
		<property name="maxPoolSize" value="40" />
		<property name="queueCapacity" value="2000" />
	</bean>
		
	<!-- CONFIGURAZIONE PER IL JOB SCHEDULER -->  	 
	<bean id="jobDetail"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="jobSchedulerManagerImpl" />
		<property name="targetMethod" value="schedulePersistentJobsForScheduler" />
	</bean>
	<bean id="simpleTrigger" class="org.springframework.scheduling.quartz.SimpleTriggerBean">
		<property name="jobDetail" ref="jobDetail" />
		<property name="startDelay" value="60000" />
		<property name="repeatInterval" value="120000" />
		<property name="repeatCount" value="0" />
	</bean> 
	<bean name="quartzSchedulerFactory"
		class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="autoStartup" value="${scheduler.autoStartup}" />
		<property name="waitForJobsToCompleteOnShutdown" value="true" />		
		<property name="triggers">
			<list>
				<ref bean="simpleTrigger" />
			</list>
		</property>		
	</bean>
    
	<!-- JMS AUDITING -->
	<!-- COMMENTATO PER PROBLEMI DI CONFIGURAZIONE AUDIT 
	<bean id="audit" class="it.gruppoinit.pal.gp.backoffice.aop.Audit" />
	<bean id="jmsMessageProducer" class="it.gruppoinit.jms.JmsMessageProducer"/>
	 -->

</beans>