			<xs:element name="COMUNE" minOccurs="0"/>
			<xs:element name="PROVINCIA" type="provincia" minOccurs="0"/>
			<xs:element name="VIA" minOccurs="0"/>
			<xs:element name="NUMERO_CIVICO" minOccurs="0"/>
			<xs:element name="CAP" type="cap" minOccurs="0"/>
			<xs:element name="PROGRESSIVO_UNITA_LOCALE" type="xs:string" minOccurs="0"/>
			<xs:element name="PROGRESSIVO_ESERCIZIO" type="xs:string" minOccurs="0"/>
			<xs:element name="DENOMINAZIONE" minOccurs="0"/>
			<xs:element name="TELEFONO" type="xs:string" minOccurs="0"/>
		</xs:all>
	</xs:complexType>
	<xs:element name="IMPRESA" type="impresa"/>
	<xs:complexType name="dichiarante">
