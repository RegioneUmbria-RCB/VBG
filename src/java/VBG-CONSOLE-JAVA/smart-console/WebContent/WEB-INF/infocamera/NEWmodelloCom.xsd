			<xs:element name="CODICE_FISCALE_DICHIARANTE" type="codFisc" minOccurs="0"/>
			<xs:element name="COGNOME_DICHIARANTE" type="xs:string" minOccurs="0"/>
			<xs:element name="NOME_DICHIARANTE" type="xs:string" minOccurs="0"/>
			<xs:element name="DATA_NASCITA_DICHIARANTE" type="dataIta" minOccurs="0"/>
			<xs:element name="CITTADINANZA_DICHIARANTE" type="xs:string" minOccurs="0"/>
			<xs:element name="SESSO_DICHIARANTE" type="sesso" minOccurs="0"/>
