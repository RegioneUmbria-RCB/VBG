<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<xs:element name="MODELLO_COMMERCIO" type="modComT"/>
	<xs:complexType name="modComT">
		<xs:all>
			<xs:element ref="TESTATA"/>
			<xs:element ref="DICHIARANTE" minOccurs="0"/>
			<xs:element ref="DATI_MODELLO_COM"/>
			<!--xs:element ref="COM-HEADER"/-->
		</xs:all>
	</xs:complexType>
	<xs:element name="TESTATA" type="testata"/>
	<xs:complexType name="testata">
		<xs:all>
			<xs:element ref="COMUNE"/>
			<xs:element ref="MODELLO"/>
			<xs:element ref="RIQUADRI_VARIAZIONI" minOccurs="0"/>
			<xs:element ref="PRATICA"/>
			<xs:element ref="IMPRESA"/>
		</xs:all>
	</xs:complexType>
	<xs:element name="COMUNE" type="comune"/>
	<xs:complexType name="comune">
		<xs:all>
			<xs:element name="PROVINCIA_COMUNE" type="provinciaItaObbl"/>
			<xs:element name="NOME_COMUNE" type="assenzaCampoObbligatorio"/>
			<xs:element name="CODICE_ISTAT_COMUNE" type="codIstatCT"/>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="modello">
		<xs:all>
			<xs:element name="CODICE_MODELLO" type="codiceModelloType"/>
			<xs:element name="NOME_MODELLO" type="xs:string" minOccurs="0"/>
			<xs:element name="MODALITA_COMPILAZIONE" type="modalitaCompilazione" minOccurs="0"/>
			<xs:element name="CLASSE_ESERCIZIO" type="xs:string" minOccurs="0"/>
			<xs:element name="TIPOLOGIA_ESERCIZIO" type="tipologiaEsercizio"/>
			<xs:element name="DESC_TIPOLOGIA_ESERCIZIO" type="assenzaCampoObbligatorio"/>
			<xs:element name="CODICE_SUBENTRO" type="codiceSubentro" minOccurs="0"/>
			<xs:element name="CODICE_APERTURA" type="codiceApertura" minOccurs="0"/>
			<xs:element name="CODICE_VARIAZIONE" type="codiceVariazione" minOccurs="0"/>
			<xs:element name="CODICE_CESSAZIONE" type="codiceCessazione" minOccurs="0"/>
			<xs:element name="DESCRIZIONE" type="xs:string" minOccurs="0"/>
			<xs:element name="DATA_DECORRENZA" type="dataIta" minOccurs="0"/>
		</xs:all>
	</xs:complexType>
	<xs:element name="MODELLO" type="modello"/>
	<xs:element name="DATA_CESSAZIONE" type="dataIta"/>
	<xs:simpleType name="codiceModelloType">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value="COM0"/>
			<xs:enumeration value="COM1"/>
			<xs:enumeration value="COM2"/>
			<xs:enumeration value="COM3"/>
			<xs:enumeration value="COM4"/>
			<xs:enumeration value="COM5"/>
			<xs:enumeration value="COM6"/>
			<xs:enumeration value="COM6BIS"/>
			<xs:enumeration value="COM7"/>
			<xs:enumeration value="COM8"/>
			<xs:enumeration value="COM9"/>
			<xs:enumeration value="IA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dataIta">
		<xs:restriction base="xs:string">
			<xs:maxLength value="10"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0]{0}|[0-9]{2,2}/[0-9]{2,2}/[0-9]{4,4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dataItaObblig">
		<xs:restriction base="xs:string">
			<xs:maxLength value="10"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0-9]{2,2}/[0-9]{2,2}/[0-9]{4,4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="modalitaCompilazione">
		<xs:restriction base="xs:string">
			<xs:enumeration value=""/>
			<xs:enumeration value="COM"/>
			<xs:enumeration value="TEL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="cap">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0]{0,1}|[0-9]{5}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="provincia">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0]{0}|[a-zA-Z]{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="provinciaItaObbl">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[a-zA-Z]{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="nrea">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0-9]{0,9}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codFisc">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0]{0}|[a-zA-Z]{6}[0-9]{2}[a-zA-Z]{1}[0-9]{2}[a-zA-Z]{1}[0-9]{3}[a-zA-Z]{1}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="piva">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0]{0}|[0-9]{11}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tipologiaEsercizio">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:minLength value="1"/>
			<xs:enumeration value="V"/>
			<xs:enumeration value="M"/>
			<xs:enumeration value="G"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="A"/>
			<xs:enumeration value="D"/>
			<xs:enumeration value="Y"/>
			<xs:enumeration value="T"/>
			<xs:enumeration value="W"/>
			<xs:enumeration value="I"/>
			<xs:enumeration value="Q"/>
			<xs:enumeration value="B"/>
			<xs:enumeration value="E"/>
			<xs:enumeration value="F"/>
			<xs:enumeration value="H"/>
			<xs:enumeration value="L"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="O"/>
			<xs:enumeration value="P"/>
			<xs:enumeration value="R"/>
			<xs:enumeration value="Z"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceSubentro">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value=""/>
			<xs:enumeration value="V"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="U"/>
			<xs:enumeration value="Z"/>
			<xs:enumeration value="A"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="F"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceApertura">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value=""/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="U"/>
			<xs:enumeration value="P"/>
			<xs:enumeration value="R"/>
			<xs:enumeration value="I"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceVariazione">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value=""/>
			<xs:enumeration value="T"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="A"/>
			<xs:enumeration value="M"/>
			<xs:enumeration value="U"/>
			<xs:enumeration value="B"/>
			<xs:enumeration value="X"/>
			<xs:enumeration value="W"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="L"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceCessazione">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value=""/>
			<xs:enumeration value="A"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="D"/>
			<xs:enumeration value="F"/>
			<xs:enumeration value="O"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="T"/>
			<xs:enumeration value="U"/>
			<xs:enumeration value="X"/>
			<xs:enumeration value="Y"/>
			<xs:enumeration value="R"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceAmpliatoRidotto">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[ARar]?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="siNo">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[SNsn]?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="siNoObblig">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="N"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceStagionalePermanente">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[SNPsnp]?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceAggiuntoEliminato">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[AEae]?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="trueFalse">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="true|false"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codIstatCT">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:length value="6"/>
			<xs:pattern value="[0-9]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="riquadriVariazioni">
		<xs:all>
			<xs:element name="INDICATORE_VARIAZIONE_SUPERFICIE_ALIMENTARE" type="codiceAmpliatoRidotto" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SUPERFICIE_NON_ALIMENTARE" type="codiceAmpliatoRidotto" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SUPERFICIE_VENDITA" type="codiceAmpliatoRidotto" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SETTORE_ALIMENTARE" type="codiceAggiuntoEliminato" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SETTORE_NON_ALIMENTARE" type="codiceAggiuntoEliminato" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SUPERFICIE_FARMACIA" type="codiceAmpliatoRidotto" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SETTORE_FARMACIA" type="codiceAggiuntoEliminato" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SUPERFICIE_MONOPOLIO" type="codiceAmpliatoRidotto" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SETTORE_MONOPOLIO" type="codiceAggiuntoEliminato" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SUPERFICIE_CARBURANTI" type="codiceAmpliatoRidotto" minOccurs="0"/>
			<xs:element name="INDICATORE_VARIAZIONE_SETTORE_CARBURANTI" type="codiceAggiuntoEliminato" minOccurs="0"/>
			<xs:element ref="CESSAZIONE" minOccurs="0"/>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="cessazione">
		<xs:all>
			<xs:element ref="DATA_CESSAZIONE"/>
			<xs:element name="CAUSALE_CESSAZIONE" type="xs:string"/>
		</xs:all>
	</xs:complexType>
	<xs:element name="CESSAZIONE" type="cessazione"/>
	<xs:element name="RIQUADRI_VARIAZIONI" type="riquadriVariazioni"/>
	<xs:complexType name="pratica">
		<xs:all>
			<xs:element name="CHIAVE_INTERNA_PRATICA" type="assenzaCampoObbligatorio"/>
			<xs:element name="NUMERO_PROTOCOLLO_COMUNE" type="xs:string" minOccurs="0"/>
			<xs:element name="NUMERO_PROTOCOLLO_COMUNE_INTERNO" type="xs:string" minOccurs="0"/>
			<xs:element name="DATA_PRESENTAZIONE_MODELLO" type="dataItaObblig"/>
			<xs:element name="NUMERO_AUTORIZZAZIONE" type="xs:string" minOccurs="0"/>
			<xs:element name="STATO_AVANZAMENTO_PRATICA" type="xs:string" minOccurs="0"/>
			<xs:element name="DATA_EVASIONE_MODELLO" type="dataItaObblig"/>
			<xs:element name="ESITO_ISTRUTTORIA" type="esito" minOccurs="0"/>
		</xs:all>
	</xs:complexType>
	<xs:element name="PRATICA" type="pratica"/>
	<xs:simpleType name="cciaa">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0]{0}|[a-zA-Z][a-zA-Z]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="esito">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:enumeration value=""/>
			<xs:enumeration value="B"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="I"/>
			<xs:enumeration value="A"/>
			<xs:enumeration value="S"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="assenzaCampoObbligatorio">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="sesso">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[0]{0}|[FMfm]{1}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="impresa">
		<xs:all>
			<xs:element name="CODICE_FISCALE" type="codFiscImpresa"/>
