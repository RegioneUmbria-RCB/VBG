<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee; http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	id="smart_servizi_ID" version="2.5">
	
	<display-name>Smart Servizi (_NOME_VERSIONE_)</display-name>
	
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>/WEB-INF/applicationContext.xml /WEB-INF/applicationContext-ws.xml /WEB-INF/spring-security.xml</param-value>
	</context-param>
	<context-param>
		<param-name>jmesaPreferencesLocation</param-name>
		<param-value>WEB-INF/jmesa.properties</param-value>
	</context-param>
	<context-param>
		<param-name>log4jConfigLocation</param-name>
		<param-value>classpath:log4j.properties</param-value>
	</context-param>
	<context-param>
		<param-name>log4jRefreshInterval</param-name>
		<param-value>5000</param-value>
	</context-param>
	<context-param>
		<param-name>webAppRootKey</param-name>
		<param-value>smart-servizi.root</param-value>
	</context-param>
	<filter>
		<filter-name>encodingFilter</filter-name>
		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
		<init-param>
			<param-name>forceEncoding</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>	
	  <filter>
	    <filter-name>StaticResponseHeaderFilter</filter-name>
	    <filter-class>it.gruppoinit.pal.gp.areariservata.web.util.StaticResponseHeaderFilter</filter-class>
	    <init-param>
	      <param-name>headername</param-name>
	      <param-value>P3P</param-value>
	    </init-param>
	    <init-param>
	      <param-name>headervalue</param-name>
	      <param-value>CP=&quot;NOI ADM DEV PSAi COM NAV OUR OTRo STP IND DEM&quot;</param-value>
	    </init-param>
	  </filter>
	
	<filter>
		<filter-name>sitemeshDecoratorFilter</filter-name>
		<filter-class>it.gruppoinit.pal.gp.areariservata.filter.SitemeshDecoratorFilter</filter-class>
	</filter>
  <filter>
    <display-name>ServiziResolverFilter</display-name>
    <filter-name>ServiziResolverFilter</filter-name>
    <filter-class>it.gruppoinit.pal.gp.areariservata.web.filter.ServiziResolverFilter</filter-class>
    <init-param>
    	<param-name>manutenzione</param-name>
    	<param-value></param-value>
  	</init-param>
  </filter>
	
	<filter>
		<filter-name>idcomuneFilter</filter-name>
		<filter-class>it.gruppoinit.pal.gp.areariservata.filter.IdComuneFilter</filter-class>		
	</filter>
	<filter>
		<filter-name>registrationFilter</filter-name>
		<filter-class>it.gruppoinit.pal.gp.areariservata.filter.RegistrationFilter</filter-class>
	</filter>
	<filter>
		<filter-name>springSecurityFilterChain</filter-name>
		<filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
	</filter>
	<filter>
		<filter-name>sitemeshFilter</filter-name>
		<filter-class>com.opensymphony.sitemesh.webapp.SiteMeshFilter</filter-class>
	</filter>
	
	<!-- il filtro per l'encoding deve essere il primo -->
	<filter-mapping>
		<filter-name>encodingFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
	    <filter-name>ServiziResolverFilter</filter-name>
	    <url-pattern>*</url-pattern>
	  </filter-mapping>
	<filter-mapping>
		<filter-name>idcomuneFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
		<url-pattern>/j_spring_security_check</url-pattern>
		<url-pattern>/j_spring_security_logout</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>registrationFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>springSecurityFilterChain</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>sitemeshDecoratorFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>sitemeshFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	
	<session-config>
		<session-timeout>60</session-timeout>
	</session-config>
	
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
	<listener>
		<listener-class>org.springframework.web.util.Log4jConfigListener</listener-class>
	</listener>
	
	<servlet>
		<servlet-name>smart-servizi</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet>
		<display-name>Log4j configuration Servlet</display-name>
		<servlet-name>log4j</servlet-name>
		<servlet-class>it.openutils.log4j.Log4jConfigurationServlet</servlet-class>
		<init-param>
			<param-name>fragment</param-name>
			<param-value>false</param-value>
		</init-param>
		<load-on-startup>2</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>cxf</servlet-name>
		<servlet-class>org.apache.cxf.transport.servlet.CXFServlet</servlet-class>
		<load-on-startup>3</load-on-startup>
	</servlet>
	
	<servlet-mapping>
		<servlet-name>cxf</servlet-name>
		<url-pattern>/services/*</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>log4j</servlet-name>
		<url-pattern>/log4j/*</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>smart-servizi</servlet-name>
		<url-pattern>*.htm</url-pattern>
		<url-pattern>/public_json/*</url-pattern>
		<url-pattern>/servizi/*</url-pattern>
		<url-pattern>/compilazione/*</url-pattern>
	</servlet-mapping>
	
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>
	
	<error-page>
		<exception-type>it.gruppoinit.pal.gp.cartfacct.EnteNonConfiguratoException</exception-type>
		<location>/WEB-INF/jsp/errorNonConfigurato.jsp</location>
	</error-page>
	
	<error-page>
		<exception-type>java.lang.Exception</exception-type>
		<location>/WEB-INF/jsp/error.jsp</location>
	</error-page>
	
	<login-config>
		<auth-method>BASIC</auth-method>
	</login-config>
	<resource-ref>
		<description>CAD Comunica DataSource</description>
		<res-ref-name>jdbc/cart-im-adapter</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>
	
</web-app>