<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN"
		  "http://www.springframework.org/dtd/spring-beans-2.0.dtd">

<beans>
	<bean name="jsonView" class="org.springframework.web.servlet.view.json.JsonView">
		<property name="encoding">
			<value>UTF-8</value>
		</property>
		<property name="contentType">
			<value>application/json</value>
		</property>
		<property name="jsonWriter">
			<ref bean="jsonWriter" />
		</property>
	</bean>
	<bean name="jsonAsTextView" class="org.springframework.web.servlet.view.json.JsonView">
		<property name="encoding">
			<value>UTF-8</value>
		</property>
		<property name="contentType">
			<value>text/plain</value>
		</property>
		<property name="jsonWriter">
			<ref bean="jsonWriter" />
		</property>
	</bean>
	<bean name="jsonWriter"
		class="org.springframework.web.servlet.view.json.writer.sojo.SojoJsonStringWriter">
		<property name="convertAllMapValues">
			<value>true</value>
		</property>
		<property name="keepValueTypesMode">
			<value>ALL</value>
		</property>
	</bean>
</beans>