                <xs:annotation>
                    <xs:documentation>Dati del intestatario del debito</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CodiceEsitoSingoloPagamento" type="xs:string" minOccurs="0"/>
            <!-- 0:1 da flusso ma deve coincidere con la ricevuta altrimenti errore: lo metto opz per compatibilità col caso by IUV -->
            <xs:element name="DataEsitoSingoloPagamento" type="xs:date"/>
            <!-- 1 da flusso , ma deve coincidere con la ricevuta altrimenti errore -->
            <xs:element name="CausaleSingoloPagamento" type="xs:string" minOccurs="0"/>
            <xs:element name="Debito" type="jcg_pagopa:ctRiconciliazioneDebito" minOccurs="0"/>
            <!-- da 0 a 1 lo metto solo se trovo il debito -->
            <xs:element name="EsitoRiconciliazione" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>popolato in caso di riconciliazione per fluso di rendicontazione o per
                        identificativo univoco versamento
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Messaggio" type="xs:string" minOccurs="0"/>
        </xs:sequence>
