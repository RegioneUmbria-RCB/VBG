                <xs:annotation>
                    <xs:documentation>
                        il codice tipo debito relativo al singolo pagamento rappresentato dal nodo Parent, può essere
                        opzionale nel caso in cui venga rendicontato uno IUV non presente all'interno della banca dati
                        (i.e. ente multiintermediato)
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="IdentificativoUnivocoRiscossione" type="xs:string"/>
            <!-- da flusso , nel caso la richiesta sia per idFlusso, oppure nella ricevuta-->
            <xs:element name="SingoloImportoPagato" type="jcg_pagopa:stImporto"/>
            <!-- da flusso , ma deve coincidere con la ricevuta  errore -->
            <xs:element name="DatiVersante" type="jcg_pagopa:ctSoggetto" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Dati del contribuente che ha pagato il debito.</xs:documentation>
