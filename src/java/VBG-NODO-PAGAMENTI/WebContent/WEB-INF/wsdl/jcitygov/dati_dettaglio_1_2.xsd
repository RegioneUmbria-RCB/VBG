<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns:jcg_pagopa="http://schemi.informatica.maggioli.it/operations/jcgpagopa/1_2"
           targetNamespace="http://schemi.informatica.maggioli.it/operations/jcgpagopa/1_2"
           elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.2">

    <!-- Simple Types -->
    <xs:simpleType name="stEsito">
        <xs:restriction base="xs:string">
            <xs:enumeration value="OK"/>
            <xs:enumeration value="Error"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText1000">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="1000"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText200">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="200"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText35">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="35"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText140">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="140"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText70">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="70"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText256">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="256"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText40">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="40"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText16">
        <xs:restriction base="xs:string">
            <xs:maxLength value="16"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText11">
        <xs:restriction base="xs:string">
            <xs:minLength value="11"/>
            <xs:maxLength value="11"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText1">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="1"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stText2">
        <xs:restriction base="xs:string">
            <xs:minLength value="2"/>
            <xs:maxLength value="2"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stAnno">
        <xs:restriction base="xs:string">
            <xs:maxLength value="4"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stIUV">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="35"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stIUVmod12">
        <xs:restriction base="xs:string">
            <xs:minLength value="25"/>
            <xs:maxLength value="25"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stNumeroAvviso18">
        <xs:restriction base="xs:string">
            <xs:minLength value="18"/>
            <xs:maxLength value="18"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stTipoIdentificativoUnivocoPersFG">
        <xs:restriction base="xs:string">
            <xs:length value="1"/>
            <xs:enumeration value="F"/>
            <xs:enumeration value="G"/>
            <!-- Persona Fisica -->
            <!-- Persona Giuridica -->
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stImporto">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0.00"/>
            <xs:maxInclusive value="999999999.99"/>
            <xs:fractionDigits value="2"/>
            <xs:totalDigits value="12"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stCodiceLotto">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="200"/>
            <xs:pattern value="[A-Za-z0-9]{1,1}[A-Za-z0-9\-]{0,199}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stEsitoRiconciliazioneSospeso">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Totale"/>
            <xs:enumeration value="Parziale"/>
            <xs:enumeration value="NonPresente"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stCodiceMotivoEliminazione">
        <xs:restriction base="xs:string">
            <xs:enumeration value="SOSTITUZIONE"/>
            <xs:enumeration value="PAGAMENTO_ESTERNO"/>
            <xs:enumeration value="ELIMINAZIONE_DEBITO"/>
            <xs:enumeration value="ALTRO"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stOperazioneRiconciliazione">
        <xs:restriction base="xs:string">
            <xs:enumeration value="PER_SOSPESI"/>
            <xs:enumeration value="PER_IDENTIFICATIVO_FLUSSO"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stModPagamento">
        <xs:restriction base="xs:string">
            <xs:enumeration value="MOD1"/>
            <xs:enumeration value="MOD3"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stStatoPagamento">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CONTABILIZZATO"/>
            <xs:enumeration value="NOTIFICATO"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stContestoPos">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CONCILIA"/>
            <xs:enumeration value="JDEMOS"/>
            <xs:enumeration value="JTRIB"/>
            <xs:enumeration value="JCITYGOV"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stContestoDovuto">
        <xs:restriction base="xs:string">
            <xs:enumeration value="MULTIBENEFICIARIO"/>
            <xs:enumeration value="MONOBENEFICIARIO"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stOperazioniModifica">
        <xs:restriction base="xs:string">
            <xs:enumeration value="MODIFICA_ANNO_COMPETENZA"/>
            <xs:enumeration value="MODIFICA_CAUSALE_DEBITO"/>
            <xs:enumeration value="MODIFICA_CONTRIBUENTE_DEBITO"/>
            <xs:enumeration value="MODIFICA_IMPORTO_DEBITO"/>
            <xs:enumeration value="MODIFICA_DETTAGLI_IMPORTO_DEBITO"/>
            <xs:enumeration value="MODIFICA_SCADENZA_DEBITO"/>
            <xs:enumeration value="ALL"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Simple Types -->

    <!-- Complex Types -->
    <xs:complexType name="ctIntervallo">
        <xs:sequence>
            <xs:element name="dataInizio" type="xsd:dateTime" minOccurs="0"/>
            <xs:element name="dataFine" type="xsd:dateTime" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ctEsito">
        <xs:sequence>
            <xs:element name="Esito" type="jcg_pagopa:stEsito"/>
            <xs:element name="Messaggio" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctNumeroAvviso">
        <xs:simpleContent>
            <xs:extension base="jcg_pagopa:stNumeroAvviso18">
                <xs:attribute name="FlagAttivaDebito" type="xs:boolean" default="false"/>
                <xs:attribute name="VersioneNumeroAvviso" type="xs:int"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="ctAvvisoPagamento">
        <xs:sequence>
            <xs:element name="NumeroAvviso" type="jcg_pagopa:ctNumeroAvviso" minOccurs="0"/>
            <xs:element name="Debito" type="jcg_pagopa:ctDebito"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ctAvvisoPagamentoResult">
        <xs:sequence>
            <xs:element name="NumeroAvviso" type="jcg_pagopa:ctNumeroAvviso"/>
            <xs:element name="ChiaveDebito" type="jcg_pagopa:ctChiaveDebito"/>
            <xs:element name="Esito" type="jcg_pagopa:ctEsito"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctInviaDovutoResult">
        <xs:sequence>
            <xs:element name="NumeroAvviso" type="jcg_pagopa:ctNumeroAvviso" minOccurs="0"/>
            <xs:element name="ChiaveDebito" type="jcg_pagopa:ctChiaveDebito"/>
            <xs:element name="Esito" type="jcg_pagopa:ctEsito"/>
        </xs:sequence>
    </xs:complexType>


    <xs:complexType name="ctCancellaDovutoResult">
        <xs:sequence>
            <xs:element name="Esito" type="jcg_pagopa:ctEsito"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctAttivaDovutoResult">
        <xs:sequence>
            <xs:element name="Esito" type="jcg_pagopa:ctEsito"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctDebitoPagato">
        <xs:sequence>
            <xs:element name="ChiaviDebito" type="jcg_pagopa:ctChiaveDebito"/>
            <xs:element name="IdentificativoUnivocoVersamento" type="jcg_pagopa:stIUV"/>
            <xs:element name="ModalitaPagamento" type="jcg_pagopa:stModPagamento"/>
            <xs:element name="StatoPagamento" type="jcg_pagopa:stStatoPagamento"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctChiaveDebito">
        <xs:sequence>
            <xs:element name="IDPos" type="jcg_pagopa:stText256"/>
            <xs:element name="IDDeb" type="jcg_pagopa:stText256"/>
            <xs:element name="CodiceTipoDebito" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctChiaveDebitoIDPos">
        <xs:sequence>
            <xs:element name="IDPos" type="jcg_pagopa:stText256"/>
            <xs:element name="CodiceTipoDebito" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctDebito">
        <xs:sequence>
            <xs:element name="TestataDebito" type="jcg_pagopa:ctTestataDebito"/>
            <xs:element name="DettaglioDebito" type="jcg_pagopa:ctDettaglioDebito"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctDovuto">
        <xs:sequence>
            <xs:element name="NumeroAvviso" type="jcg_pagopa:ctNumeroAvviso" minOccurs="0"/>
            <xs:element name="ContestoDovuto" type="jcg_pagopa:stContestoDovuto"/>
            <xs:element name="TestataDovuto" type="jcg_pagopa:ctTestataDovuto"/>
            <xs:element name="DettaglioDovuto" type="jcg_pagopa:ctDettaglioDovuto" minOccurs="1" maxOccurs="2"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctParametroDebito">
        <xs:sequence>
            <xs:element name="CodiceParametro" type="xs:string"/>
            <xs:element name="ValoreParametro" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctParametriDebito">
        <xs:sequence>
            <xs:element name="ParametroDebito" type="jcg_pagopa:ctParametroDebito"
                        maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctMarcaBollo">
        <xs:sequence>
            <xs:element name="HashDocumento" type="xs:string"/>
            <xs:element name="ProvinciaResidenzaSoggettoPagatore" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctInfoPagamentoTelematico">
        <xs:sequence>
            <xs:element name="IdentificativoDominio" type="xs:string"/>
            <xs:element name="IdentificativoUnivocoVersamento" type="jcg_pagopa:stIUV"/>
            <xs:element name="CodiceContestoApplicativo" type="xs:string"/>
            <xs:element name="TipoVersamento" type="xs:string"/>
            <xs:element name="NumeroAvviso" type="jcg_pagopa:stNumeroAvviso18" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Presente solo se pagamento in modalità 3, per avvisi caricati sul sistema
                        payservice.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="StatoTecnicoPagamento" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Stato tecnico:INSERITO (non ancora inviato),RIFIUTATO (tentato invio, con esito
                        negativo), INVIATO (inviato al nodo), COMPLETATO (operazione completata, in attesa di ricevuta),
                        CONTABILIZZATO (ricevuta disponibile), NOTIFICATO (notificato al B.O.), INDETERMINATO (pagamento
                        non presente nel database locale)
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="EsitoRichiestaPagamento" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Esito:
                        NON_CONCLUSO,RIFIUTATA,NON_CONCLUSO,CONCLUSO_ESEGUITO,CONCLUSO_NON_ESEGUITO,CONCLUSO_ESEGUITO_PARZIALMENTE,CONCLUSO_NON_ESEGUITO_DECORRENZA,CONCLUSO_NON_ESEGUITO_DECORRENZA_PARZIALE
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ImportoTotaleRichiesta" type="jcg_pagopa:stImporto" minOccurs="0"/>
            <xs:element name="ImportoTotalePagato" type="jcg_pagopa:stImporto" minOccurs="0"/>
            <xs:element name="DataPagamento" type="xs:dateTime" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Data in cui è stato effettuato il pagamento, coincide che con ladata presente
                        nella ricevuta telematica o documento congruente.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DataAccredito" type="xs:dateTime" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Data di accredito del pagamento, data in cui l'importo è stato riversato sul conto
                        indicato dall'ente.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="NumeroVersamentiSingoli" type="xs:integer"/>
            <xs:element name="InfoVersamentoSingolo" type="jcg_pagopa:ctInfoVersamentoSingolo"
                        maxOccurs="5"/>
            <xs:element name="FlussoRicevuta" type="xs:string" minOccurs="0"/>
            <xs:element name="DatiVersante" type="jcg_pagopa:ctSoggetto" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Dati del contribuente che ha pagato il debito.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DatiDebitore" type="jcg_pagopa:ctSoggetto" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Dati del intestatario del debito</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctInfoVersamentoSingolo">
        <xs:sequence>
            <xs:element name="ChiaveDebito" type="jcg_pagopa:ctChiaveDebito" minOccurs="0"/>
            <!--xs:element name="riferimentoNumeroAvvisoOriginario" type="jcg_pagopa:stNumeroAvviso18" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Presente solo se il pagamento è stato effettuato secondo il modello 1 o 2 per pagare un'avviso predisposto per la modalità 3.</xs:documentation>
                </xs:annotation>
            </xs:element-->
            <xs:element name="ProgressivoVersamentoSingolo" type="xs:integer" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Posizione del versamento singolo nella richiesta di pagamento. Presente solo se
                        non sono stati riportati tutti i versamenti (per esempio per informazioni specifiche su unn
                        debito).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ImportoSingoloRichiesta" type="jcg_pagopa:stImporto" minOccurs="0"/>
            <xs:element name="ImportoSingoloPagato" type="jcg_pagopa:stImporto" minOccurs="0"/>
            <xs:element name="EsitoVersamentoSingolo" type="xs:string"/>
            <xs:element name="TestoAllegato" type="xs:string" minOccurs="0"/>
            <xs:element name="TipoAllegato" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctIdentificativoUnivocoPersonaFG">
        <xs:sequence>
            <xs:element name="tipoIdentificativoUnivoco"
                        type="jcg_pagopa:stTipoIdentificativoUnivocoPersFG" minOccurs="0">
                <!-- 20190813 reso non obbligatorio per gestire i pagamenti anonimi -->
                <xs:annotation>
                    <xs:documentation>Campo alfanumerico che indica la natura del soggetto, può assumere i seguenti
                        valori:
                    </xs:documentation>
                    <xs:documentation>F - Persona Fisica</xs:documentation>
                    <xs:documentation>G - Persona Giuridica</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="codiceIdentificativoUnivoco" type="jcg_pagopa:stText16" minOccurs="0">
                <!-- 20190813 reso non obbligatorio per gestire i pagamenti anonimi -->
                <xs:annotation>
                    <xs:documentation>Campo alfanumerico che può contenere il codice fiscale o, in alternativa, la
                        partita IVA del soggetto.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctBackUrl">
        <xs:sequence>
            <xs:element name="BackUrlOK" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Callback url OK</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BackUrlKO" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Callback url KO</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BackUrlNotify" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Callback di notifica. Se non valorizzato viene usato l'url di notifica configurato
                        per il servizio richiedente.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctBackUrlPOS">
        <xs:sequence>
            <xs:element name="BackUrlOK" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Callback url OK</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BackUrlKO" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Callback url KO</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BackUrlNotify" type="xs:string" minOccurs="1">
                <xs:annotation>
                    <xs:documentation>Callback di notifica.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctSoggetto">
        <xs:sequence>
            <xs:element name="IdentificativoUnivocoVersante"
                        type="jcg_pagopa:ctIdentificativoUnivocoPersonaFG">
                <xs:annotation>
                    <xs:documentation>Aggregazione che riporta le informazioni concernenti l’identificazione fiscale del
                        versante.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Nome" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Nome del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Cognome" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Cognome del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="RagioneSociale" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>denominazione nel caso della persona giuridica</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Indirizzo" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indica l’indirizzo del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Civico" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indica il numero civico del versante.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Cap" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indica il CAP del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Localita" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indica la località del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Provincia" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indica la provincia del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Nazione" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indica il codice nazione del soggetto secondo lo standard ISO 3166 alpha 2 (e.g.
                        Italia = IT, Francia FR )
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Email" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Indirizzo di posta elettronica del soggetto.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctDettaglioImporto">
        <xs:annotation>
            <xs:documentation>tipo complesso che rappresenta un dettaglio di importo, dato un importo i relativi
                dettagli servono per poter specificare con maggiore precisione da cosa quell'importo è costituito (es:
                iomposta, sanzioni, interessi, ecc...).
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="codice" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>utilizzato per inserire il TIPO VOCE</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="descrizione" type="xs:string">
                <xs:annotation>
                    <xs:documentation>descrizione testuale leggibile del dettaglio importo</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="importo" type="jcg_pagopa:stImporto">
                <xs:annotation>
                    <xs:documentation>valore decimale del dettaglio importo</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="capitoloBilancio" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>codice del capitolo di bilancio - utilizzato per inserire ANNO</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="anno" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>anno relativo al capitolo di bilancio - sovrascrive il campo capito di bilancio
                        (non utilizzato al momento)
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ctDettagliImporto">
        <xs:annotation>
            <xs:documentation>tipo complesso che rappresenta una lista di dettagli importo.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="dettaglioImporto" type="jcg_pagopa:ctDettaglioImporto"
                        maxOccurs="unbounded"/>
        </xs:sequence>
