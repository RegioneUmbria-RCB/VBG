<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema xmlns="http://www.insiel.it/pagamentifvg/datiAggiuntivi"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.insiel.it/pagamentifvg/datiAggiuntivi"
	elementFormDefault="qualified" 
	attributeFormDefault="unqualified">
	
	<xsd:element name="datiAggiuntivi">
        <xsd:complexType>
			<xsd:sequence>
				<xsd:element name="datiProtocollo" type="DatiProtocollo" minOccurs="0"/>
				<xsd:element name="avvisatura" type="Avvisatura" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
    </xsd:element>

	<xsd:complexType name="DatiProtocollo">
			<xsd:sequence>
				<xsd:element name="numeroProtocollo" type="xsd:string" minOccurs="0" />
			</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="Avvisatura">
			<xsd:sequence>
				<xsd:element name="generaSoloAvviso" type="xsd:boolean" minOccurs="0" default="false"/>
				<xsd:element name="lingue" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element maxOccurs="unbounded" minOccurs="0" name="lingua" type="xsd:string" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>				
			</xsd:sequence>
	</xsd:complexType>
	
</xsd:schema>