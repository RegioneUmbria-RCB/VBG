<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xsd:schema xmlns="http://www.muta.servizirl.it/schema/muta/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.muta.servizirl.it/schema/muta/1.0" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xsd:annotation>
		<xsd:documentation xml:lang="it">
			Changelog:
				28/03/2011 - Sostituzione stato pratica 'DEFINITIVA' con stato 'SOSPESA'
				
				16/03/2011 - Definizione nuovi type per la gestione delle pratiche SCIA.

				17/02/2011 - Aggiornato element codiceAOO e codiceAmministrazione in protocolloType.

				02/11/2010 - Spostamento da schema DIAP di noEmptyStringType
								 - prima definizione codiceAmministrazioneType
								 - spostamento da schema DIAP e revisione protocolloType
								 - revisione validazionePraticaType

				12/10/2010 - revisione element id_pratica, reso nillable

				13/09/2010 - Aggiornamento tipi di errore, aggiunta ERRORE_VALIDAZIONE_LOGICA
								   - aggiornamento tipi validazione, aggiunte tipologie per la distinta degli allegati
								   - revisione tipo validazionePraticaType
								   - revisione tipo validazioneDIAPType

				11/05/2010 - Integrazione della gestione delle notifiche degli errori nel modello B
        </xsd:documentation>
	</xsd:annotation>
	<xsd:simpleType name="noEmptyStringType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				14/09/2010 - Stringa non vuota e senza spazi in testa.
				02/11/2010 - Spostamento da schema DIAP.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:pattern value="[^\s].*"/>
			<!-- la stringa non può iniziare con uno spazio -->
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="codiceAmministrazioneType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				02/11/2010 - Prima definizione type.
                17/02/2011 - Revisione definizione per estensione lunghezza a 16 caratteri come da normativa
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="noEmptyStringType">
			<xsd:pattern value="[0-9A-Za-z_\-]{1,16}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="numeroProtocolloType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				17/02/2011 - Prima definizione type.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="noEmptyStringType">
			<xsd:pattern value="[0-9]{1,7}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="protocolloType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				17/02/2011 - Modifica elementi codiceAOO e codiceAmministrazione, aggiunto minOccurs="0".
				17/02/2011 - Modifica tipo numeroRegistrazione: striinga numeriga di lunghezza fino a 7 caratteri.
				02/11/2010 - Spostamento da schema DIAP e revisione type.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="codiceAOO" type="codiceAmministrazioneType" minOccurs="0"/>
			<xsd:element name="numeroRegistrazione" type="numeroProtocolloType"/>
			<xsd:element name="dataRegistrazione" type="xsd:date"/>
			<xsd:element name="codiceAmministrazione" type="codiceAmministrazioneType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="statoPraticaType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				28/03/2011 - Sostituito stato pratica 'DEFINITIVA' con stato 'SOSPESA'
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="BOZZA"/>
			<xsd:enumeration value="COMPILATA"/>
			<xsd:enumeration value="DEFINITIVA"/>
			<xsd:enumeration value="SOSPESA"/>
			<!-- <xsd:enumeration value="RITIRATA"/> -->
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="statoValidazionePraticaType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				13/09/2010 - Aggiornamento tipi di errore, aggiunta ERRORE_VALIDAZIONE_LOGICA
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="OK_VALIDATA_CARICATA"/>
			<xsd:enumeration value="ERRORE_GENERICO"/>
			<xsd:enumeration value="ERRORE_VALIDAZIONE_FORMALE"/>
			<xsd:enumeration value="ERRORE_VALIDAZIONE_LOGICA"/>
			<xsd:enumeration value="ERRORE_VALIDAZIONE_DATI"/>
		</xsd:restriction>
	</xsd:simpleType>
	
