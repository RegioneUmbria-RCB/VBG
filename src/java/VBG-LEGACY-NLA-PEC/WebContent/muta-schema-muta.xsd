	<xsd:complexType name="validazionePraticaType">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
				13/09/2010 - Revisione struttura Type
				12/10/2010 - revisione element id_pratica, reso nillable
				02/11/2010 - rimozione choice id_pratica/num_protocollo
								 - rimozione id_pratica nillable
								 - rinomino e cambio type elemento protocollo
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="id_pratica" type="xsd:string" minOccurs="0"/>
			<xsd:element name="protocollo" type="protocolloType" minOccurs="0"/>
		</xsd:sequence>
		<xsd:attribute name="stato" type="statoValidazionePraticaType" use="required"/>
		<xsd:attribute name="descrizione" type="xsd:string"/>
		<xsd:attribute name="data" type="xsd:dateTime" use="required"/>
	</xsd:complexType>
	
