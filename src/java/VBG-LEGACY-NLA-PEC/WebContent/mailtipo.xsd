<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
	xmlns:tns="http://gruppoinit.it/sigepro/schemas/messages/mailtipo" 
	xmlns:types="http://sigepro.init.it/rte/types" 
	elementFormDefault="qualified"
	targetNamespace="http://gruppoinit.it/sigepro/schemas/messages/mailtipo" 
	xmlns:xmime="http://www.w3.org/2005/05/xmlmime">
	<import namespace="http://sigepro.init.it/rte/types" schemaLocation="types.xsd" />
	<element name="MailtipoRequest">
		<complexType>
			<all>
				<element name="token" type="string" />
				<element name="codicemailtipo" type="int" />
				<element name="codiceistanza" nillable="true" type="int" />
				<element name="codicemovimento" nillable="true" type="int" />
			</all>
		</complexType>
	</element>
	<element name="MailtipoFrontendRequest">
		<complexType>
			<all>
				<element name="token" type="string" />
				<element name="codicemailtipo" type="int" />							
				<element name="dettaglioPratica" type="types:DettaglioPraticaType" />
			</all>
		</complexType>
	</element>
	<element name="MailtipoResponse">
		<complexType>
			<all>
				<element name="oggetto" type="string" />
				<element name="corpo" type="string" />
			</all>
		</complexType>
	</element>
</schema>