	<xsd:complexType name="scheda4Type">
		<xsd:sequence>
			<xsd:element name="NUM_ADDETTI_DIAP" type="xsd:integer" minOccurs="0"/>
			<xsd:element name="NUM_ADDETTI_IMPRESE" type="xsd:integer" minOccurs="0"/>
			<xsd:element name="NUM_ADDETTI_PER_ATT" type="xsd:integer" minOccurs="0"/>
