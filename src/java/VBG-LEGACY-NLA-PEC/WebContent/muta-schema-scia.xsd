			<xsd:element name="ACCONCIA_QUALIFICA_DATA" type="xsd:date" minOccurs="0"/>
			<xsd:element name="ESTETISTA" type="xsd:boolean" default="false"/>
			<!-- Se ESTETISTA = true allora valorizzare i campi ESTETISTA* -->
			<xsd:choice minOccurs="0">
				<xsd:element name="ESTETISTA_TITOLARE" type="xsd:boolean"/>
				<xsd:element name="ESTETISTA_SOCIO" type="xsd:boolean"/>
				<xsd:element name="ESTETISTA_FAM_COL_DIP" type="xsd:boolean"/>
			</xsd:choice>
			<xsd:element name="ESTETISTA_ANAGRAFICA" type="scheda3AnagraficaType" minOccurs="0"/>
			<xsd:element name="ESTETISTA_QUALIFICA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="ESTETISTA_QUALIFICA_DATA" type="xsd:date" minOccurs="0"/>
