	<xsd:complexType name="modelloAschedaA1Type">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
					29/04/2011 - Aggiornati TIPO26_PRODOTTI_SFUSI e TIPO26_PRODOTTI_CONF, non sono più esclusivi in choice
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<!-- Inizio ATTIVITA' ECONOMICHE NON ALIMENTARI -->
			<!-- 1.1 Attività produttiva (Industriale, manifatturiera,ecc.) -->
			<xsd:element name="TIPO11" type="xsd:boolean" default="false"/>
			<!-- 1.2 Attività di deposito merci -->
			<xsd:element name="TIPO12" type="xsd:boolean" default="false"/>
			<!-- 1.3 Commercio di prodotti fitosanitari -->
			<xsd:element name="TIPO13" type="xsd:boolean" default="false"/>
			<!-- Inizio sezione 1.4 Attività nel settore dei mangimi -->
			<xsd:element name="TIPO141" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO142" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO143" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO144" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO145" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO146" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO147" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO148" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO149" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO1410" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO1411" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO1412" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO1413" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO14_NUM_RICON_COMUNIT" type="xsd:string" minOccurs="0"/>
			<!-- Fine sezione 1.4 -->
			<!-- Inizio sezione 1.5 Attività di vendita -->
			<!-- NB: se si sceglie di avviare un' attività ALIMENTARE (punto 2.3), la tipologia di vendita che si potrà selezionare dovrà essere la medesima di quella qui selezionata: si riporta una tabella esplicativa -->
			<xsd:choice minOccurs="0">
				<xsd:element name="TIPO151" type="xsd:boolean"/>
				<xsd:element name="TIPO152" type="xsd:boolean"/>
				<xsd:element name="TIPO153" type="xsd:boolean"/>
				<xsd:element name="TIPO154" type="xsd:boolean"/>
				<xsd:element name="TIPO155" type="xsd:boolean"/>
			</xsd:choice>
			<!-- Fine sezione 1.5 -->
			<!-- Inizio sezione 1.6 Attività di servizi alla persona -->
			<xsd:element name="TIPO161" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO162" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO163" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO164" type="xsd:boolean" default="false"/>
			<!-- Se TIPO164 = true allora valorizzare ALTRO_SERVIZI_PERS -->
			<xsd:element name="ALTRO_SERVIZI_PERS" type="xsd:string" minOccurs="0"/>
			<!-- Fine sezione 1.6 -->
			<!-- Inizio sezione 1.7 Altre attività di servizio -->
			<xsd:element name="TIPO171" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO172" type="xsd:boolean" default="false"/>
			<!-- Se TIPO172 = true allora valorizzare ALTRO_SERVIZI -->
			<xsd:element name="ALTRO_SERVIZI" type="xsd:string" minOccurs="0"/>
