			<xsd:element name="ANNO_ATECO_1" type="xsd:gYear"/>
			<xsd:element name="CODICE_ATECO_2" type="codiceAtecoType" minOccurs="0"/>
			<xsd:element name="ANNO_ATECO_2" type="xsd:gYear" minOccurs="0"/>
			<xsd:element name="CODICE_ATECO_3" type="codiceAtecoType" minOccurs="0"/>
			<xsd:element name="ANNO_ATECO_3" type="xsd:gYear" minOccurs="0"/>
			<xsd:element name="CODICE_ATECO_4" type="codiceAtecoType" minOccurs="0"/>
			<xsd:element name="ANNO_ATECO_4" type="xsd:gYear" minOccurs="0"/>
			<xsd:element name="CODICE_ATECO_5" type="codiceAtecoType" minOccurs="0"/>
			<xsd:element name="ANNO_ATECO_5" type="xsd:gYear" minOccurs="0"/>
			<xsd:element name="AUTORIZZ_NUM" type="xsd:string" minOccurs="0"/>
			<xsd:element name="AUTOR_RILASCIO_IL" type="xsd:date" minOccurs="0"/>
			<xsd:element name="AUTOR_AISENSI" type="xsd:string" minOccurs="0"/>
			<xsd:element name="MATERIALI_PERALIM" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPOLOGIA_IMPIANTO" type="tipologiaImpiantoType"/>
			<xsd:element name="MATERIALE_PRODOTTO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="QUANTITATIVO_ANNUO" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="QUANTITATIVO_MISURA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="MATERIALE" type="materialeType" minOccurs="0"/>
			<xsd:element name="SE_LIQUIDO" type="liquidoType" minOccurs="0"/>
			<xsd:element name="SE_SOLIDO" type="solidoType" minOccurs="0"/>
			<xsd:element name="ENERGIATERMICA" type="xsd:boolean" default="false"/>
			<xsd:element name="MECCANICA" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPOLOGIA_RISCHI" type="scheda4TipologiaRischiType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda5EstremiAutorizzazioneType">
		<xsd:sequence>
			<xsd:element name="ESTREMI" type="xsd:string"/>
			<xsd:element name="DATA" type="xsd:date"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda5TecnicoType">
		<xsd:sequence>
			<xsd:element name="NOME" type="muta:noEmptyStringType"/>
			<xsd:element name="COGNOME" type="muta:noEmptyStringType"/>
			<xsd:element name="CODICE_FISCALE" type="codiceFiscaleType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda5Type">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
					20/06/2011 - Per tutti gli elementi di tipo scheda5EstremiAutorizzazioneType introdotto relativo elemento boolean
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="IDRO_DOMESTICO" type="xsd:boolean" default="false"/>
			<xsd:element name="IDRO_DOMESTICO_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="IDRO_INDUSTRIALE" type="xsd:boolean" default="false"/>
			<xsd:element name="IDRO_INDUSTRIALE_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="IDRO_METEORICO" type="xsd:boolean" default="false"/>
			<xsd:element name="IDRO_METEORICO_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="IDRO_FOGNATURA" type="xsd:boolean" default="false"/>
			<xsd:element name="IDRO_FOGNATURA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="IDRO_CORPO_IDRICO" type="xsd:boolean" default="false"/>
			<xsd:element name="IDRO_CORPO_IDRICO_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="IDRO_SUOLO_SOTTO" type="xsd:boolean" default="false"/>
			<xsd:element name="IDRO_SUOLO_SOTTO_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="EMISS_SCARSA" type="xsd:boolean" default="false"/>
			<xsd:element name="EMISS_SCARSA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="EMISS_DEROGA" type="xsd:boolean" default="false"/>
			<xsd:element name="EMISS_DEROGA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="EMISS_ORDINARIA" type="xsd:boolean" default="false"/>
			<xsd:element name="EMISS_ORDINARIA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="EMISS_UNICA" type="xsd:boolean" default="false"/>
			<xsd:element name="EMISS_UNICA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="RIFIUTI_SEMPLIFICATA" type="xsd:boolean" default="false"/>
			<xsd:element name="RIFIUTI_SEMPLIFICATA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="RIFIUTI_ODINARIA" type="xsd:boolean" default="false"/>
			<xsd:element name="RIFIUTI_ODINARIA_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="INTEGRA_CARBURANTE" type="xsd:boolean" default="false"/>
			<xsd:element name="INTEGRA_CARBURANTE_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="INTEGRA_GASTOSSICI" type="xsd:boolean" default="false"/>
			<xsd:element name="INTEGRA_GASTOSSICI_ESTREMI" type="scheda5EstremiAutorizzazioneType" minOccurs="0"/>
			<xsd:element name="ATTIVITARISCHIO" type="xsd:boolean" default="false"/>
			<!-- Se ATTIVITARISCHIO = true allora valorizzare ARTICOLI e RISCHIO_DATA_NOTIFICA -->
			<xsd:element name="ARTICOLI" type="articoliType" minOccurs="0"/>
			<xsd:element name="RISCHIO_DATA_NOTIFICA" type="xsd:date" minOccurs="0"/>
			<xsd:choice minOccurs="0">
				<xsd:element name="INSALUBRI_1CLASSE" type="xsd:boolean"/>
				<xsd:element name="INSALUBRI_2CLASSE" type="xsd:boolean"/>
			</xsd:choice>
			<xsd:element name="PRESENZA_SERBATOI" type="xsd:boolean" default="false"/>
			<!-- Se PRESENZA_SERBATOI = true allora valorizzare a true almeno uno dei due tra SERBATOI_FUORI e SERBATOI_INTERRATI -->
			<xsd:element name="SERBATOI_FUORI" type="xsd:boolean" default="false"/>
			<xsd:element name="SERBATOI_FUORI_DOPPIA" type="xsd:boolean" default="false"/>
			<xsd:element name="SERBATOI_INTERRATI" type="xsd:boolean" default="false"/>
			<xsd:element name="SERBATOI_INTERRATI_DOPPIA" type="xsd:boolean" default="false"/>
			<xsd:element name="IMP_ACUST_DATA" type="xsd:date" minOccurs="0"/>
			<xsd:element name="IMP_ACUST_TECNICO" type="scheda5TecnicoType" minOccurs="0"/>
			<xsd:element name="LIMIT_EXPO_DATA" type="xsd:date" minOccurs="0"/>
			<xsd:element name="LIMIT_EXPO_TECNICO" type="scheda5TecnicoType" minOccurs="0"/>
			<xsd:element name="RADIOATT_ESTREMI" type="xsd:string" minOccurs="0"/>
			<xsd:element name="RADIOATT_AUTORITA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="RADIOATT_DATA" type="xsd:date" minOccurs="0"/>
			<xsd:element name="INCENDIO_PARERE" type="xsd:string" minOccurs="0"/>
			<xsd:element name="INCENDIO_PARERE_DATA" type="xsd:date" minOccurs="0"/>
			<xsd:element name="INCENDIO_DIA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="INCENDIO_DIA_DATA" type="xsd:date" minOccurs="0"/>
			<xsd:element name="INCENDIO_RICHIESTA_CPI_DATA" type="xsd:date" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda6DipendenzaType">
		<xsd:sequence>
			<xsd:element name="VIA" type="muta:noEmptyStringType"/>
			<xsd:element name="NUM" type="muta:noEmptyStringType"/>
			<xsd:element name="CAP" type="capType"/>
			<xsd:element name="CAMERE_APPARTAMENTI" type="xsd:decimal"/>
			<xsd:element name="POSTI_LETTO" type="xsd:decimal"/>
			<xsd:element name="CODUL" type="xsd:string" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda6AttivitaAlberghieraType">
		<xsd:sequence>
			<!-- Se TIPO_ALBERGO = 'ALBERGO_DIFFUSO' allora valorizzare campi sezione 6.8 -->
			<!-- Se TIPO_ALBERGO = 'MOTEL' allora valorizzare campi SERVIZIO_AUTORIMESSA e SOMM_ALLOGGIATI -->
			<!-- Se TIPO_ALBERGO = 'ALTRO' allora valorizzare campo TIPO_ALTRO_DESCR -->
			<xsd:element name="TIPO_ALBERGO" type="albergoType"/>
			<xsd:element name="TIPO_ALTRO_DESCR" type="xsd:string" minOccurs="0"/>
			<xsd:element name="DENOMINAZIONE" type="muta:noEmptyStringType"/>
			<xsd:element name="NUMERO_STELLE" type="albergoStelleType"/>
			<xsd:element name="NUMERO_CAMERE" type="xsd:decimal"/>
			<xsd:element name="CAMERE_POSTI_LETTO" type="xsd:decimal"/>
			<xsd:element name="NUMERO_APPARTAMENTI" type="xsd:decimal"/>
			<xsd:element name="APPARTAMENTI_POSTI_LETTO" type="xsd:decimal"/>
			<xsd:element name="SERVIZIO_AUTORIMESSA" type="xsd:boolean" minOccurs="0"/>
			<xsd:element name="SOMM_ALLOGGIATI" type="xsd:boolean" minOccurs="0"/>
			<xsd:element name="DIPENDENZE" type="scheda6DipendenzaType" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda6AttivitaNoAlberghieraType">
		<xsd:sequence>
			<xsd:element name="TIPO_NOALBERGO" type="noAlbergoType"/>
			<xsd:element name="DENOMINAZIONE" type="muta:noEmptyStringType"/>
			<xsd:element name="CAMERE_APPARTAMENTI" type="xsd:decimal"/>
			<xsd:element name="POSTI_LETTO" type="xsd:decimal"/>
			<xsd:element name="CODUL" type="xsd:string" minOccurs="0"/>
			<xsd:choice minOccurs="0">
				<xsd:element name="SOMM_ALLOGGIATI" type="xsd:boolean"/>
				<xsd:element name="SOMM_PUBBLICO" type="xsd:boolean"/>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda6AttivitaAriaApertaType">
		<xsd:sequence>
			<xsd:element name="TIPO_ARIAAPERTA" type="ariaApertaType"/>
			<xsd:element name="DENOMINAZIONE" type="muta:noEmptyStringType"/>
			<xsd:element name="NUMERO_STELLE" type="ariaApertaStelleType"/>
			<xsd:element name="SOMM_ALLOGGIATI" type="xsd:boolean" default="false"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda6DipendenzaDiffusoType">
		<xsd:sequence>
			<xsd:element name="CAMERE_ALLOGGI" type="xsd:decimal"/>
			<xsd:element name="POSTI_LETTO" type="xsd:decimal"/>
			<xsd:element name="COMUNE" type="istatComuneType"/>
			<xsd:element name="PROV" type="istatProvinciaType"/>
			<xsd:element name="VIA" type="muta:noEmptyStringType"/>
			<xsd:element name="NUM" type="muta:noEmptyStringType"/>
			<xsd:element name="CAP" type="capType"/>
			<xsd:element name="CODUL" type="xsd:string" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda6Type">
		<xsd:sequence>
			<!-- Inizio sezione 6.1 -->
			<xsd:element name="ATTIVITA_ALBERGHIERA" type="scheda6AttivitaAlberghieraType" minOccurs="0"/>
			<!-- Fine sezione 6.1 -->
			<!-- Inizio sezione 6.2 -->
			<xsd:element name="ATTIVITA_NONALB" type="scheda6AttivitaNoAlberghieraType" minOccurs="0"/>
			<!-- Fine sezione 6.2 -->
			<!-- Inizio sezione 6.3 -->
			<xsd:element name="ATTIVITA_ARIAAPERTA" type="scheda6AttivitaAriaApertaType" minOccurs="0"/>
			<!-- Fine sezione 6.3 -->
			<!-- Inizio sezione 6.4 -->
			<xsd:element name="TRASFERIMENTO_SEDE" type="xsd:boolean" default="false"/>
			<!-- Se TRASFERIMENTO_SEDE = true allora valorizzare i campi TRASF_SEDE* -->
			<xsd:element name="TRASF_SEDE_COMUNE" type="istatComuneType" minOccurs="0"/>
			<xsd:element name="TRASF_SEDE_PROV" type="istatProvinciaType" minOccurs="0"/>
			<xsd:element name="TRASF_SEDE_VIA" type="muta:noEmptyStringType" minOccurs="0"/>
			<xsd:element name="TRASF_SEDE_NUM" type="muta:noEmptyStringType" minOccurs="0"/>
			<xsd:element name="TRASF_SEDE_CAP" type="capType" minOccurs="0"/>
			<xsd:element name="TRASFERIMENTO_DIPENDENZA" type="xsd:boolean" default="false"/>
			<!-- Se TRASFERIMENTO_DIPENDENZA = true allora valorizzare i campi TRASF_DIP* -->
			<xsd:element name="TRASF_DIP_COMUNE" type="istatComuneType" minOccurs="0"/>
			<xsd:element name="TRASF_DIP_PROV" type="istatProvinciaType" minOccurs="0"/>
			<xsd:element name="TRASF_DIP_VIA" type="muta:noEmptyStringType" minOccurs="0"/>
			<xsd:element name="TRASF_DIP_NUM" type="muta:noEmptyStringType" minOccurs="0"/>
			<xsd:element name="TRASF_DIP_CAP" type="capType" minOccurs="0"/>
			<!-- Fine sezione 6.4 -->
			<!-- Inizio sezione 6.5 -->
			<xsd:element name="VARIA_CLASSIFICAZIONE" type="xsd:boolean" default="false"/>
			<!-- Se VARIA_CLASSIFICAZIONE = true allora valorizzare NUMERO_STELLE -->
			<xsd:element name="NUMERO_STELLE" type="albergoStelleType" minOccurs="0"/>
			<!-- Fine sezione 6.5 -->
			<!-- Inizio sezione 6.6 -->
			<xsd:element name="VARIA_CAMERE_APP_LETTO" type="xsd:boolean" default="false"/>
			<!-- Se VARIA_CAMERE_APP_LETTO = true allora valorizzare a true uno dei seguenti campi: VARIA_CAMERE, VARIA_APPARTAMENTI o VARIA_POSTI_LETTO -->
			<xsd:choice minOccurs="0">
				<xsd:element name="VARIA_CAMERE" type="xsd:boolean"/>
				<xsd:element name="VARIA_APPARTAMENTI" type="xsd:boolean"/>
				<xsd:element name="VARIA_POSTI_LETTO" type="xsd:boolean"/>
			</xsd:choice>
			<!-- Se VARIA_CAMERE = true allora valorizzare i campi VARIA_CAMERE* -->
			<xsd:element name="VARIA_CAMERE_TIPO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<xsd:element name="VARIA_CAMERE_NUMERO" type="xsd:decimal" minOccurs="0"/>
			<!-- Se VARIA_APPARTAMENTI = true allora valorizzare i campi VARIA_APP* -->
			<xsd:element name="VARIA_APP_TIPO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<xsd:element name="VARIA_APP_NUMERO" type="xsd:decimal" minOccurs="0"/>
			<!-- Se VARIA_POSTI_LETTO = true allora valorizzare i campi VARIA_LETTO* -->
			<xsd:element name="VARIA_LETTO_TIPO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<xsd:element name="VARIA_LETTO_NUMERO" type="xsd:decimal" minOccurs="0"/>
			<!-- Fine sezione 6.6 -->
			<!-- Inizio sezione 6.7 -->
			<xsd:element name="VARIA_DIPENDENZE" type="xsd:boolean" default="false"/>
			<!-- Se VARIA_DIPENDENZE = true allora valorizzare a true uno dei seguenti campi: VARIA_DIP_CAMERE, VARIA_DIP_APP o VARIA_DIP_LETTO -->
			<xsd:choice minOccurs="0">
				<xsd:element name="VARIA_DIP_CAMERE" type="xsd:boolean"/>
				<xsd:element name="VARIA_DIP_APP" type="xsd:boolean"/>
				<xsd:element name="VARIA_DIP_LETTO" type="xsd:boolean"/>
			</xsd:choice>
			<!-- Se VARIA_DIP_CAMERE = true allora valorizzare i campi VARIA_DIP_CAMERE* -->
			<xsd:element name="VARIA_DIP_CAMERE_TIPO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<xsd:element name="VARIA_DIP_CAMERE_NUMERO" type="xsd:decimal" minOccurs="0"/>
			<!-- Se VARIA_DIP_APP = true allora valorizzare i campi VARIA_DIP_APP* -->
			<xsd:element name="VARIA_DIP_APP_TIPO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<xsd:element name="VARIA_DIP_APP_NUMERO" type="xsd:decimal" minOccurs="0"/>
			<!-- Se VARIA_DIP_LETTO = true allora valorizzare i campi VARIA_DIP_LETTO* -->
			<xsd:element name="VARIA_DIP_LETTO_TIPO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<xsd:element name="VARIA_DIP_LETTO_NUMERO" type="xsd:decimal" minOccurs="0"/>
			<!-- Fine sezione 6.7 -->
			<!-- Inizio sezione 6.8 -->
			<xsd:element name="ALBERGO_DIFFUSO" type="scheda6DipendenzaDiffusoType" minOccurs="0" maxOccurs="unbounded"/>
			<!-- Fine sezione 6.8 -->
			<!-- Inizio sezione 6.9 -->
			<xsd:element name="TRASFERIMENTO_DIFFUSO" type="xsd:boolean" default="false"/>
			<!-- Se TRASFERIMENTO_DIFFUSO = true allora valorizzare VARIA_ALBERGO_DIFFUSO -->
			<xsd:element name="VARIA_ALBERGO_DIFFUSO" type="scheda6DipendenzaDiffusoType" minOccurs="0" maxOccurs="unbounded"/>
			<!-- Fine sezione 6.9 -->
		</xsd:sequence>
	</xsd:complexType>
	<!-- Inizio DICHIARAZIONE AVVIO NUOVA/MODIFICA ATTIVITA' PRODUTTIVA -->
	<xsd:complexType name="sciaAvvioModificaAttivitaType">
		<xsd:sequence>
			<xsd:element name="ID_PRATICA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="PROTOCOLLO" type="muta:protocolloType" minOccurs="0"/>
			<xsd:element name="STATO_PRATICA" type="muta:statoPraticaType"/>
			<xsd:element name="MODELLO_A" type="modelloAType"/>
			<xsd:element name="SCHEDA_1" type="scheda1Type" minOccurs="0"/>
			<xsd:element name="SCHEDA_2" type="scheda2Type" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="SCHEDA_3" type="scheda3Type" minOccurs="0"/>
			<xsd:element name="SCHEDA_4" type="scheda4Type" minOccurs="0"/>
			<xsd:element name="SCHEDA_5" type="scheda5Type" minOccurs="0"/>
			<xsd:element name="SCHEDA_6" type="scheda6Type" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- Fine DICHIARAZIONE AVVIO NUOVA ATTIVITA -->
	<!-- Inizio DICHIARAZIONE SUBINGRESSO / CESSAZIONE / SOSPENSIONE E RIPRESA / CAMBIAMENTO RAGIONE SOCIALE DI ATTIVITA' PRODUTTIVA -->
	<xsd:complexType name="sciaSubCesSosRipCamAttivitaType">
		<xsd:sequence>
			<xsd:element name="ID_PRATICA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="PROTOCOLLO" type="muta:protocolloType" minOccurs="0"/>
			<xsd:element name="STATO_PRATICA" type="muta:statoPraticaType"/>
			<xsd:element name="MODELLO_B" type="modelloBType"/>
			<xsd:element name="SCHEDA_2" type="scheda2Type" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="SCHEDA_3" type="scheda3Type" minOccurs="0"/>
			<xsd:element name="SCHEDA_4" type="scheda4Type" minOccurs="0"/>
			<xsd:element name="SCHEDA_5" type="scheda5Type" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- Fine DICHIARAZIONE SUBINGRESSO / CESSAZIONE / SOSPENSIONE E RIPRESA / CAMBIAMENTO RAGIONE SOCIALE DI ATTIVITA' PRODUTTIVA -->
	<!-- Elementi ROOT -->
	<xsd:element name="sciaAvvioModificaAttivita" type="sciaAvvioModificaAttivitaType"/>
	<xsd:element name="sciaSubCesSosRipCamAttivita" type="sciaSubCesSosRipCamAttivitaType"/>
</xsd:schema>
