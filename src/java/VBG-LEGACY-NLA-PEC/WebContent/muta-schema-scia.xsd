			<xsd:choice minOccurs="0">
				<xsd:element name="ACCONCIA_TITOLARE" type="xsd:boolean"/>
				<xsd:element name="ACCONCIA_SOCIO" type="xsd:boolean"/>
				<xsd:element name="ACCONCIA_FAM_COL_DIP" type="xsd:boolean"/>
