			<xsd:element name="TATUPEAR_ANAGRAFICA" type="scheda3AnagraficaType" minOccurs="0"/>
			<xsd:element name="TATUPEAR_QUALIFICA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="TATUPEAR_QUALIFICA_DATA" type="xsd:date" minOccurs="0"/>
