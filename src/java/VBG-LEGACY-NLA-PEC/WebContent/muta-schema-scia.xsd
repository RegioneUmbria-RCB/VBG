			<xsd:choice minOccurs="0">
				<xsd:element name="TATUPEAR_TITOLARE" type="xsd:boolean"/>
				<xsd:element name="TATUPEAR_SOCIO" type="xsd:boolean"/>
				<xsd:element name="TATUPEAR_FAM_COL_DIP" type="xsd:boolean"/>
