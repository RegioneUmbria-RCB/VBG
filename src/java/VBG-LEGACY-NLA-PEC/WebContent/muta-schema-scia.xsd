			<xsd:element name="VARIA_SUP_ALIMENTARE" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<!-- Se VARIA_SUP_ALIMENTARE è valorizzato allora valorizzare VARIA_SUP_ALIMENTARE_ENTITA -->
			<xsd:element name="VARIA_SUP_ALIMENTARE_ENTITA" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="VARIA_SUP_NONALIMENTARE" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<!-- Se VARIA_SUP_NONALIMENTARE è valorizzato allora valorizzare VARIA_SUP_NONALIMENTARE_ENTITA -->
			<xsd:element name="VARIA_SUP_NONALIMENTARE_ENTITA" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="VARIA_SUP_MONOPOLIO" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<!-- Se VARIA_SUP_MONOPOLIO è valorizzato allora valorizzare VARIA_SUP_MONOPOLIO_ENTITA -->
			<xsd:element name="VARIA_SUP_MONOPOLIO_ENTITA" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="VARIA_SUP_FARMACIE" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<!-- Se VARIA_SUP_FARMACIE è valorizzato allora valorizzare VARIA_SUP_FARMACIE_ENTITA -->
			<xsd:element name="VARIA_SUP_FARMACIE_ENTITA" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="VARIA_SUP_CARBURANTI" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<!-- Se VARIA_SUP_CARBURANTI è valorizzato allora valorizzare VARIA_SUP_CARBURANTI_ENTITA -->
			<xsd:element name="VARIA_SUP_CARBURANTI_ENTITA" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="VARIA_SUP_SOMM" type="variazioneAumentoDiminuzioneType" minOccurs="0"/>
			<!-- Se VARIA_SUP_SOMM è valorizzato allora valorizzare VARIA_SUP_SOMM_ENTITA -->
			<xsd:element name="VARIA_SUP_SOMM_ENTITA" type="xsd:decimal" minOccurs="0"/>
			<!-- Fine sezione 1.9 -->
			<!-- Inizio sezione 1.10 -->
			<xsd:element name="VARIA_MERCE" type="xsd:boolean" default="false"/>
			<xsd:element name="VARIA_MERCE_ALIMENTARE" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<xsd:element name="VARIA_MERCE_NONALIMENTARE" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<xsd:element name="VARIA_MERCE_MONOPOLIO" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<xsd:element name="VARIA_MERCE_FARMACIE" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<xsd:element name="VARIA_MERCE_CARBURANTI" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<xsd:element name="VARIA_MERCE_SOMM" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<!-- Fine sezione 1.10 -->
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda1FormeSpecialiVenditaAvvioType">
		<xsd:sequence>
			<!-- Inizio sezione 1.11 -->
			<!-- Scelte multiple, almeno 1 obbligatoria -->
			<xsd:element name="TIPO_ATTIVITA_CORRISP" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO_ATTIVITA_TV" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO_ATTIVITA_COMMELE" type="xsd:boolean" default="false"/>
			<xsd:element name="TIPO_ATTIVITA_ALTRO" type="xsd:boolean" default="false"/>
			<!-- Se TIPO_ATTIVITA_ALTRO = true allora valorizzare DESCRIZIONE_ALTRO -->
			<xsd:element name="DESCRIZIONE_ALTRO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="DOMICILIO_CONSUMATORE" type="xsd:boolean" default="false"/>
			<!-- Fine sezione 1.11 -->
			<!-- Inizio sezione 1.12 -->
			<xsd:choice>
				<xsd:element name="INSIEMEAA_LOCALI" type="xsd:boolean"/>
				<xsd:element name="INSIEMEAA_LOCALI_SEPARATI" type="xsd:boolean"/>
				<xsd:element name="INSIEMEAA_NO" type="xsd:boolean"/>
			</xsd:choice>
			<xsd:element name="AA_COD_ATECO" type="codiceAteco3CType" minOccurs="0"/>
			<xsd:choice>
				<xsd:element name="DEPOSITO_MERCI_PROPRIO" type="xsd:boolean"/>
				<xsd:element name="DEPOSITO_MERCI_TERZI" type="xsd:boolean"/>
			</xsd:choice>
			<xsd:element name="DEPOSITO_MERCI_INDIRIZZO" type="muta:noEmptyStringType"/>
			<!-- Obbligatorio sel nel riquadro 1.11 è selezionato "Commercio elettronico" -->
			<xsd:element name="COMMELE_WWW_INDIVIDUALE" type="xsd:string" minOccurs="0"/>
			<xsd:element name="COMMELE_WWW_COLLETTIVO" type="xsd:string" minOccurs="0"/>
			<!-- -->
			<xsd:element name="COMMERCIO_DOMICILIO_INCARICATI" type="xsd:boolean" default="false"/>
			<!-- Fine sezione 1.12 -->
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda1FormeSpecialiVenditaVariazioniType">
		<xsd:sequence>
			<!-- Inizio sezione 1.13 -->
			<xsd:element name="VARIA_TRASF_SEDE" type="xsd:boolean" default="false"/>
			<xsd:element name="VARIA_MANTIENE_CARATT" type="xsd:boolean" default="false"/>
			<!-- Fine sezione 1.13 -->
			<!-- Inizio sezione 1.14 -->
			<!-- NB: se selezionata opzione "aggiunto" per tipo "alimentare", è OBBLIGATORIA LA COMPILAZIONE DELLA SCHEDA 2 (necessario scegliere tra 1 dei punti dal 3.1 al 3.4) -->
			<xsd:element name="VARIA_MERCE" type="xsd:boolean" default="false"/>
			<!-- Se VARIA_MERCE = true allora valorizzare almeno uno dei due campi VARIA_MERCE* -->
			<xsd:element name="VARIA_MERCE_ALIMENTARE" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<xsd:element name="VARIA_MERCE_NONALIMENTARE" type="variazioneAggiuntaEliminaType" minOccurs="0"/>
			<!-- Fine sezione 1.14 -->
			<!-- Inizio sezione 1.15 -->
			<xsd:element name="VARIA_WWW" type="xsd:boolean" default="false"/>
			<!-- Se VARIA_WWW = true allora valorizzare almeno uno dei due campi VARIA_WWW* -->
			<xsd:element name="VARIA_WWW_INDIVIDUALE" type="xsd:string" minOccurs="0"/>
			<xsd:element name="VARIA_WWW_COLLETTIVO" type="xsd:string" minOccurs="0"/>
			<!-- Fine sezione 1.15 -->
			<!-- Inizio sezione 1.16 -->
			<xsd:element name="VARIA_COMM_DOMICILIO_INCARICATI" type="xsd:boolean" default="false"/>
			<!-- Fine sezione 1.16 -->
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda1Type">
		<xsd:sequence>
			<!-- Inizio sezione 1.1 -->
			<!-- L'indicazione delle superfici ALIMENTARI è obbligatoria solo se nel modello A vengono scelti i campi 2.3.1. ; 2.3.2. ;  2.3.4. -->
			<xsd:element name="SUPERF_ALIM" type="xsd:boolean" default="false"/>
			<xsd:element name="NUM_SUPERF_ALIM" type="xsd:decimal" minOccurs="0"/>
			<!-- L'indicazione delle superfici NON ALIMENTARI è obbligatoria solo se nel modello A vengono scelti i campi 1.5.1. ; 1.5.2. ; 1.5.4. -->
			<xsd:element name="SUPERF_NONALIM" type="xsd:boolean" default="false"/>
			<xsd:element name="NUM_SUPERF_NONALIM" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="SPEC_MONOP" type="xsd:boolean" default="false"/>
			<xsd:element name="NUM_SPEC_MONOP" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="SPEC_FARM" type="xsd:boolean" default="false"/>
			<xsd:element name="NUM_SPEC_FARM" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="SPEC_CARB" type="xsd:boolean" default="false"/>
			<xsd:element name="NUM_SPEC_CARB" type="xsd:decimal" minOccurs="0"/>
			<!-- Per SUPERFICIE SOMMINISTRAZIONE e SUPERFICIE INTRATTENIMENTO E SVAGO è obbligatorio indicare le superfici (uno o entrambe) nel caso si scelgano nel modello A le opzioni 2.2.3 ; 2.2.5 ; 2.2.7 ; 2.2.8. ; 2.2.9. ; 2.2.10 ; 2.2.11. -->
			<xsd:element name="SUP_DI_SOMM" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="SUP_DI_SVAGO" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="SUP_ALTRO" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="DESCRIZIONE_SUP_ALTRO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SUP_ACCESSORIE" type="xsd:decimal" minOccurs="0"/>
			<xsd:element name="CALCOLO_CONVENZ" type="xsd:boolean" default="false"/>
			<!-- Fine sezione 1.1 -->
			<!-- Inizio sezione 1.2 -->
			<xsd:element name="ALTRO_ATECO" type="xsd:boolean" default="false"/>
			<!-- Se ALTRO_ATECO = true allora deve essere valorizzato almeno una delle 3 coppie DESC_ATECO*/TRECIFRE_ATECO* -->
			<xsd:element name="DESC_ATECO_1" type="xsd:string" minOccurs="0"/>
			<xsd:element name="TRECIFRE_ATECO_1" type="codiceAteco3CType" minOccurs="0"/>
			<xsd:element name="DESC_ATECO_2" type="xsd:string" minOccurs="0"/>
			<xsd:element name="TRECIFRE_ATECO_2" type="codiceAteco3CType" minOccurs="0"/>
			<xsd:element name="DESC_ATECO_3" type="xsd:string" minOccurs="0"/>
			<xsd:element name="TRECIFRE_ATECO_3" type="codiceAteco3CType" minOccurs="0"/>
			<!-- Fine sezione 1.2 -->
			<!-- Inizio sezione 1.3 -->
			<xsd:element name="ATT_NEL_DOMICILIO_SN" type="xsd:boolean" default="false"/>
			<!-- Fine sezione 1.3 -->
			<xsd:element name="VARIAZIONI" type="scheda1VariazioniType" minOccurs="0"/>
			<xsd:element name="FORME_SPECIALI_VENDITA_AVVIO" type="scheda1FormeSpecialiVenditaAvvioType" minOccurs="0"/>
			<xsd:element name="FORME_SPECIALI_VENDITA_VARIA" type="scheda1FormeSpecialiVenditaVariazioniType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda2Type">
		<xsd:annotation>
			<xsd:documentation xml:lang="it">
					29/04/2011 - Aggiornati COMM_CORSO, SOMM_DIPLOMA, SOMM_PRESTATO e ISCRITTO_REC, non sono più esclusivi in choice
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="COGNOME" type="muta:noEmptyStringType"/>
			<xsd:element name="NOME" type="muta:noEmptyStringType"/>
			<xsd:element name="CODICE_FISCALE" type="codiceFiscaleType"/>
			<xsd:element name="DATA_DI_NASCITA" type="xsd:date"/>
			<xsd:element name="CITTADINANZA" type="statoType"/>
			<xsd:element name="S2_SESSO" type="sessoType"/>
			<xsd:element name="STATO_DI_NASCITA" type="statoType"/>
			<!-- Se STATO_DI_NASCITA = 'I' allora valorizzare COMUNE_DI_NASCITA e PROVINCIA_DI_NASCITA -->
			<xsd:element name="COMUNE_DI_NASCITA" type="istatComuneType" minOccurs="0"/>
			<xsd:element name="PROVINCIA_DI_NASCITA" type="istatProvinciaType" minOccurs="0"/>
			<xsd:element name="LUOGO_RESIDENZA_STATO" type="statoType"/>
			<!-- Se LUOGO_RESIDENZA_STATO = 'I' allora valorizzare COMUNE_DI_RESIDENZA e PROV_DI_RESIDENZA -->
			<xsd:element name="COMUNE_DI_RESIDENZA" type="istatComuneType" minOccurs="0"/>
			<xsd:element name="PROV_DI_RESIDENZA" type="istatProvinciaType" minOccurs="0"/>
			<xsd:element name="RESIDENZA_VIA" type="muta:noEmptyStringType"/>
			<xsd:element name="RESIDENZA_NUM" type="muta:noEmptyStringType"/>
			<xsd:element name="RESIDENZA_CAP" type="capType"/>
			<xsd:choice>
				<xsd:element name="TITOLARE" type="xsd:boolean"/>
				<xsd:element name="SOCIO" type="xsd:boolean"/>
				<xsd:element name="MEMBRO" type="xsd:boolean"/>
				<xsd:element name="LEGALE" type="xsd:boolean"/>
				<!-- se LEGALE = true allora ovalorizzare LEGALE_NOME_SOCIETA -->
				<xsd:element name="DELEGATO" type="xsd:boolean"/>
				<!-- se DELEGATO = true allora valorizzare DELEGATO_NOME_SOCIETA e DELEGATO_IN_DATA -->
			</xsd:choice>
			<xsd:element name="LEGALE_NOME_SOCIETA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="DELEGATO_NOME_SOCIETA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="DELEGATO_IN_DATA" type="xsd:date" minOccurs="0"/>
			<!-- -->
			<!-- se COMM_CORSO = true allora valorizzare COMM_REGIONE, COMM_NOMEISTITUTO, COMM_SEDE, COMM_TIPO e COMM_DATAFINE -->
			<xsd:element name="COMM_CORSO" type="xsd:boolean" default="false"/>
			<xsd:element name="COMM_REGIONE" type="xsd:string" minOccurs="0"/>
			<xsd:element name="COMM_NOMEISTITUTO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="COMM_SEDE" type="xsd:string" minOccurs="0"/>
			<xsd:element name="COMM_TIPO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="COMM_DATAFINE" type="xsd:gYear" minOccurs="0"/>
			<!-- se SOMM_DIPLOMA = true allora valorizzare SOM_DIPLOMA_TITOLO, SOM_DIPLOMA_NOMEIST, SOM_DIPLOMA_SEDE, SOM_DIPLOMA_TIPO e SOM_DIPLOMA_DATAFINE -->
			<xsd:element name="SOMM_DIPLOMA" type="xsd:boolean" default="false"/>
			<xsd:element name="SOM_DIPLOMA_TITOLO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SOM_DIPLOMA_NOMEIST" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SOM_DIPLOMA_SEDE" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SOM_DIPLOMA_TIPO" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SOM_DIPLOMA_DATAFINE" type="xsd:gYear" minOccurs="0"/>
			<!-- se SOMM_PRESTATO = true allora devono valorizzare i campi SOM_PREST* -->
			<xsd:element name="SOMM_PRESTATO" type="xsd:boolean" default="false"/>
			<xsd:choice minOccurs="0">
				<xsd:element name="SOM_PREST_INPROPRIO" type="xsd:boolean"/>
				<xsd:element name="SOM_PREST_SOCIOLAV" type="xsd:boolean"/>
				<xsd:element name="SOM_PREST_DIPENDENTE" type="xsd:boolean"/>
				<xsd:element name="SOM_PREST_COADIUTORE" type="xsd:boolean"/>
			</xsd:choice>
			<xsd:element name="SOM_PREST_INPS" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SOM_PREST_INPS_DEL" type="xsd:date" minOccurs="0"/>
			<xsd:element name="SOM_PREST_NOMEIMP" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SOM_PREST_SEDEIMP" type="xsd:string" minOccurs="0"/>
			<!-- se ISCRITTO_REC = true allora valorizzare ISCRITTO_REC_CCIAA, ISCRITTO_REC_NUM e ISCRITTO_REC_DATA -->
			<xsd:element name="ISCRITTO_REC" type="xsd:boolean" default="false"/>
			<xsd:element name="ISCRITTO_REC_CCIAA" type="xsd:string" minOccurs="0"/>
			<xsd:element name="ISCRITTO_REC_NUM" type="xsd:string" minOccurs="0"/>
			<xsd:element name="ISCRITTO_REC_DATA" type="xsd:date" minOccurs="0"/>
			<!-- Fine sezione dichiara -->
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda3AnagraficaType">
		<xsd:sequence>
			<xsd:element name="COGNOME" type="muta:noEmptyStringType"/>
			<xsd:element name="NOME" type="muta:noEmptyStringType"/>
			<xsd:element name="CODICE_FISCALE" type="codiceFiscaleType"/>
			<xsd:element name="DATA_DI_NASCITA" type="xsd:date"/>
			<xsd:element name="CITTADINANZA" type="statoType"/>
			<xsd:element name="SESSO" type="sessoType"/>
			<xsd:element name="STATO_DI_NASCITA" type="statoType"/>
			<!-- Se STATO_DI_NASCITA = 'I' allora valorizzare COMUNE_DI_NASCITA e PROVINCIA_DI_NASCITA -->
			<xsd:element name="COMUNE_DI_NASCITA" type="istatComuneType" minOccurs="0"/>
			<xsd:element name="PROVINCIA_DI_NASCITA" type="istatProvinciaType" minOccurs="0"/>
			<xsd:element name="COMUNE_DI_RESIDENZA" type="istatComuneType"/>
			<xsd:element name="PROV_DI_RESIDENZA" type="istatProvinciaType"/>
			<xsd:element name="RESIDENZA_VIA" type="muta:noEmptyStringType"/>
			<xsd:element name="RESIDENZA_NUM" type="muta:noEmptyStringType"/>
			<xsd:element name="RESIDENZA_CAP" type="capType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="scheda3Type">
		<xsd:sequence>
			<xsd:element name="ACCONCIATORE" type="xsd:boolean" default="false"/>
