	<bean id="nlaPort" class="it.init.sigepro.rte.definitions.NlaSoap11Impl" />
	
	<context:component-scan base-package="it"/>
	
	<jaxws:endpoint xmlns:tns="http://sigepro.init.it/rte/definitions"
		id="nla" implementor="#nlaPort"
		wsdlLocation="wsdl/Nla.wsdl" endpointName="tns:NlaSoap11" serviceName="tns:NlaService"
		address="/NlaSoap11">
		<jaxws:features>
			<bean class="org.apache.cxf.feature.LoggingFeature" />
		</jaxws:features>
	</jaxws:endpoint>
	
	<bean id="pddEntePort" class="it.gov.impresainungiorno.suap.scrivania.ente.PddPortEnteImpl" />
	
	<jaxws:endpoint xmlns:tns="http://www.impresainungiorno.gov.it/suap/scrivania"
		id="pddente" implementor="#pddEntePort"
		wsdlLocation="wsdl/PddServiceEnte.wsdl" endpointName="tns:PddPortEnte" serviceName="tns:PddServiceEnte"
		address="/PddPortEnte">
		<jaxws:features>
			<bean class="org.apache.cxf.feature.LoggingFeature" />
		</jaxws:features>
	</jaxws:endpoint>
	
	
	
	
	<bean id="logInbound" class="org.apache.cxf.interceptor.LoggingInInterceptor">
		<property name="prettyLogging" value="false" />
		<property name="limit" value="10240" />
	</bean>
	<bean id="logOutbound" class="org.apache.cxf.interceptor.LoggingOutInterceptor">
		<property name="prettyLogging" value="false" />
		<property name="limit" value="10240" />
	</bean>
	<bean id="cxf" class="org.apache.cxf.bus.spring.SpringBus">
		<property name="inInterceptors">
			<list>
				<ref bean="logInbound" />
			</list>
		</property>
		<property name="outInterceptors">
			<list>
				<ref bean="logOutbound" />
			</list>
		</property>
		<property name="outFaultInterceptors">
			<list>
				<ref bean="logOutbound" />
			</list>
		</property>
		<property name="inFaultInterceptors">
			<list>
				<ref bean="logInbound" />
			</list>
		</property>
	</bean>
	
</beans>
