		</sequence>
	</complexType>
	<complexType name="RiferimentoCatastaleType">
		<sequence>
			<element name="tipoCatasto">
				<simpleType>
					<restriction base="string">
						<enumeration value="Terreni"></enumeration>
						<enumeration value="Edilizio Urbano"></enumeration>
					</restriction>
				</simpleType>
			</element>
			<element name="foglio" type="string"></element>
			<element name="particella" type="string"></element>
			<element name="sub" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="sezione" type="string" minOccurs="0" maxOccurs="1"/>
			<element name="unitaImobiliare" type="string" minOccurs="0" maxOccurs="1"/>		
		</sequence>
	</complexType>
	<complexType name="RiferimentiPraticaType">
		<sequence>
			<element name="idPratica" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="numeroPratica" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="dataPratica" type="date" maxOccurs="1" minOccurs="0"></element>
			<element name="oraDataPratica" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<pattern value="[0-2][0-9]:[0-5][0-9]"></pattern>
					</restriction>
				</simpleType>
			</element>
			<element name="numeroProtocolloGenerale" type="string" minOccurs="0">
				<annotation>
					<documentation> Va indicato il numero di protocollo della pratica
						solo in caso di integrazione
						con il protocollo generale (non va
						specificato nulla se il protocollo e' di
						settore/direzione).
					</documentation>
				</annotation>
			</element>
			<element name="dataProtocolloGenerale" type="date" minOccurs="0"></element>
			<element name="altriDati" type="tns:ParametroType" minOccurs="0" maxOccurs="unbounded"></element>
		</sequence>
	</complexType>
	<complexType name="DettaglioPraticaType">
		<sequence>
			<element name="idPratica" type="string">
				<annotation>
					<documentation>
						E' l'identificativo univoco della pratica
						all'interno del backoffice mittente.
					</documentation>
				</annotation>
			</element>
			<element name="numeroPratica" type="string">
				<annotation>
					<documentation>
						E' il numero della pratica leggibile dagli
						operatori.
					</documentation>
				</annotation>
			</element>
			<element name="codicePraticaTelematica" type="string" minOccurs="0" maxOccurs="1" />
			<element name="dataPratica" type="date"></element>
			<element name="oraDataPratica" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<pattern value="[0-2][0-9]:[0-5][0-9]"></pattern>
					</restriction>
				</simpleType>
			</element>
			<element name="numeroProtocolloGenerale" type="string"
				minOccurs="0">
				<annotation>
					<documentation>
						Va indicato il numero di protocollo della
						pratica solo in caso di integrazione con il
						protocollo generale (non va specificato nulla se
						il protocollo e' di settore/direzione).
					</documentation>
				</annotation>
			</element>
			<element name="dataProtocolloGenerale" type="date"
				minOccurs="0">
			</element>
			<element name="codiceComune" type="tns:ComuneType"
				minOccurs="0" maxOccurs="1" />
			<element name="codiceAccreditamentoSUAP" type="string" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>
						Va indicato il codice di accreditamento suap configurato nel portale impresainungiorno. Usato in caso di software Sportello unico.
					</documentation>
				</annotation>
			</element>
			<element name="domicilioElettronico" type="string"
				minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>
						E' il domicilio elettronico di riferimento
						(tipicamente PEC) per ricevere comunicazioni in
						merito alla pratica da parte dei
						richiedenti/professionisti.
					</documentation>
				</annotation>
			</element>
			<element name="richiedente" type="tns:RichiedenteType" minOccurs="0">
				<annotation>
					<documentation>
						Il richiedente e' colui che presenta la domanda.
					</documentation>
				</annotation>
			</element>
			<element name="aziendaRichiedente"
				type="tns:PersonaGiuridicaType" minOccurs="0" maxOccurs="1">
			</element>
			<element name="procure" type="tns:ProcuraType" minOccurs="0"
				maxOccurs="unbounded" />
			<element name="intermediario" type="tns:AnagrafeType"
				minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>
						E' il tecnico esterno o l'associazione che
						presenta la domanda per conto del richiedente.
					</documentation>
				</annotation>
			</element>
			<element name="altriSoggetti" type="tns:AltriSoggettiType"
				minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>
						Eventuale lista di soggetti collegati alla
						pratica: soci, curatori fallimentari o in caso
						di edilizia direttore lavori o responsabile
						della sicurezza.
					</documentation>
				</annotation>
			</element>
			<element name="oggetto" type="string">
				<annotation>
					<documentation>
						E' necessario descrivere bene l'oggetto che
						rappresenta la pratica.
					</documentation>
				</annotation>
			</element>
			<element name="insegna" type="string" minOccurs="0" maxOccurs="1"/>
			<element name="intervento" type="tns:InterventoType"
				minOccurs="0">
				<annotation>
					<documentation>
						E' l'intervento codificato che i due backoffice
						mittente e destinatario decidono di comunicarsi,
						specifica la codifica del tipo di pratica.
					</documentation>
				</annotation>
			</element>
			<element name="localizzazione"
				type="tns:LocalizzazioneNelComuneType" minOccurs="0"
				maxOccurs="unbounded">
				<annotation>
					<documentation>
						Indica la localizzazione dell'intervento. Si
						potrebbero aggiungere anche i dati catastali.
					</documentation>
				</annotation>
			</element>
			<element name="documenti" type="tns:DocumentiType"
				minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>
						E' la lista dei documenti a corredo della
						pratica. Domanda, dichiarazioni e comunicazioni
						per il richiedente.
					</documentation>
				</annotation>
			</element>
			<element name="altriDati" type="tns:ParametroType"
				minOccurs="0" maxOccurs="unbounded">
			</element>
			<element name="procedimenti" type="tns:ProcedimentoType"
				minOccurs="0" maxOccurs="unbounded">
			</element>
			<element name="schede" type="tns:SchedaType" minOccurs="0"
				maxOccurs="unbounded">
			</element>
			<element name="oneri" type="tns:OneriType"
				maxOccurs="unbounded" minOccurs="0">
			</element>
			<element name="annotazioni" type="string" 
				minOccurs="0">
				<annotation>
					<documentation>Eventuali informazioni aggiuntive o note sulla pratica.</documentation>
				</annotation></element>
		</sequence>
	</complexType>
