			<element name="fax" type="string" minOccurs="0"></element>
			<element name="iscrizioneCCIAA" type="tns:IscrizioneRegistroType" minOccurs="0" />
			<element name="iscrizioneREA" type="tns:RegistroREAType" minOccurs="0" />
			<element name="legaleRappresentante" type="tns:PersonaFisicaType" minOccurs="0" maxOccurs="1"></element>
			<element name="altriDati" type="tns:ParametroType" minOccurs="0" maxOccurs="unbounded"></element>
			<element name="email" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="pec" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="telefonoCellulare" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="datiInps" type="tns:DatiInpsType" maxOccurs="1" minOccurs="0"></element>
