<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://sigepro.init.it/rte/types" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://sigepro.init.it/rte/types" xmlns:xmime="http://www.w3.org/2005/05/xmlmime">
	<simpleType name="XsdTypesVersion">
		<restriction base="string">
			<enumeration value="V_1_0" />
			<enumeration value="V_1_1" />
			<enumeration value="V_1_2" />
			<enumeration value="V_1_3" />
			<enumeration value="V_1_4" />
			<enumeration value="V_1_5" />
			<enumeration value="V_1_6" />
			<enumeration value="V_1_7" />
			<enumeration value="V_1_8" />
			<enumeration value="V_1_9" />
			<enumeration value="V_1_10" />
			<enumeration value="V_1_11" />
		</restriction>
	</simpleType>
	<complexType name="DettaglioAttivitaType">
		<sequence>
			<element name="idPratica" type="string"></element>
			<element name="idAttivita" type="string"></element>
			<element name="dataAttivita" type="date" minOccurs="0" maxOccurs="1"></element>
			<element name="oraDataAttivita" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<pattern value="[0-2][0-9]:[0-5][0-9]"></pattern>
					</restriction>
				</simpleType>
			</element>
			<element name="dataScadenza" type="date" minOccurs="0" maxOccurs="1"></element>
			<element name="numeroProtocolloGenerale" type="string" minOccurs="0">
				<annotation>
					<documentation> E' il protocollo generale riferito all'attivita'
					</documentation>
				</annotation>
			</element>
			<element name="dataProtocolloGenerale" type="date" minOccurs="0"></element>
			<element name="tipoAttivita" type="tns:TipoAttivitaType">
				<annotation>
					<documentation> Indicare l'attivita' da notificare Es. 'Richiesta
						di parere' o 'Comunicazione parere'
					</documentation>
				</annotation>
			</element>
			<element name="esito" type="boolean">
				<annotation>
					<documentation> Indica se l'attivita' ha avuto un esito positivo o
						meno Es. 'Invio parere' o 'Rilascio atto/autorizzazione'. Nelle
						attivita' che non prevedono esito indicare sempre true.
						Es. 'Comunicazione atti'
					</documentation>
				</annotation>
			</element>
			<element name="parere" type="string" minOccurs="0">
				<annotation>
					<documentation> E' il parere nel caso di notifica attivita'
						'Comunicazione parere'.
					</documentation>
				</annotation>
			</element>
			<element name="note" type="string" minOccurs="0"></element>
			<element name="altriDati" type="tns:ParametroType" minOccurs="0" maxOccurs="unbounded">
			</element>
			<element name="documenti" type="tns:DocumentiType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation> E' la lista dei documenti allegati all'attivita'
					</documentation>
				</annotation>
			</element>
			<element name="procedimenti" type="tns:ProcedimentoType" minOccurs="0" maxOccurs="unbounded"></element>
			<element name="documentiDaSostituire" type="tns:SostituzioniDocumentaliType" minOccurs="0" maxOccurs="unbounded"></element>
		</sequence>
	</complexType>
	<complexType name="TipoAttivitaType">
		<sequence minOccurs="1">
			<element name="codice" type="string"></element>
			<element name="descrizione" type="string"></element>
		</sequence>
	</complexType>
	<complexType name="RiferimentiAttivitaType">
		<sequence>
			<element name="idPratica" type="string"></element>
			<element name="idProcedimento" type="string" minOccurs="0"></element>
			<element name="idAttivita" type="string"></element>
			<element name="numeroProtocolloGenerale" type="string" minOccurs="0">
				<annotation>
					<documentation> Va indicato solo se si tratta di protocollo
						generale e non di
						settore/direzione.
					</documentation>
				</annotation>
			</element>
			<element name="dataProtocolloGenerale" type="date" minOccurs="0"></element>
			<element name="altriDati" type="tns:ParametroType" minOccurs="0" maxOccurs="unbounded"></element>
		</sequence>
	</complexType>
	<complexType name="AltriSoggettiType">
		<sequence>
			<element name="tipoRapporto" type="tns:RuoloType"></element>
			<element name="soggetto" type="tns:AnagrafeType"></element>
			<element name="anagraficaCollegata" type="tns:AnagrafeType" minOccurs="0" maxOccurs="1" />
		</sequence>
	</complexType>
	<complexType name="AnagrafeType">
		<choice minOccurs="1">
			<element name="personaFisica" type="tns:PersonaFisicaType"></element>
			<element name="personaGiuridica" type="tns:PersonaGiuridicaType"></element>
		</choice>
	</complexType>
	<complexType name="ComuneType">
		<annotation>
			<documentation> Sara' possibile decodificare il comune attraverso
				l'indicazione del
				CodiceCatastale (Es.D612), del CodiceIstat (Es.
				048017) o del nome del comune (Es.
				Firenze)
			</documentation>
		</annotation>
		<choice minOccurs="1">
			<element name="codiceCatastale" type="string"></element>
			<element name="codiceIstat" type="string"></element>
			<element name="comune" type="string"></element>
		</choice>
	</complexType>
	<complexType name="InterventoType">
		<sequence>
			<element name="codice" type="string" minOccurs="0"></element>
			<element name="descrizione" type="string"></element>
		</sequence>
	</complexType>
	<complexType name="IscrizioneRegistroType">
		<sequence minOccurs="1">
			<element name="numero" type="string" maxOccurs="1" minOccurs="1"></element>
			<element name="data" type="date" maxOccurs="1" minOccurs="1"></element>
			<element name="comune" type="tns:ComuneType" maxOccurs="1" minOccurs="1"></element>
		</sequence>
	</complexType>
	<complexType name="LocalizzazioneNelComuneType">
		<sequence>
			<element name="id" type="string"></element>
			<element name="codiceViario" type="string"></element>
			<element name="denominazione" type="string"></element>
			<element name="civico" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="esponente" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="colore" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="scala" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="interno" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="esponenteInterno" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="piano" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="fabbricato" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="km" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="frazione" type="tns:FrazioneType" maxOccurs="1" minOccurs="0"></element>
			<element name="circoscrizione" type="tns:CircoscrizioneType" maxOccurs="1" minOccurs="0"></element>
			<element name="quartiere" type="tns:QuartiereType" maxOccurs="1" minOccurs="0"></element>
			<element name="riferimentoCatastale" type="tns:RiferimentoCatastaleType" maxOccurs="unbounded" minOccurs="0"></element>
			<element name="coordinate" type="tns:CoordinateType" maxOccurs="1" minOccurs="0"></element>
			<element name="tipo" type="tns:TipoLocalizzazioneType" maxOccurs="1" minOccurs="0"></element>
			<element name="uuid" type="string" maxOccurs="1" minOccurs="0"></element>
