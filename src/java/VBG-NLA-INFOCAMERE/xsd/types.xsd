					<documentation>
						Le informazioni dell'indirizzo dove inviare le comunicazioni. La sezione viene di solito compilata se diversa dalla sezione
						resid
					</documentation>
				</annotation>
			</element>
			<element name="cittadinanza" type="tns:CittadinanzaType" maxOccurs="1" minOccurs="0"></element>
			<element name="altriDati" type="tns:ParametroType" minOccurs="0" maxOccurs="unbounded"></element>
			<element name="procura" type="tns:DocumentiType" minOccurs="0" maxOccurs="1" />
			<element name="telefono" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="email" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="pec" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="telefonoCellulare" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="datiIscrizioneAlbo" type="tns:DatiIscrizioneAlboType" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
