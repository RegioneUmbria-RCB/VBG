<decorators defaultDir="/WEB-INF/jsp/decorators">
	<decorator name="fullScreen" page="fullscreen.jsp">
    	<pattern>/cart/*</pattern>
    	<pattern>/cart*/*</pattern>
    </decorator>
    <decorator name="areariservataMS" page="areariservataMS.jsp">
		<pattern>/*</pattern>
	</decorator>
	<decorator name="default" page="default.jsp">
		<pattern>/*</pattern>
	</decorator>
	<decorator name="nuovaistanza" page="default_nuovaistanza.jsp">
		<pattern>/nuovaistanza*</pattern>
	</decorator>
	<decorator name="nuovaistanza_completata" page="default_nuovaistanza_completata.jsp">
		<pattern>/nuovaistanza/domandaCompletata*</pattern>
	</decorator>
	<decorator name="empty" page="blank.jsp">
		<pattern>/home/registrazione.htm*</pattern>
		<pattern>/appmobile/appbootstrap.htm*</pattern>
	</decorator>
	<decorator name="popup" page="popup.jsp">
		<pattern>/nuovaistanza/infoAllegato.htm*</pattern>
	</decorator>
	<excludes>         
        <pattern>/css/*</pattern>
        <pattern>/js/*</pattern>
        <pattern>/images/*</pattern>
        <pattern>/ajax*</pattern>
        <pattern>/*/ajax*</pattern>
        <pattern>/applets*</pattern>
        <pattern>/json*</pattern>
        <pattern>/*/json*</pattern>
        <pattern>/public_json*</pattern>
    </excludes>
</decorators>