@if (!String.IsNullOrEmpty(Text))
{
    <div class="float-end">
        <button class="text-decoration-none ms-2" data-focus-mouse="false" @onclick="OnClick">
            <span class="t-primary">@Text</span>
        </button>
    </div>
}


@code {
    [Parameter, EditorRequired]
    public EventCallback OnClick { get; set; }
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";
}
