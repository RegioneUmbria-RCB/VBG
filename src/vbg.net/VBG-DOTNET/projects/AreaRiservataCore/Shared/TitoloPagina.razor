@using Init.Sigepro.FrontEnd.CoreServices.GestioneTitoloPagina
@inject VbgPageTitleService _pageTitleService

<PageTitle>@ChildContent</PageTitle>

@code {
	[Parameter]
	public RenderFragment? ChildContent { get; set; }
	[Parameter]
	public bool Visible { get; set; } = true;

	protected override async Task OnInitializedAsync()
	{
		var text = ChildContent;
		this._pageTitleService.SetTitle(ChildContent);
		this._pageTitleService.Toggle(this.Visible);

		await base.OnInitializedAsync();
	}
}
