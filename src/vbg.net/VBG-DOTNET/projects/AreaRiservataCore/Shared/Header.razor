@inherits BaseClass
<header class="it-header-wrapper it-header-sticky" data-bs-target="#header-nav-wrapper" data-bs-toggle="sticky" data-bs-position-type="fixed" data-bs-sticky-class-name="is-sticky">

    <div class="it-header-slim-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="it-header-slim-wrapper-content">
                        <span class="d-lg-block navbar-brand">@Regione</span>
                        <div class="it-header-slim-right-zone">
                            @*<div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="visually-hidden">Selezione lingua: lingua selezionata</span>
                                    <span>ITA</span>
                                    <svg class="icon d-none d-lg-block">
                                        <use href="/css/bootstrap-italia/svg/sprites.svg#it-expand"></use>
                                    </svg>
                                </a>
                                <div class="dropdown-menu">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="link-list-wrapper">
                                                <ul class="link-list">
                                                    <li><a class="dropdown-item list-item" href="#"><span>ITA <span class="visually-hidden">selezionata</span></span></a></li>
                                                    <li><a class="dropdown-item list-item" href="#"><span>ENG</span></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>*@
                            <a href="#" class="btn btn-primary btn-icon btn-full">
                                <span class="rounded-icon">
                                    <svg class="icon icon-primary">
                                        <use href="@($"{SvgFilePath}#it-user")"></use>
                                    </svg>
                                </span>
                                <span class="d-none d-lg-block">                                    
                                    @if (this._authenticationDataResolver.IsAuthenticated && MainMenu != null)
                                    {
                                        <div class="nav-item dropdown">
                                            <a href="#" id="navbarDropdownUser" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                                <span style="text-transform: capitalize; color:#FFF;">
                                                    @UserAuthenticationResult?.FullUserName()
                                                </span>
                                                <svg class="icon d-none d-lg-block">
                                                    <use href="@($"{SvgFilePath}#it-expand")"></use>
                                                </svg>
                                            </a>

                                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownUser">
                                                @foreach (var item in MainMenu.MenuUtente)
                                                {
                                                    if (item.Url.Contains("logout.ashx"))
                                                    {
                                                        <li><a class="dropdown-item" href="#" @onclick="async () => await LogOutAsync(item.Url)" @onclick:preventDefault>@item.Titolo</a></li>
                                                    }
                                                    else
                                                    {
                                                        <li><a class="dropdown-item" href="@item.Url" target="@item.Target">@item.Titolo</a></li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>Accedi all'area personale</span>
                                    }
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="it-nav-wrapper">
        <div class="it-header-center-wrapper it-small-header">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="it-header-center-content-wrapper">
                            <div class="it-brand-wrapper">
                                <a href="@this._urlBuilder.Build(this._config.Parametri.PaginaIniziale)" title="Torna alla pagina iniziale" @onclick="@(() => GotoAsync("#"))" @onclick:preventDefault>
                                    @if (!String.IsNullOrEmpty(LogoComuneDataUrl))
                                    {
                                        <img src="@LogoComuneDataUrl" style="max-height: 80px;" alt="Home" aria-hidden="true" class="me-4">
                                    }
                                    else if (!String.IsNullOrEmpty(LogoRegioneDataUrl))
                                    {
                                        <img src="@LogoRegioneDataUrl" style="max-height: 80px;" alt="Home" aria-hidden="true" class="me-4">
                                    }
                                    else
                                    {
                                        <svg class="icon me-4" aria-hidden="true">
                                            <use href="@($"{SvgFilePath}#it-pa")"></use>
                                        </svg>
                                    }
                            
                                    <div class="it-brand-text">
                                        <div class="it-brand-title">@Denominazione</div>
                                        <div class="it-brand-tagline d-none d-md-block">SUAPE - Sportello Unico per le Attività Produttive e l'edilizia</div>
                                        @*<div class="it-brand-tagline d-none d-md-block">@Comune</div>*@
                                        @*<div class="it-brand-tagline d-none d-md-block">@Descrizione</div>*@
                                        @*<div class="it-brand-tagline d-none d-md-block">@Provincia</div>*@
                                    </div>
                                </a>
                            </div>
                            <div class="it-right-zone">
                                <div class="it-socials d-none d-md-flex">
                                    <span>Seguici su</span>
                                    <ul>
                                        <li>
                                            <a href="#" aria-label="Facebook" target="_blank">
                                                <svg class="icon">
                                                    <use href="@($"{SvgFilePath}#it-facebook")"></use>
                                                </svg>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#" aria-label="Github" target="_blank">
                                                <svg class="icon">
                                                    <use href="@($"{SvgFilePath}#it-github")"></use>
                                                </svg>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#" aria-label="Twitter" target="_blank">
                                                <svg class="icon">
                                                    <use href="@($"{SvgFilePath}#it-twitter")"></use>
                                                </svg>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                @*<div class="it-search-wrapper">
                                    <span class="d-none d-md-block">Cerca</span>
                                    <a class="search-link rounded-icon" aria-label="Cerca nel sito" href="#">
                                        <svg class="icon">
                                            <use href="/css/bootstrap-italia/svg/sprites.svg#it-search"></use>
                                        </svg>
                                    </a>
                                </div>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="it-header-navbar-wrapper" id="header-nav-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    @if (MainMenu != null)
                    {
                        <nav id="navMenu" class="navbar navbar-expand-lg has-megamenu" aria-label="Navigazione principale">
                            <button class="custom-navbar-toggler" type="button" aria-controls="nav0" aria-expanded="false" aria-label="Mostra/Nascondi la navigazione" data-bs-toggle="navbarcollapsible" data-bs-target="#nav0">
                                <svg class="icon bg-override">
                                        <use href="@($"{SvgFilePath}#it-burger")"></use>
                                </svg>
                            </button>
                            <div class="navbar-collapsable" id="nav0" style="display: none;">
                                <div class="overlay" style="display: none;"></div>
                                <div class="close-div">
                                    <button class="close-menu" type="button">
                                        <span class="visually-hidden">Nascondi la navigazione</span>
                                        <svg class="icon">
                                            <use href="@($"{SvgFilePath}#it-close-big")"></use>
                                        </svg>
                                    </button>
                                </div>
                                <div class="menu-wrapper">
                                    <ul class="navbar-nav">
                                        @foreach (var (sezione, index) in MainMenu.Sezioni.Select((value, i) => (value, i)))
                                        {
                                            string ariaLabel = sezione.Titolo;

                                            if (ariaLabel.Contains("glyphicon-home"))
                                            {
                                                continue;
                                            }

                                            <li class="nav-item @(sezione.HaLink ? "" : "dropdown")">
                                                <a href='@(string.IsNullOrEmpty(sezione.Url) ? "#" : sezione.Url)'
                                                   id="navbarDropdown@(index)"
                                                   class="nav-link @(sezione.HaLink ? "" : "dropdown-toggle")"
                                                   data-bs-toggle="@(sezione.HaLink ? "" : "dropdown")"
                                                   target='@sezione.Target'
                                                   role="button"
                                                   aria-label="@ariaLabel"
                                                   aria-haspopup="true"
                                                   aria-expanded="false">

                                                    <span>@((MarkupString)sezione.Titolo)</span>

                                                    @if (!sezione.HaLink)
                                                    {
                                                        @*<span class="caret"></span>*@
                                                        <svg class="icon icon-xs">
                                                            <use href="@($"{SvgFilePath}#it-expand")"></use>
                                                        </svg>
                                                    }
                                                </a>

                                                @if (!sezione.HaLink && sezione.SubMenu != null)
                                                {
                                                    <div class="dropdown-menu" role="region" aria-labelledby="navbarDropdown@(index)">
                                                        <div class="link-list-wrapper">
                                                            @*<div class="link-list-heading">Sezione</div>*@
                                                            <ul class="link-list">
                                                                @foreach (var sottomenu in sezione.SubMenu)
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item list-item" href="@sottomenu.Url" target="@sottomenu.Target">@sottomenu.Titolo</a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                }
                                            </li>
                                        }

                                    </ul>

                                    <!-- Sezione menu destra -->
                                    @if (MainMenu.MenuDestra is not null && MainMenu.MenuDestra.Any())
                                    {
                                        <ul class="navbar-nav">

                                            @foreach (var menuDx in MainMenu.MenuDestra)
                                            {
                                                <li class="nav-item @(menuDx.HaLink ? "" : "dropdown")">
                                                    <a href="@menuDx.Url"
                                                       class="nav-link @(menuDx.HaLink ? "" : "dropdown-toggle")"
                                                       data-bs-toggle="@(menuDx.HaLink ? "" : "dropdown")"
                                                       target="@menuDx.Target"
                                                       role="button"
                                                       aria-haspopup="true"
                                                       aria-expanded="false">

                                                        <span>@((MarkupString)menuDx.Titolo)</span>

                                                        @if (!menuDx.HaLink)
                                                        {
                                                            <svg class="icon icon-xs">
                                                                <use href="@($"{SvgFilePath}#it-expand")"></use>
                                                            </svg>
                                                        }
                                                    </a>

                                                    @if (!menuDx.HaLink && (menuDx.SubMenu?.Any() ?? false))
                                                    {
                                                        <div class="dropdown-menu" role="region">
                                                            <div class="link-list-wrapper">
                                                                <ul class="link-list">
                                                                    @foreach (var sottomenu in menuDx.SubMenu)
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item list-item" href="@sottomenu.Url" target="@sottomenu.Target">@sottomenu.Titolo</a>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
	</div>

</header>