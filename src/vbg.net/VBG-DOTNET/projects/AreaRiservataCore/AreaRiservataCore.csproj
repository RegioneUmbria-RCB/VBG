	</ItemGroup>

	<ItemGroup>
		<None Update="moduli-fvg\compilazione\managed-data-mappings.nocopy.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
		<Folder Include="PraticheInUscita\" />
	</ItemGroup>

</Project>
