<style type="text/css">
    .editingColumn {
        text-align: right;
    }

    .editingColumn a {
        padding: 1rem;
    }
</style>


@if (RichiedentiDataSource?.Any() ?? false)
{
    @foreach (var group in RichiedentiDataSource.GroupBy(x => x.InQualitaDi))
    {
        string sezione = group.FirstOrDefault().InQualitaDi;

        <StepCard Titolo="@sezione">

            @foreach (var item in group)
            {
                AziendeDataItems.Clear();

                foreach (var i in item.AziendeCollegabili)
                {
                    AziendeDataItems.Add(new DropDownItem(i.Key.ToString(), i.Value));
                }

                ModelRichiedenti? rowModel = modelRichiedentiList.Find(x => x.Id == item.Id);

                if (rowModel == null)
                {
                    rowModel = new()
                    {
                        Id = item.Id,
                        Nominativo = item.Nominativo,
                        InQualitaDi = item.InQualitaDi,
                        AziendaCollegata = AziendeDataItems.Find(x => x.Text == item.AziendaCollegata),
                        EditMode = false,
                        ShowCommandButtons = true
                    };

                    modelRichiedentiList.Add(rowModel);
                }
                var anagrafica = this.DomandaCorrente.Anagrafiche.GetById(rowModel.Id.Value);

                <StepCardItem>
                    @if (anagrafica.TipoSoggetto.RichiedeAnagraficaCollegata && anagrafica.AnagraficaCollegata == null)
                    {
                        <ErrorMessage>
                            Il tipo soggetto <span class="fw-bold">@anagrafica.TipoSoggetto</span> deve essere collegato ad una persona giuridica.

                            @if (DomandaCorrente.Anagrafiche.GetAnagraficheCollegabili().Any())
                            {
                                <span>Fai click su <span class="fw-bold">Collega Azienda</span> per collegarlo.</span>
                            }
                            else
                            {
                                <span>Utilizza la funzione <span class="fw-bold">"Aggiungi soggetto"</span> per inserire un'azienda e fai click su <span class="fw-bold">"Collega Azienda"</span> per collegarlo.</span>
                            }
                        </ErrorMessage>
                    }

                    <StepCardItemTitle Titolo="@($"{anagrafica.Nome} {anagrafica.Nominativo}")"></StepCardItemTitle>

                    <StepCardButtonGroup DeleteVisible="true"
                                        DeleteClick="() => ShowConfirmationModal(rowModel)"
                                        EditClick="() => OnRowEditAsync(rowModel)"></StepCardButtonGroup>

                    @if (item.TipoPersona == Init.Sigepro.FrontEnd.AppLogic.GestionePresentazioneDomanda.GestioneAnagrafiche.TipoPersonaEnum.Fisica)
                    {
                        <StepCardInfo Titolo="Codice Fiscale">@anagrafica.Codicefiscale</StepCardInfo>
                    }
                    else
                    {
                        <StepCardInfo Titolo="Partita IVA">@anagrafica.PartitaIva</StepCardInfo>
                    }

                    @if (anagrafica.TipoSoggetto.RichiedeAnagraficaCollegata)
                    {
                        if (anagrafica.AnagraficaCollegata != null)
                        {
                            <div class="float-end mt-2">
                                <button @onclick="ModificaCollegamento" class="text-decoration-none me-2"><span class="text-button-sm-semi t-primary">Modifica</span></button>
                            </div>
                            <p class="card-info">Azienda collegata <br> <span>@anagrafica.AnagraficaCollegata.ToString()</span></p>
                        }
                        else
                        {
                            if (DomandaCorrente.Anagrafiche.GetAnagraficheCollegabili().Any())
                            {
                                <button class="btn btn-primary mt-4" @onclick="() => _editModal?.Show()">Collega azienda</button>
                            }
                            else
                            {
                                <div class="t-alert">Non sono state trovate aziende collegabili. Utilizzare la funzionalità "Aggiungi soggetto" per aggiungere una o più aziende</div>
                            }
                        }


                        <BasicModal @ref="_editModal" OnClose="() => _editModal?.Hide()">
                            <ModalHeader Titolo="Collega azienda">
                                Seleziona l'azienda da collegare al soggetto <span class="fw-bold">@anagrafica.NomeEsteso</span> (@anagrafica.TipoSoggetto.Descrizione)
                                @* <ErrorSummary Errori="_errors"></ErrorSummary> *@
                            </ModalHeader>
                            <ModalBody>
                                <VbgForm Id="collegaAnagrafica" Model="_model" ValidationCallBack="ValidationCallBackCollegamento" OnValidSubmit="() => OnRowConfirmAsync(rowModel)">
                                    <DataAnnotationsValidator></DataAnnotationsValidator>
                                    @if (DomandaCorrente is not null)
                                    {
                                        <InputRadioGroup @bind-Value="_model.IdAnagraficaCollegata">
                                            @foreach (var x in DomandaCorrente.Anagrafiche.GetAnagraficheCollegabili().ToArray())
                                            {
                                                <div class="cmp-info-button-card mt-2 radio-card @(_model.IdAnagraficaCollegata == x.Id ? "has-border-green" : "")">
                                                    <div class="form-check p-3">
                                                        <InputRadio Value="x.Id" id="@($"radio{x.Id}")"></InputRadio>
                                                        <label for="@($"radio{x.Id}")">
                                                            <h4 class="big-title card-header m-0 p-0 pb-2 text-break">@x.NomeEsteso</h4>
                                                        </label>
                                                        <small id="@($"radio{x.Id}-help")" class="form-text">

                                                            <StepCardInfo Titolo="In qualità di">@x.TipoSoggetto.Descrizione</StepCardInfo>

                                                            <div class="row">
                                                                @if (!String.IsNullOrEmpty(x.Codicefiscale))
                                                                {
                                                                    <div class="col">
                                                                        <StepCardInfo Titolo="Codice Fiscale">@x.Codicefiscale</StepCardInfo>
                                                                    </div>
                                                                }

                                                                @if (!String.IsNullOrEmpty(x.PartitaIva))
                                                                {
                                                                    <div class="col">
                                                                        <StepCardInfo Titolo="Partita IVA">@x.PartitaIva</StepCardInfo>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </small>
                                                    </div>
                                                </div>
                                            }
                                        </InputRadioGroup>
                                    }

                                    @* submit button invisible inserito per eliminare errore accessibilità *@
                                    <button type="submit" aria-hidden="true" hidden></button>
                                </VbgForm>
                            </ModalBody>

                            <ModalFooter>
                                <FormSubmitButton Form="collegaAnagrafica">Conferma</FormSubmitButton>
                            </ModalFooter>
                        </BasicModal>
                    }

                </StepCardItem>
            }
        </StepCard>
               
    }
        
}




