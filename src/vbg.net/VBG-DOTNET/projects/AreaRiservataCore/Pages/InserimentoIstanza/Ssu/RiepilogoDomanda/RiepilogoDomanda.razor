@page "/{IdComune}/{Software}/inserimento-istanza/ssu/riepilogo-domanda/{idDomanda:int}/{stepId:int}"
@using AreaRiservataCore.Pages.InserimentoIstanza.RiepilogoDomanda
@using Init.Sigepro.FrontEnd.AppLogic.Configurazione.V2
@using Init.Sigepro.FrontEnd.AppLogic.GenerazioneDocumentiDomanda.GenerazioneRiepilogoDomanda
@using Init.Sigepro.FrontEnd.AppLogic.GestioneOggetti
@using Init.Sigepro.FrontEnd.AppLogic.InvioDomanda
@using Init.Sigepro.FrontEnd.CoreServices.GestionePresentazioneDomanda.Paginatore
@using Init.Sigepro.FrontEnd.Infrastructure.StepsDomanda.Attributi
@using VBG.AppLogic.SSU.Configurazione
@using VBG.AppLogic.SSU.GestioneDatiDinamici
@using VBG.AppLogic.SSU.GestioneRiepilogoDomanda
@using VBG.AppLogic.SSU.APICatalogoServizi.Client
@using VBG.AppLogic.SSU.InvioDomanda
@using VBG.AppLogic.SSU.MapperValidator
@using VBG.AppLogic.SSU.OperazioniPostInvio

@inherits IstanzeStepPage

@if (_inizializzazioneCompletata)
{
    <RiepilogoDomandaMainComponent DatiConfigurazione="this._datiConfigurazione"
                                   OnClose="ReturnToHomeAsync"
                                   DomandaCorrente="this.DomandaCorrente"
                                   OnInvioRiuscito="OnInvioRiuscitoAsync"
                                   GeneraRiepilogoCallback="GeneraRiepilogoAsync"
                                   ParametriInvioDomanda="_parametriInvio"
                                   InvioDomandaService="_invioDomandaService"></RiepilogoDomandaMainComponent>
}
@code {
    #region Parametri letti dal file xml

    [StepProperty]
    public string DescrizioneFaseRiepilogo { get; set; } = "";
    [StepProperty]
    public string TitoloFaseRiepilogo { get; set; } = "Riepilogo dei dati immessi";
    [StepProperty]
    public string TitoloFaseInvio { get; set; } = "Sottoscrizione e invio dell'istanza";
    [StepProperty]
    public bool AggiungiSchedeNonFirmateARiepilogoAllegati { get; set; } = true;
    [StepProperty]
    public bool MostraRiepilogoDomanda { get; set; } = true;

    [StepProperty]
    public string SottotitoloFaseInvio { get; set; } = "Scaricare, firmare digitalmente e ricaricare il documento";
    [StepProperty]
    public string DescrizioneFaseInvio { get; set; } = "Descrizione fase invio";
    [StepProperty]
    public string TestoDichiarazione { get; set; } = "";
    [StepProperty]
    public string TestoCheckDichiarazione { get; set; } = "Check dichiarazione";
    [StepProperty]
    public string TestoBottoneTrasferisciIstanza { get; set; } = "Trasferisci l'istanza al comune";
    [StepProperty]
    public string TitoloGrigliaSottoscrittori { get; set; } = "L'istanza deve essere firmata da";
    [StepProperty]
    public string TitoloGrigliaNonSottoscrittori { get; set; } = "I soggetti che non sottoscrivono sono";
    [StepProperty]
    public bool MostraGrigliaSottoscrittori { get; set; } = true;
    [StepProperty]
    public bool MostraGrigliaNonSottoscrittori { get; set; } = true;
    [StepProperty]
    public bool VerificaFirmaSuRiepilogo { get; set; } = true;
    #endregion

    [Inject]
    public GenerazioneRiepilogoDomandaService _generazioneRiepilogoDomandaService { get; set; } = default!;
    [Inject]
    public SsuDatiDinamiciService _ssuDatiDinamiciService { get; set; } = default!;
    [Inject]
    public IConfigurazione<ParametriSsu> _configurazioneSsu { get; set; } = default!;
    [Inject]
    public SsuRiepilogoDomandaService _ssuRiepilogoDomandaService { get; set; } = default!;
    [Inject]
    public SsuInvioDomandaService _invioDomandaService { get; set; } = default!;

    [CascadingParameter]
    private PaginatoreStateService _paginatoreStateService { get; set; } = default!;

    private SsuModelloDomandaReader _modelloDomandaReader = default!;
    private DatiConfigurazioneRiepilogo? _datiConfigurazione;
    private SsuStrutturaModelloDinamicoRepository? _strutturaModelloDinamicoRepository;
    private string _urlRedirectInvioRiuscito = "inserimento-istanza/ssu/certificato-invio";
    private ParametriInvioDomanda? _parametriInvio;
    private bool _inizializzazioneCompletata = false;

    protected override async Task OnInitializeStepAsync()
    {
        await this._spinnerService.ShowSpinnerAsync(async () =>
        {
            try
            {
                await base.OnInitializeStepAsync();

                var riepilogoDomanda = await this._ssuRiepilogoDomandaService.GetModelloRiepilogoAsync(this.IdDomanda!.Value);

                if (riepilogoDomanda != null)
                {
                    this._modelloDomandaReader = new SsuModelloDomandaReader(riepilogoDomanda.TemplateXsl ?? "");

                    this._datiConfigurazione = new DatiConfigurazioneRiepilogo
                    {
                        AggiungiSchedeNonFirmateARiepilogoAllegati = this.AggiungiSchedeNonFirmateARiepilogoAllegati,
                        DescrizioneFaseInvio = this.DescrizioneFaseInvio,
                        DescrizioneFaseRiepilogo = this.DescrizioneFaseRiepilogo,
                        MostraGrigliaNonSottoscrittori = this.MostraGrigliaNonSottoscrittori,
                        MostraGrigliaSottoscrittori = this.MostraGrigliaSottoscrittori,
                        MostraRiepilogoDomanda = this.MostraRiepilogoDomanda,
                        SottotitoloFaseInvio = this.SottotitoloFaseInvio,
                        TestoBottoneTrasferisciIstanza = this.TestoBottoneTrasferisciIstanza,
                        TestoCheckDichiarazione = this.TestoCheckDichiarazione,
                        TestoDichiarazione = this.TestoDichiarazione,
                        TitoloFaseInvio = this.TitoloFaseInvio,
                        TitoloFaseRiepilogo = this.TitoloFaseRiepilogo,
                        TitoloGrigliaNonSottoscrittori = this.TitoloGrigliaNonSottoscrittori,
                        TitoloGrigliaSottoscrittori = this.TitoloGrigliaSottoscrittori,
                        VerificaFirmaSuRiepilogo = true,
                        RichiedeFirmaDigitale = riepilogoDomanda.RichiedeFirma
                    };
                }

                await this.InizializzaRepositorySchedeDinamicheAsync();
            }
            catch (Exception)
            {
                this.MessageContainer.AddError("Si è verificato un errore durante il recupero del riepilogo della domanda");

                this._paginatoreStateService.NascondiBottoneInviaDomanda();
            }

            this._parametriInvio = ParametriInvioDomanda.AreaRiservataSsu(this._configurazioneSsu.Parametri.GetSportelloDestinatario());
        });

        _inizializzazioneCompletata = true;

    }

    private async Task InizializzaRepositorySchedeDinamicheAsync()
    {
        var schedePerProcedimento = await this._ssuDatiDinamiciService.GetDatiDinamiciAsync(this.IdDomanda!.Value);

        var schedeDomanda = schedePerProcedimento.Where(x => x.Schede is not null).SelectMany(x => x.Schede!);

        this._strutturaModelloDinamicoRepository = new SsuStrutturaModelloDinamicoRepository(schedeDomanda);
    }

    private async Task<BinaryFile> GeneraRiepilogoAsync()
        => await this._generazioneRiepilogoDomandaService.GeneraRiepilogoDomandaAsync(this.IdDomanda!.Value, this._modelloDomandaReader, this._strutturaModelloDinamicoRepository, this.AggiungiSchedeNonFirmateARiepilogoAllegati);

    private async Task ReturnToHomeAsync() => await this.GotoAsync("home");

    private async Task OnInvioRiuscitoAsync(DatiIstanzaInviata datiIstanza)
    {
        await this.GotoAsync(this._urlRedirectInvioRiuscito, datiIstanza.IdDomandaOnline);
    }
}
