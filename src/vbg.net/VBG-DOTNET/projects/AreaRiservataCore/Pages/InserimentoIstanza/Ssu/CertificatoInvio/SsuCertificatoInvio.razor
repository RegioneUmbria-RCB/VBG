@page "/{IdComune}/{Software}/inserimento-istanza/ssu/certificato-invio/{IdDomanda:int}"
@layout MainLayout


@using Init.Sigepro.FrontEnd.AppLogic.SalvataggioDomanda
@using VBG.AppLogic.SSU.DataAccess
@inherits BasePage

@if (_datiPratica is not null)
{
    <TitoloPagina>
        <SvgIcon IconId="it-check-circle" CssClass="icon-success big-lg-icon mb-1"></SvgIcon>
        Richiesta inviata
    </TitoloPagina>

    <div class="cmp-heading pb-3 pb-lg-4">
        <div class="categoryicon-top d-flex">
        </div>

        <p class="subtitle-small">
            Grazie, abbiamo ricevuto la tua richiesta per la pratica con numero domanda <span class="fw-bold">@_datiPratica!.NumeroDomandaSsu</span>.<br />
        </p>

        @if (!String.IsNullOrEmpty(_emailDestinatarioRicevuta))
        {
            <p>A breve ti invieremo la ricevuta di invio domanda all'indirizzo <b>@_emailDestinatarioRicevuta</b></p>
        }
        <p class="pt-3 pt-lg-4 mb-0">
            Data invio:
            <span class="fw-bold">@_datiPratica!.DataInvio.ToShortDateString()</span>
        </p>

        <button class="btn btn-outline-primary me-2" type="button" @onclick="GoToHomeAsync">Torna all'area personale</button>

    </div>
}
@code {
    [Inject]
    public IDomandeSsuRepository _domandeSsuRepository { get; set; } = default!;

    [Inject]
    public ISalvataggioDomandaStrategy _salvataggioDomandaStrategy { get; set; } = default!;

    [Parameter]
    public int IdDomanda { get; set; }


    private FoDomandeSsu? _datiPratica;
    private string _emailDestinatarioRicevuta = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _datiPratica = _domandeSsuRepository.GetByIdDomanda(this.IdDomanda);
        var domanda = await _salvataggioDomandaStrategy.GetByIdAsync(IdDomanda);

        _emailDestinatarioRicevuta = domanda.ReadInterface.AltriDati.DomicilioElettronico;
    }

    private async Task GoToHomeAsync()
    {
        await this.GotoAsync("home");
    }
}
