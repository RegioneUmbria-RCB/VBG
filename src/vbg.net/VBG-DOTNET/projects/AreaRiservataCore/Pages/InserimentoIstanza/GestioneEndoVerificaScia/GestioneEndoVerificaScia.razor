@page "/{IdComune}/{Software}/inserimento-istanza/gestione-endo-verifica-scia/{idDomanda:int}/{stepId:int}"
@using Init.Sigepro.FrontEnd.AppLogic.GestioneEndoprocedimenti
@using Init.Sigepro.FrontEnd.AppLogic.GestioneEndoprocedimenti.Incompatibilita
@using Init.Sigepro.FrontEnd.AppLogic.GestioneEndoprocedimenti.IncompatibilitaNatura
@using Init.Sigepro.FrontEnd.AppLogic.GestionePresentazioneDomanda.GestioneEndoprocedimenti
@using Init.Sigepro.FrontEnd.Infrastructure.StepsDomanda.Attributi
@using System.Text
@inherits IstanzeStepPage

<style>
/*
	.alert {
		background-image: url('Images/warning-icon.png');
		background-repeat: no-repeat;
		background-position-x: 15px;
		background-position-y: 20px;
		padding-left: 60px;
	}

		.alert ul {
			margin-top: 10px;
		}
		*/
</style>

<div class="alert alert-warning" role="alert">
	@((MarkupString)_messaggioErrore)
</div>

@code {
	[Inject]
	private IEndoprocedimentiIncompatibiliService _endoprocedimentiIncompatibiliService { get; set; } = default!;
	[Inject]
	private IEndoprocedimentiService _endoprocedimentiService { get; set; } = default!;

	[StepProperty(@"Messaggio di errore da mostrare in caso di incompatibilità tra endo. Supporta i seguenti segnaposto: 
	{0}= Descrizione endo principale,
	{1}= Natura dell'endo principale, 
	{2}= Lista degli endo incompatibili,
	{3}= Natura base del primo endo incompatibile calcolato in base al binario dipendenze")]
	public string MessaggioErrore { get; set; } = "Non è possibile proseguire con la presentazione della domanda in quanto esistono delle incompatibilità tra le nature degli endoprocedimenti attivati.";

	[StepProperty("Se impostato a true permette la presentazione della domanda anche in caso di valori incompatibili", ValoreDefault = "true")]
	public bool ConsentiProseguimentoInCasoDiIncompatibilita { get; set; } = true;

	IEnumerable<Endoprocedimento>? _cacheEndoIncompatibili;
	string _messaggioErrore = String.Empty;

	private IEnumerable<Endoprocedimento> EndoIncompatibili
	{
		get
		{
			if (_cacheEndoIncompatibili is null)
			{
				var naturaEndoCompatibile = new NaturaEndoCompatibileSpecification(DomandaCorrente.Endoprocedimenti.Principale);

				_cacheEndoIncompatibili = DomandaCorrente
												.Endoprocedimenti
												.SecondariNonPresenti
												.Where(endo => !naturaEndoCompatibile.IsSatisfiedBy(endo))
												.ToList();
			}
			return _cacheEndoIncompatibili;
		}
	}


	protected override bool CanEnterStep()
	{
		// devo resettare la natura dell'istanza
		this._endoprocedimentiService.ImpostaNaturaBaseDomanda(this.IdDomanda.Value, String.Empty);

		return EndoIncompatibili.Count() > 0;
	}

	protected override bool CanExitStep()
	{
		if (EndoIncompatibili.Count() == 0) return true;

		if (!ConsentiProseguimentoInCasoDiIncompatibilita)
		{
			MessageContainer.ClearErrors();
			MessageContainer.AddError("Non è possibile proseguire con la presentazione della domanda in quanto esistono delle incompatibilità tra le nature degli endoprocedimenti attivati.");
			return false;
		}

		// Se esistono endo incompatibili assegno la nuova natura dell'istanza,
		// nel caso in cui ci fossero più endo incompatibili prendo quello con
		// il binario dipendenze più alto
		var endoNuovaNatura = this.EndoIncompatibili.OrderByDescending(x => x.BinarioDipendenze).First();

		var naturaBase = this._endoprocedimentiIncompatibiliService.GetNaturaBaseDaidEndoprocedimento(endoNuovaNatura.Codice);

		this._endoprocedimentiService.ImpostaNaturaBaseDomanda(this.IdDomanda.Value, naturaBase);

		return true;
	}

	protected override void OnInitializeStep()
	{
		if (EndoIncompatibili.Count() == 0)
			return;

		var endoPrincipale = this.DomandaCorrente.Endoprocedimenti.Principale;

		var endoNuovaNatura = this.EndoIncompatibili.OrderByDescending(x => x.BinarioDipendenze).First();

		var naturaBase = this._endoprocedimentiIncompatibiliService.GetNaturaBaseDaidEndoprocedimento(endoNuovaNatura.Codice);

		this._messaggioErrore = String.Format(MessaggioErrore,
													endoPrincipale.Descrizione,
													endoPrincipale.Natura.Descrizione,
													GeneraListaHtmlEndoIncompatibili(),
													naturaBase);

		base.OnInitializeStep();
	}

	private string GeneraListaHtmlEndoIncompatibili()
	{
		var sb = new StringBuilder();

		sb.Append("<ul>");

		foreach (var endo in EndoIncompatibili)
		{
			sb.AppendFormat("<li>{0}<br /><span class=\"fst-italic\">Natura: {1}</span></li>",
							endo.Descrizione,
							endo.Natura.Descrizione);
		}
		sb.Append("</ul>");

		return sb.ToString();
	}

}
