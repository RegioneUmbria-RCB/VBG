@page "/{IdComune}/{Software}/inserimento-istanza/gestione-localizzazioni-sit/{idDomanda:int}/{stepId:int}"
@using AreaRiservataCore.Shared.Localizzazioni
@using VBG.BlazorComponentsLibrary.DesignComuni.Forms
@using VBG.BlazorComponentsLibrary.DesignComuni.Modals
@using VBG.BlazorComponentsLibrary.DesignComuni.StepCards
@using VBG.BlazorComponentsLibrary.DesignComuni.StepCards.CardButtons
@using VBG.BlazorComponentsLibrary.EditFormComponents
@using VBG.BlazorComponentsLibrary.EditFormComponents.DropDown
@using VBG.BlazorComponentsLibrary.RisorseTestuali
@inherits IstanzeStepPage

<style>
    .icona-mappa {
        width: 20px;
        height: 20px;
        vertical-align: bottom;
        margin-bottom: 2px;
        cursor: pointer;
    }
</style>

@if (_gridDataSource != null)
{
    <StepCard Titolo="">
        @foreach (var item in _gridDataSource)
        {
            <StepCardItem>
                @if (!string.IsNullOrEmpty(UrlLocalizzazioneDaIndirizzo))
                {
                    <img src="images/map-icon-small.png" class="icona-mappa me-2"
                         @onclick='() => WindowOpenAsync(
                            GetFormattedUrl(UrlLocalizzazioneDaIndirizzo, item),
                            "sit",
                            "height=500, width=700, menubar=no, resizable=yes,scrollbars=yes,status=no,toolbar=no"
                            )'
                    @onclick:preventDefault />
                }
                <StepCardButtonGroup EditClick="() => OnRowEdit(item)" DeleteVisible="true" DeleteClick="() => OnIniziaEliminazione(item)"></StepCardButtonGroup>
                <StepCardItemTitle Titolo="@item.Indirizzo"></StepCardItemTitle>

                <StepCollapsibleContent>
                    <StepCollapsibleContentItem>
                        <StepCardInfo Titolo="Colore" Visible="@_formLocalizzazioni.Colore.Visibile">@item.Colore</StepCardInfo>
                        <StepCardInfo Titolo="Scala" Visible="@_formLocalizzazioni.Scala.Visibile">@item.Scala</StepCardInfo>
                        <StepCardInfo Titolo="Piano" Visible="@_formLocalizzazioni.Piano.Visibile">@item.Piano</StepCardInfo>
                        <StepCardInfo Titolo="Interno" Visible="@_formLocalizzazioni.Interno.Visibile">@item.Interno</StepCardInfo>
                        <StepCardInfo Titolo="Esponente interno" Visible="@_formLocalizzazioni.EsponenteInterno.Visibile">@item.EsponenteInterno</StepCardInfo>
                        <StepCardInfo Titolo="Fabbricato" Visible="@_formLocalizzazioni.Fabbricato.Visibile">@item.Fabbricato</StepCardInfo>
                        <StepCardInfo Titolo="Km" Visible="@_formLocalizzazioni.Km.Visibile">@item.Km</StepCardInfo>
                        <StepCardInfo Titolo="Note" Visible="@_formLocalizzazioni.Note.Visibile">@item.Note</StepCardInfo>
                    </StepCollapsibleContentItem>

                    @if (_formLocalizzazioni.Longitudine.Visibile)
                    {
                        <StepCollapsibleContentItem Titolo="Coordinate">
                            <div class="row">
                                <div class="col-6">
                                    <StepCardInfo Titolo="Longitudine" CapitalizeText="true">@item.Longitudine</StepCardInfo>
                                </div>
                                <div class="col-6">
                                    <StepCardInfo Titolo="Latitudine" CapitalizeText="true">@item.Latitudine</StepCardInfo>
                                </div>
                            </div>
                        </StepCollapsibleContentItem>
                    }

                    <StepCollapsibleContentItem Titolo="Riferimento Catastale">
                        @if (!string.IsNullOrEmpty(UrlLocalizzazioneDaMappali))
                        {
                            <img src="images/map-icon-small.png" class="icona-mappa me-2"
                                 @onclick='() => WindowOpenAsync(
                                                GetFormattedUrl(UrlLocalizzazioneDaMappali, item),
                                                "sit",
                                                "height=500, width=700, menubar=no, resizable=yes,scrollbars=yes,status=no,toolbar=no"
                                            )'
                            @onclick:preventDefault />
                        }
                        <StepCardInfo Titolo="">@item.PrimoRiferimentoCatastale</StepCardInfo>

                    </StepCollapsibleContentItem>

                </StepCollapsibleContent>
            </StepCardItem>
        }

        <StepButton Text="Aggiungi un indirizzo" OnClick="OnNewRow" Icon="StepButtonIcons.PlusCircle"></StepButton>

    </StepCard>
}

<ConfirmationModal Titolo="Conferma eliminazione indirizzo" Visible="@(_deletingItem != null)" ConfermaClick="OnRowDeleteAsync" AnnullaClick="OnAnnullaEliminazione">
    <ModalBody>
        <div>
            Sei sicuro di voler rimuovere l'indirizzo selezionato?
        </div>
    </ModalBody>
</ConfirmationModal>

@switch (currentStep)
