                                                          ValueChanged="@(EventCallback.Factory.Create(this, (string s) => {
                                            model.Particella = s;
                                            myForm.ClearValidationMessage(new FieldIdentifier(model, "Particella"));
                                            if (!string.IsNullOrEmpty(model.Particella)) { ValidaCampo("Particella"); }
                                        }))"
                                                          ValueExpression="() => model.Particella"
                                                          ValidationFor="() => model.Particella"
                                                          Required="@_formLocalizzazioni.Particella.Obbligatorio"
                                                          RegEx="@_formLocalizzazioni.Particella.EspressioneRegolare"
                                                          ValoreMin="@_formLocalizzazioni.Particella.ValoreMin"
                                                          ValoreMax="@_formLocalizzazioni.Particella.ValoreMax">
                                        </AutocompleteForm>
                                    </div>
                                    
                                }
                                @if (_formLocalizzazioni.Sub.Visibile)
                                {
                                    <div class="col-md-3">
                                        <AutocompleteForm Id="txtSub"
                                                          Label="@_formLocalizzazioni.Sub.Etichetta"
                                                          TItem="string" TValue="string"
                                                          SearchMethod="@GetSubDataItemsAsync"
                                                          MinimumLength="0"
                                                          ConvertMethod="(string x) => x"
                                                          Value="model.Sub"
                                                          ValueChanged="@(EventCallback.Factory.Create(this, (string s) => {
                                            model.Sub = s;
                                            myForm.ClearValidationMessage(new FieldIdentifier(model, "Sub"));
                                            if (!string.IsNullOrEmpty(model.Sub)) { ValidaCampo("Sub"); }
                                        }))"
                                                          ValueExpression="() => model.Sub"
                                                          ValidationFor="() => model.Sub"
                                                          Required="@_formLocalizzazioni.Sub.Obbligatorio"
                                                          RegEx="@_formLocalizzazioni.Sub.EspressioneRegolare"
                                                          ValoreMin="@_formLocalizzazioni.Sub.ValoreMin"
                                                          ValoreMax="@_formLocalizzazioni.Sub.ValoreMax">
                                        </AutocompleteForm>
                                    </div>
                                    
                                }
                            </div>
                        </fieldset>
                    }

                </VbgForm>
            </ModalBody>
            <ModalFooter>
                <FormSubmitButton Form="localizzazioniForm"></FormSubmitButton>
            </ModalFooter>
        </BasicModal>
        break;
}