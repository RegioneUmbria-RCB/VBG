@using VBG.BlazorComponentsLibrary.AccessibilityComponents


<button style="" class="btn primary-color" @onclick="OnClick">
    <div class="d-flex align-items-center">
        <div>
            <SvgIcon IconId="it-arrow-left" CssClass="icon-sm icon-primary me-2"></SvgIcon>
            @* <svg class="icon icon-sm icon-primary me-2"><use href="css/bootstrap-italia/svg/sprites.svg#it-arrow-left"></use></svg> *@
        </div>
        <div class="d-flex flex-column align-items-start">
            <div class="x-small mb-0 lh-sm">@TestoSuperiore</div>
            <div class="mt-0 lh-sm">@Text</div>
        </div>
    </div>
</button>

@code {
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter]
    public string Text { get; set; } = "Indietro";
    [Parameter]
    public string TestoSuperiore { get; set; } = "";
}
