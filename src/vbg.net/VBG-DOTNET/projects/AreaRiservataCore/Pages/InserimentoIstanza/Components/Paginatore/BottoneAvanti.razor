@using VBG.BlazorComponentsLibrary.AccessibilityComponents
<button class="btn btn-primary pull-right" @onclick="OnClick">

    <div class="d-flex align-items-center">

        <div class="d-flex flex-column align-items-end">
            <div class="x-small mb-0 lh-sm">@TestoSuperiore</div>
            <div class="mt-0 lh-sm">@Text</div>
        </div>
        <div>
            <SvgIcon IconId="it-arrow-right" CssClass="icon-sm icon-white me-2"></SvgIcon>
            @* <svg class="icon icon-sm icon-white me-2"><use href="css/bootstrap-italia/svg/sprites.svg#it-arrow-right"></use></svg> *@
        </div>
    </div>
</button>

@code {
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter]
    public string Text { get; set; } = "Avanti";
    [Parameter]
    public string TestoSuperiore { get; set; } = "";

}
