@page "/{IdComune}/{Software}/inserimento-istanza/gestione-domicilio-elettronico/{idDomanda:int}/{stepId:int}"
@using Init.Sigepro.FrontEnd.AppLogic.GestioneDomicilioElettronico
@using Init.Sigepro.FrontEnd.AppLogic.GestionePresentazioneDomanda.GestioneAnagrafiche
@using Init.Sigepro.FrontEnd.AppLogic.Services.Domanda
@using Init.Sigepro.FrontEnd.Infrastructure.StepsDomanda.Attributi
@using System.ComponentModel.DataAnnotations
@using VBG.BlazorComponentsLibrary.EditFormComponents
@using VBG.BlazorComponentsLibrary.EditFormComponents.DropDown
@inherits IstanzeStepPage


<VbgForm Id="domicilio-elettronico-form" Model="@_model">
    <fieldset disabled="@SolaLettura">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-6">
                <GenericDropDownForm Id="dropdown-domicilio-elettronico"
                    Label="Domicilio elettronico"
                    Value="@_model.DomicilioSelezionato"
                    TItem="DropDownItem"
                    OnChanged="EventCallback.Factory.Create(this, (DropDownItem s) => { _model.DomicilioSelezionato = s; _domicilioSelezionato = s != null ? s.Value : string.Empty;})"
                    ValueExpression="() => _model.DomicilioSelezionato"
                    Selector="(x) => x.Text"
                    Items="_dropdownItems"
                    ShowEmptyItem="true"
                    ValidationFor="() => _model.DomicilioSelezionato"
                    Required="true">
                </GenericDropDownForm>
            </div>

            <div class="col-md-3"></div>

        </div>


        @if (_domicilioSelezionato == Constants.ValoreDefaultAltroIndirizzoPEC)
        {
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    <TextInputForm Id="inputDomicilio"
                        Label="Specificare l'indirizzo da utilizzare"
                        Value="@_model.IndirizzoLibero"
                        ValueChanged="EventCallback.Factory.Create(this, (string s) =>
                                           {
                                               _model.IndirizzoLibero = s;
                                               _indirizzoLibero = _model.IndirizzoLibero;
                                           })"
                        ValueExpression="() => _model.IndirizzoLibero"
                        MaxLength="60"
                        ValidationFor="() => _model.IndirizzoLibero"
                        Required="true">
                    </TextInputForm>
                </div>

                <div class="col-md-3"></div>

            </div>
        }
        else
        {
            <div class="col-md-4"></div>
            _indirizzoLibero = "";
        }

        @* submit button invisible inserito per eliminare errore accessibilità *@
        <button type="submit" aria-hidden="true" class="d-none">Conferma</button>
    </fieldset>
</VbgForm>

@code {
    private record class DomicilioElettronicoBindingItem(string Email, string Nominativo, bool IsSelected = false);

    private static class Constants
    {
        public const string MessaggioErroreEmailMancante = "Specificare il domicilio elettronico da utilizzare per l'istanza";
        public const string MessaggioErroreEmailImmessaNonValida = "L'indirizzo immesso non è un indirizzo email valido";
        public const string MessaggioErroreEmailSelezionataNonValida = "L'indirizzo selezionato non è un indirizzo email valido";
        public const string PatternValidazioneEmail = @"^[a-zA-Z]+(([\'\,\.\- ][a-zA-Z ])?[a-zA-Z]*)*\s+&lt;(\w[-._\w]*\w@\w[-._\w]*\w\.\w{2,3})&gt;$|^(\w[-._\w]*\w@\w[-._\w]*\w\.\w{2,3})$";
        public const string ValoreDefaultAltroIndirizzoPEC = "-";
    }

    public class DomicilioModel
    {

        public string IndirizzoLibero { get; set; } = "";


        public DropDownItem DomicilioSelezionato { get; set; } = default!;

    }

    [Inject]
    private IDomicilioElettronicoService DomicilioElettronicoService { get; set; } = default!;

    [StepProperty]
    public bool UsaEmailSePecNonTrovata { get; set; } = false;
    [StepProperty("Se impostato a true l'indirizzo email avrà priorità sulla pec (se un anagrafica ha sia email che pec verrà utilizzato l'indirizzo email)", ValoreDefault = "false")]
    public bool DaiPrioritaAEmail { get; set; } = false;
    [StepProperty("Messaggio di errore da mostrare nel caso il DE sia mancante")]
    public string MessaggioErroreDomicilioElettronicoMancante { get; set; } = Constants.MessaggioErroreEmailMancante;
    [StepProperty]
    public string TestoAltroIndirizzoPEC { get; set; } = "Altro indirizzo PEC";
    [StepProperty]
    public string TestoSelezionareIndirizzo { get; set; } = "Seleziona...";

    IEnumerable<DomicilioElettronicoBindingItem> _dataSource = Enumerable.Empty<DomicilioElettronicoBindingItem>();
    IEnumerable<DropDownItem> _dropdownItems = Enumerable.Empty<DropDownItem>();
    string _domicilioSelezionato = "";
    string _indirizzoLibero = "";
    private DomicilioModel _model = new DomicilioModel();

    string DomicilioElettronico => _domicilioSelezionato == Constants.ValoreDefaultAltroIndirizzoPEC ?
                                        _indirizzoLibero :
                                        _domicilioSelezionato;

    protected override void OnInitializeStep()
    {
        DataBind();

        _model.DomicilioSelezionato = new DropDownItem("", "");

        if (!string.IsNullOrEmpty(_domicilioSelezionato))
        {
            var indirizzo = _dataSource.FirstOrDefault(x => x.Email == _domicilioSelezionato);

            if (indirizzo != null)
            {
                _model.DomicilioSelezionato = new DropDownItem(indirizzo.Email, indirizzo.Nominativo);
            }
        }

        _model.IndirizzoLibero = _indirizzoLibero;
    }

    protected override void OnBeforeExitStep()
    {
        var domicilioElettronico = _domicilioSelezionato;

        if (domicilioElettronico == Constants.ValoreDefaultAltroIndirizzoPEC)
            domicilioElettronico = _indirizzoLibero;

        DomicilioElettronicoService.ImpostaDomicilioElettronico(IdDomanda.Value, domicilioElettronico);
    }

    protected override bool CanExitStep()
    {
        if (String.IsNullOrEmpty(this.DomandaCorrente.AltriDati.DomicilioElettronico))
        {
            MessageContainer.AddError(MessaggioErroreDomicilioElettronicoMancante);
            return false;
        }


        if (!DomicilioElettronicoValido(this.DomandaCorrente.AltriDati.DomicilioElettronico))
        {
            var msg = _domicilioSelezionato == Constants.ValoreDefaultAltroIndirizzoPEC ?
                        Constants.MessaggioErroreEmailImmessaNonValida :
                        Constants.MessaggioErroreEmailSelezionataNonValida;

            MessageContainer.AddError(msg);

            return false;
        }

        return true;
    }

    private void DataBind()
    {
        IEnumerable<DomicilioElettronicoBindingItem> listaAnagrafiche = Enumerable.Empty<DomicilioElettronicoBindingItem>();

        if (this.UsaEmailSePecNonTrovata)
        {
            listaAnagrafiche = this.DomandaCorrente.Anagrafiche
                                                .Anagrafiche
                                                .Select(x => new DomicilioElettronicoBindingItem(EstraiIndirizzoContatto(x), x.ToString()))
                                                .Where(x => !string.IsNullOrEmpty(x.Email))
                                                .Select(x => new DomicilioElettronicoBindingItem(x.Email, $"{x.Nominativo}: {x.Email}"));
        }
        else
        {
            listaAnagrafiche = this.DomandaCorrente.Anagrafiche
                                                     .Anagrafiche
                                                     .Where(x => !String.IsNullOrEmpty(x.Contatti.Pec))
                                                     .Select(x => new DomicilioElettronicoBindingItem(x.Contatti.Pec, $"{x}: {x.Contatti.Pec}"));
        }

        var domicilioPrecedentementeInserito = this.DomandaCorrente.AltriDati.DomicilioElettronico;

        var dataSource = listaAnagrafiche.OrderBy(x => x.Nominativo).ToList();
        dataSource.Insert(0, new DomicilioElettronicoBindingItem("", this.TestoSelezionareIndirizzo));
        dataSource.Add(new DomicilioElettronicoBindingItem(Constants.ValoreDefaultAltroIndirizzoPEC, this.TestoAltroIndirizzoPEC));

        this._dataSource = dataSource;

        this._dropdownItems = _dataSource
            .Where(item => !string.IsNullOrEmpty(item.Email))
            .GroupBy(item => item.Email)
            .Select(group => group.First())     // Prendi il primo elemento del gruppo perchè non possono esserci più DropDownItem con la stessa chiave (indirizzo mail)
            .Select(item => new DropDownItem(item.Email, item.Nominativo))
            .ToList();

        //this._domicilioSelezionato = domicilioPrecedentementeInserito;

        // - Se ho già inserito il domicilio elettronico di un soggetto e l'indirizzo email è presente nella lista anagrafiche
        //   allora seleziono nella combo l'anagrafica corrispondente
        // - Se ho inserito un domicilio elettronico ma non è l'indirizzo di uno dei soggetti allora seleziono l'elemento
        //   "Altro indirizzo pec/email"(il nome può variare) con il valore "Constants.ValoreDefaultAltroIndirizzoPec"
        // - Se non ho inserito nessun domicilio elettronico (ad es. quando entro per la prima volta nello step) seleziono
        //   l'elemento "Selezionare ..."
        this._domicilioSelezionato = String.Empty;

        if (!String.IsNullOrEmpty(domicilioPrecedentementeInserito))
        {
            var domicilioDiUnSoggetto = listaAnagrafiche.Where(x => x.Email.Equals(domicilioPrecedentementeInserito, StringComparison.OrdinalIgnoreCase)).Count() != 0;

            if (domicilioDiUnSoggetto)
            {
                _domicilioSelezionato = domicilioPrecedentementeInserito;
                _indirizzoLibero = "";
            }
            else
            {
                _domicilioSelezionato = Constants.ValoreDefaultAltroIndirizzoPEC;
                _indirizzoLibero = domicilioPrecedentementeInserito;
            }
        }
    }

    private string EstraiIndirizzoContatto(AnagraficaDomanda x)
    {
        if (this.DaiPrioritaAEmail)
        {
            return String.IsNullOrEmpty(x.Contatti.Email) ? x.Contatti.Pec : x.Contatti.Email;
        }
        return String.IsNullOrEmpty(x.Contatti.Pec) ? x.Contatti.Email : x.Contatti.Pec;
    }

    private bool DomicilioElettronicoValido(string indirizzo)
    {
        if (indirizzo.IndexOf("@") == -1)
            return false;

        if (indirizzo.IndexOf(".") == -1)
            return false;

        return true;
    }
}
