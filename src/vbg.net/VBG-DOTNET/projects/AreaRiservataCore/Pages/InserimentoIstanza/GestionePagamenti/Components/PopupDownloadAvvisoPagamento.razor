@using AreaRiservataCore.Utils
@using Init.Sigepro.FrontEnd.AppLogic.Pagamenti.NodoPagamenti
@using VBG.BlazorComponentsLibrary.DesignComuni.Modals
@using VBG.Pagamenti.NodoPagamenti


<div>

    <BasicModal @ref="_modalDownload" OnClose="() => _modalDownload?.Hide()">
        <ModalHeader>
            Generazione dell'avviso in corso
        </ModalHeader>
        <ModalBody>
            L'operazione potrebbe richiedere anche alcuni minuti, si prega di attendere senza effettuare altre operazioni...<br />

            <div class="progress-panel">
                <div class="progress progress-striped active" style="margin-bottom: 0;">
                    <div class="progress-bar" style="width: 100%"></div>
                </div>
                <small>Tentativo <span id="indicatoreTentativi">@(_numeroTentativi + 1) di @MaxTentativi</span></small>
            </div>
        </ModalBody>
    </BasicModal>

    <BasicModal @ref="_modalError" OnClose="() => _modalError?.Hide()">
        <ModalHeader>
            Generazione dell'avviso in corso
        </ModalHeader>
        <ModalBody>
            Non è stato possibile recuperare l'avviso di pagamento nel tempo stabilito, si prega di riprovare in un secondo momento
        </ModalBody>
    </BasicModal>


</div>

@code {
    [Inject]
    protected IPagamentiNodoPagamentiService _nodoPagamentiService { get; set; } = default!;
    [Inject]
    protected FileDownloadHelper _fileDownloadHelper { get; set; } = default!;

    [Parameter]
    public int MaxTentativi { get; set; } = 10;
    [Parameter]
    public int IdDomanda { get; set; }
    [Parameter]
    public int IntervalloTentativi { get; set; } = 3000;

    private BasicModal? _modalDownload;
    private BasicModal? _modalError;

    int _numeroTentativi = 0;
    bool _isVisible = false;


    public async Task Show(string uidOnere)
    {
        this._numeroTentativi = 0;
        this._isVisible = true;

        _modalDownload?.Hide();
        _modalError?.Hide();

        if (this._modalDownload is not null)
        {
            _modalDownload?.Show();
        }

        var downloadCompleted = false;

        await Task.Delay(1);

        while (this._numeroTentativi < MaxTentativi && this._isVisible)
        {
            downloadCompleted = await DownloadAvviso(uidOnere);

            if (downloadCompleted)
            {
                break;
            }

            await Task.Delay(IntervalloTentativi);
            this._numeroTentativi++;
        }

        _modalDownload?.Hide();

        if (!downloadCompleted)
        {
            _modalError?.Show();
        }
        this._isVisible = false;
    }

    private async Task<bool> DownloadAvviso(string uidOnere)
    {

        // TODO: Rendere la chiamata asincrona
        var avvisoPagamento = this._nodoPagamentiService.ScaricaAvvisoPagamento(IdDomanda, uidOnere);

        if (avvisoPagamento.Stato == AvvisoDiPagamento.StatoAvvisoEnum.DISPONIBILE)
        {
            await _fileDownloadHelper.DownloadFileAsync(avvisoPagamento.File);

            return true;
        }

        return false;
    }
}
