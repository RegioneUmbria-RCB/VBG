@using Init.Sigepro.FrontEnd.AppLogic.GestioneOneri;
@using Init.Sigepro.FrontEnd.AppLogic.GestionePresentazioneDomanda.GestioneOneri;
@using Init.Sigepro.FrontEnd.AppLogic.Pagamenti.NodoPagamenti
@using VBG.BlazorComponentsLibrary.DesignComuni.Modals

@if (this.DataSource.Any())
{

    <thead>
        <tr>
            <th>@((MarkupString)EtichettaColonnaCausale)</th>
            <th style="text-align: center"><i class="fa fa-question" aria-label="Note"></i></th>
            <th style="text-align: center">Pagamento</th>
            <th style="text-align: center">Tipo pagamento</th>
            <th style="text-align: center">Data</th>
            <th style="text-align: center">Riferimenti Pagamento</th>
            <th style="text-align: center">Importo (€)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tmp in this.DataSource)
        {
            var item = tmp;

            <tr class="riga-onere">
                <td>
                    PagamentoCompletato =@item.PagamentoCompletato
                    <span class="descrizioneCausale">@item.Causale</span>
                    <div class="descrizioneIntervento">[@item.EndoOInterventoOrigine]</div>
                </td>
                <td class="helpNoteOnereRow">
                    @if (!string.IsNullOrEmpty(item.Note))
                    {
                        <i class="fa fa-question" style="color:var(--font-accent-color); cursor:pointer;" title="Visualizza" @onclick="() => MostraNoteOnere(item.Note)" @onclick:preventDefault></i>
                    }
                </td>

                @if (@item.PagamentoCompletato)
                {
                    <td>@item.ModalitaPagamento</td>
                    <td>@item.DescrizioneTipoPagamento</td>
                    <td>@item.DataPagamento?.ToString("dd/MM/yyyy HH:ss")</td>
                    <td>@item.RiferimentoPagamento</td>
                    <td style="text-align:right">@item.ImportoPagato.ToString("N2")</td>
                }
                else
                {
                    <td style="text-align:center;width: 140px;">
                        <InputSelect @key="item" class="ddlPagamento form-control" @bind-Value="item.ModalitaPagamento" @oninput="(e) => ModalitaPagamentoModificata(e, item)">
                            @foreach (var mp in this.ModalitaPagamento)
                            {
                                <option value="@mp.CodiceEnum">@mp.Descrizione</option>
                            }
                        </InputSelect>
                    </td>

                    <td style="text-align:center">
                        @if (item.ModalitaPagamento == ModalitaPagamentoOnereEnum.GiaPagato) // Già effettuato
                        {
                            <InputSelect @bind-Value="item.CodiceTipoPagamento" class="estremiPagamento ddlTipoPagamento form-control">
                                @foreach (var tipoPagamento in this.TipiPagamento)
                                {
                                    <option value="@tipoPagamento.Codice">@tipoPagamento.Descrizione</option>
                                }
                            </InputSelect>
                        }
                    </td>
                    <td>
                        @if (item.ModalitaPagamento == ModalitaPagamentoOnereEnum.GiaPagato)
                        {
                            <InputDate @bind-Value="item.DataPagamento" class="estremiPagamento  form-control"></InputDate>
                            <span class="help-block valid-feedback"><ValidationMessage For="() => item.DataPagamento"></ValidationMessage></span>
                            @item.DataPagamento
                        }
                    </td>
                    <td>
                        @if (item.ModalitaPagamento == ModalitaPagamentoOnereEnum.GiaPagato)
                        {
                            <InputText @bind-Value="item.RiferimentoPagamento" class="estremiPagamento  form-control"></InputText>
                            <span class="help-block valid-feedback"><ValidationMessage For="() => item.RiferimentoPagamento"></ValidationMessage></span>
                        }
                    </td>
                    <td>
                        @if (item.ModalitaPagamento != ModalitaPagamentoOnereEnum.NonDovuto)
                        {
                            <InputNumber @bind-Value="item.ImportoPagato" class="estremiPagamento  form-control"
                         ReadOnly="@(item.Importo > 0.0m)" style="width: 100px; text-align: right"></InputNumber>
                            <span class="help-block valid-feedback"><ValidationMessage For="() => item.ImportoPagato"></ValidationMessage></span>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>

}

<BasicModal @ref="_modalNote" OnClose="() => _modalNote?.Hide()">
    <ModalHeader>
        Note onere
    </ModalHeader>
    <ModalBody>
        @((MarkupString)_noteDaVisualizzare)
    </ModalBody>
</BasicModal>



