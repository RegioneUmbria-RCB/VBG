@code {



    [Parameter]
    public string EtichettaColonnaCausale { get; set; } = "Causale";
    [Parameter]
    public IEnumerable<GrigliaOneriItem> DataSource { get; set; } = Enumerable.Empty<GrigliaOneriItem>();
    [Parameter]
    public IEnumerable<TipoPagamento> TipiPagamento { get; set; } = Enumerable.Empty<TipoPagamento>();
    [Parameter]
    public IEnumerable<ModalitaPagamentoNodoPagamenti> ModalitaPagamento { get; set; } = Enumerable.Empty<ModalitaPagamentoNodoPagamenti>();

    private BasicModal? _modalNote;
    private string _noteDaVisualizzare = string.Empty;

    void ModalitaPagamentoModificata(ChangeEventArgs e, GrigliaOneriItem item)
    {
        if (Enum.TryParse<ModalitaPagamentoOnereEnum>(e.Value?.ToString() ?? "", out var modalitaPagamento))
        {
            if (modalitaPagamento == ModalitaPagamentoOnereEnum.Online || modalitaPagamento == ModalitaPagamentoOnereEnum.NonDovuto)
            {
                item.RiferimentoPagamento = String.Empty;
                item.DataPagamento = null;
            }

            if (modalitaPagamento == ModalitaPagamentoOnereEnum.NonDovuto)
            {
                item.ImportoPagato = 0.0m;
            }

            if (modalitaPagamento == ModalitaPagamentoOnereEnum.Online)
            {
                item.ImportoPagato = item.Importo;
            }
        }
    }

    void MostraNoteOnere(string note)
    {
        // this._noteModal.BodyMarkupString = note;
        // this._noteModal.Refresh();
        // this._noteModal.Show();

        _noteDaVisualizzare = note;
        _modalNote?.Show();
    }
}
