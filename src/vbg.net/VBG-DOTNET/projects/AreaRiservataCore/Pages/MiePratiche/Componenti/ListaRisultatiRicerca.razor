@using VBG.BlazorComponentsLibrary.AccessibilityComponents
@using VBG.BlazorComponentsLibrary.DesignComuni.StepCards
@using static AreaRiservataCore.Pages.MiePratiche.IstanzePresentate

@if (IsLoading)
{
    <AccordionContainer>

        @for (int i = 0; i < _elementiSkeleton; i++)
        {
            <div id="@($"sk_{i}")">
                <AccordionItem CollapsibleElementId="@($"sk_{i}")" StartingCollapsed="false">
                    <div class="skeleton">
                        <div class="skeleton-text-bold bg-primary"></div>
                        <div class="skeleton-text"></div>
                        <br />
                        <div class="skeleton-rectangle"></div>
                        <br />
                        <button type="button" class="btn btn-primary justify-content-center skeleton-button" data-focus-mouse="false" disabled>
                            Mostra dettagli
                        </button>
                    </div>
                </AccordionItem>
            </div>
        }
    </AccordionContainer>
}
else
{
    if (Items?.Any() ?? false)
    {
        <AccordionContainer>
            @foreach (var item in Items)
            {
                <ElementoRisultatiRicerca Item="@item" Mode="@Mode"></ElementoRisultatiRicerca>
            }
        </AccordionContainer>
    }
    else
    {
        <Card Shadow="Card.CardShadow.Small">
            <Body>
                Nessuna pratica disponibile
            </Body>
        </Card>
    }
}

@code {
    [Inject]
    public NavigationManager _navigationManager { get; set; } = default!;

    [Parameter, EditorRequired]
    public IEnumerable<IstanzaListItem> Items { get; set; } = default!;

    [Parameter]
    public bool IsLoading { get; set; } = true;

    [Parameter]
    public ViewMode Mode { get; set; } = ViewMode.ArchivioPratiche;

    private const int _elementiSkeleton = 10;
}
