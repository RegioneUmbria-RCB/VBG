@using VBG.BlazorComponentsLibrary.AccessibilityComponents

<div class="card-body d-flex align-items-center">

    <!-- Icon -->
    <div class="me-3 p-3 bg-primary bg-opacity-10 rounded-circle">
        <SvgIcon IconId="@IconClass" CssClass="icon-primary"></SvgIcon>
    </div>

    <!-- Text content -->
    <div>
        <h5 class="card-title mb-1">@Title</h5>
        @if (Items?.Any() == true)
        {
            <ul class="mb-0 ps-3">
                @foreach (var item in Items)
                {
                    <li>@item.IdComune – @item.IdDomanda</li>
                }
            </ul>
        }
        else
        {
            <p class="card-text text-muted mb-0">@Text</p>
        }

    </div>

</div>

@code {
    [Parameter]
    public string IconClass { get; set; } = "it-exchange-circle";
    [Parameter]
    public string Title { get; set; } = "";
    [Parameter]
    public string Text { get; set; } = ""; 
    [Parameter]
    public IEnumerable<(string IdComune, int IdDomanda)>? Items { get; set; }

}
