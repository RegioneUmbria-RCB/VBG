<ModalComponent Id="@($"modal-{Id}")" ShowCloseButton="true" ShowHeader="true" CssContentClass="h-100" Scrollable="true" OnModalClose="@CloseModalFiltri">
    <HeaderTemplate>
        <h2 class="h3">Filtri</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <div class="row">
            <div class="col-md-12 mb-4">
                <LabelForm Id="txtIdComune"
                           Label="Id Comune"
                           ShowLabel="true">
                </LabelForm>
                <input id="txtIdComune" 
                       type="text"
                       width="100%"
                       @bind="filtriSelezionati!.idComune" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <DateInput Id="@($"{Id}-start-date")"
                           Label="Dalla data"
                           Value="@filtriSelezionati?.startDate"
                           ValueChanged="EventCallback.Factory.Create(this, (DateTime? d) => filtriSelezionati!.startDate = d)">
                </DateInput>
            </div>

            <div class="col-md-6">
                <DateInput Id="@($"{Id}-end-date")"
                           Label="Alla data"
                           Value="@filtriSelezionati?.endDate"
                           ValueChanged="EventCallback.Factory.Create(this, (DateTime? d) => filtriSelezionati!.endDate = d)">
                </DateInput>
            </div>

        </div>
        <br />
        <button class="btn btn-primary" aria-labelledby="buttonApplicaFiltri" data-bs-dismiss="modal" @onclick="@(async () => await filtriChanged())"><span id="buttonApplicaFiltri">Applica</span></button>
        <button class="btn btn-secondary" aria-labelledby="buttonReimpostaFiltri" data-bs-dismiss="modal" @onclick="@(async () => await filtriReset())"><span id="buttonReimpostaFiltri">Reimposta</span></button>
    </BodyTemplate>
</ModalComponent>

@code {
    private FiltroIstanzeBloccate filtri = new();
    private FiltroIstanzeBloccate filtriSelezionati = new();

    /// <summary>
    /// The component unique Id
    /// </summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public OrderByDate OrdinaPer { get; set; } = OrderByDate.DataDiscendente;

    [Parameter]
    public EventCallback<OrderByDate> OrdinaChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    // [Inject]
    // public NavigationManager _navigationManager { get; set; } = default!;

    private async Task SetOrder(OrderByDate order)
    {
        OrdinaPer = order;

        await OrdinaChanged.InvokeAsync(order);
    }


    /// <summary>
    /// The event connected to FiltriDiRicerca parameter
    /// </summary>
    [Parameter]
    public EventCallback<FiltroIstanzeBloccate> FiltriChanged { get; set; }

    private async Task filtriChanged()
    {
        if (filtriSelezionati.startDate != filtri.startDate)
        {
            filtri.startDate = filtriSelezionati.startDate;
        }

        if (filtriSelezionati.endDate != filtri.endDate)
        {
            filtri.endDate = filtriSelezionati.endDate;
        }

        if (filtriSelezionati.idComune != filtri.idComune)
        {
            filtri.idComune = filtriSelezionati.idComune;
        }

        await FiltriChanged.InvokeAsync(filtri);
    }

    private async Task filtriReset()
    {
        filtri = new();
        filtriSelezionati = new();

        await FiltriChanged.InvokeAsync(filtri);
    }

    // private async Task OnFiltroClose(TipoFiltroIstanzeDaCorreggere tipoFiltro)
    // {
    //     switch (tipoFiltro)
    //     {
    //         case TipoFiltroIstanzeDaCorreggere.Data:
    //             filtriSelezionati.startDate =
    //             filtriSelezionati.endDate = null;
    //             filtri.startDate = filtriSelezionati.startDate;
    //             filtri.endDate = filtriSelezionati.endDate;

    //             break;

    //         case TipoFiltroIstanzeDaCorreggere.Richiedente:
    //             filtriSelezionati.idComune = null;
    //             filtri.idComune = filtriSelezionati.idComune;
    //             break;
    //     }
    //     await FiltriChanged.InvokeAsync(filtri);
    // }

    private void CloseModalFiltri()
    {
        filtriSelezionati.endDate = filtri.endDate;
        filtriSelezionati.startDate = filtri.startDate;
        filtriSelezionati.idComune = filtri.idComune;
    }
}
