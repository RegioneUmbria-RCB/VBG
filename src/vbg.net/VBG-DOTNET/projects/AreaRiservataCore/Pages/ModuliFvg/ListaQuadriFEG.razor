@page "/modulifvg/{Alias}/{Software}/compila/{IdDomandaFEG:long}/{IdQuadro}"
@inherits FVGComponentBase
@using AreaRiservataCore.Utils
@using Init.Sigepro.FrontEnd.AppLogic.GestioneServiziFVG;
@using VBG.BlazorComponentsLibrary.DesignComuni.Spinner
@using VBG.BlazorComponentsLibrary.RisorseTestuali
@using static Init.Sigepro.FrontEnd.AppLogic.GestioneServiziFVG.ServiziFVGService;

