    .schede-da-compilare {
        list-style-type: none;
    }

        .schede-da-compilare > li {
            margin-left: -30px;
        }

            .schede-da-compilare > li.compilata,
            .schede-da-compilare > li.compilata > a {
                color: var(--bs-success);
            }

            .schede-da-compilare > li > i.fa {
                display: inline-block;
                margin-right: var(--bs-border-radius);
            }
    /*
                        .schede-da-compilare > li > a:before {
                            position: relative;
                            top: 1px;
                            display: inline-block;
                            font-family: 'Glyphicons Halflings';
                            font-style: normal;
                            font-weight: 400;
                            line-height: 1;
                            -webkit-font-smoothing: antialiased;
                            content: "\270f";
                            padding-right: 5px;
                        }

                        .schede-da-compilare > li.compilata > a:before {
