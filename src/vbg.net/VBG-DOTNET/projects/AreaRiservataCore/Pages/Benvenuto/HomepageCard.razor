@using Init.Sigepro.FrontEnd.AppLogic.GestioneMenu.Model
@using VBG.BlazorComponentsLibrary.AccessibilityComponents


<div class="card card-bg card-teaser d-flex justify-content-center align-items-center h-100 ms-0">
    <a href="@Url" target="@Target" class="w-100">
        <div class="card-body p-1">
            <div class="row">
                <div class="col-1 d-none d-md-flex justify-content-center align-items-center">
                    @if (!String.IsNullOrEmpty(Icona?.ToString()))
                    {
                        <i class="@Icona.ToString() fs-1" aria-hidden="true"></i>
                    }
                </div>
                <div class="col-10 mx-1">
                    <div>
                        <h2 class="titolo-card">@Titolo</h2>
                    </div>
                    <div class="text-wrap descrizione-card">
                        @((MarkupString)Descrizione)
                    </div>
                </div>
            </div> 
        </div>
    </a>        
</div>


@code {
    [Parameter]
    public IMenuIcon Icona { get; set; } = default!;

    [Parameter]
    public string Titolo { get; set; } = "";

    [Parameter]
    public string Descrizione { get; set; } = "";

    [Parameter]
    public string Target { get; set; } = "";

    [Parameter]
    public string Url { get; set; } = "";
}
