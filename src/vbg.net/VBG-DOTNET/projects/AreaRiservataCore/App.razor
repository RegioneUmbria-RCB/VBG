@using AreaRiservataCore.Auth
@using Init.Sigepro.FrontEnd.AppLogic.Autenticazione.Vbg
@using Init.Sigepro.FrontEnd.AppLogic.Autenticazione.Vbg.AutenticazioneUtente
@using Init.Sigepro.FrontEnd.AppLogic.Common
@using Init.Sigepro.FrontEnd.CoreServices.Autenticazione
@using Microsoft.AspNetCore.WebUtilities
@inject CustomAuthStateProvider _authenticationStateProvider;
@inject TokenProvider _tokenProvider;
@inject AliasSoftwareProvider _aliasSoftwareProvider;


<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <CascadingValue Name="AppRouteData" Value="@routeData">

            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                @*
					<NotAuthorized>
					<!--<RedirectToLogin></RedirectToLogin> -->
					oops, non sei autenticato
					</NotAuthorized>*@
            </AuthorizeRouteView>
            @* <FocusOnNavigate RouteData="@routeData" Selector="#pageTop" /> *@
            <!-- <RouteDataHandler /> -->

        </CascadingValue>

    </Found>
    <NotFound>
        <CascadingAuthenticationState>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <PageTitle>Pagina non trovata</PageTitle>

                <h1>Pagina non trovata</h1>
                <p role="alert">La pagina richiesta non è stata trovata</p>
            </LayoutView>
        </CascadingAuthenticationState>
    </NotFound>
</Router>

@code {

    [Parameter]
    public InitialApplicationState? InitialApplicationState { get; set; }

    protected override Task OnInitializedAsync()
    {
		if(InitialApplicationState is null)
		{
			throw new Exception("Applicazione non inizializzata correttamente");
		}

		this._tokenProvider.Token = InitialApplicationState.Token;
		this._aliasSoftwareProvider.AliasComune = InitialApplicationState.Alias;
		this._aliasSoftwareProvider.Software = InitialApplicationState.Software;

		this._authenticationStateProvider.Login(InitialApplicationState.UserAuthenticationResult);

		return base.OnInitializedAsync();
	}
}
