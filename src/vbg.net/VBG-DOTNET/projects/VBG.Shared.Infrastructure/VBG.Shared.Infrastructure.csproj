<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Label="Globals">
		<Configurations>Debug;Release;ReleaseFramework</Configurations>
		<TargetFrameworks>net10.0;net48</TargetFrameworks>
		<RootNamespace>VBG.Shared.Infrastructure</RootNamespace>
		<AssemblyName>VBG.Shared.Infrastructure</AssemblyName>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Platforms>AnyCPU</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
		<PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'netstandard2.0' ">
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
		<!--<Reference Include="System.ServiceModel" />-->
		<Reference Include="System.Web" />
		<PackageReference Include="Ninject" Version="3.3.6" />
		<PackageReference Include="Ninject.Web.Common" Version="3.3.2" />
	</ItemGroup>

</Project>