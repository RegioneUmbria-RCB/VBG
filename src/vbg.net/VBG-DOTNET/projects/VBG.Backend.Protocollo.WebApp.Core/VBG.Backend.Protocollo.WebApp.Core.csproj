<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerImageLabels>BUILD_DATE=$([System.DateTime]::Now.ToString("yyyy.MM.dd"))</DockerImageLabels>
    <DockerfileContext>..\..</DockerfileContext>
    <DockerfileTag>vbg.protocollo</DockerfileTag>
    <DockerfileBuildArguments>--build-arg PAT=$(PAT)</DockerfileBuildArguments>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UserSecretsId>a8139c96-a1cc-42a0-8e42-98d9dd21c827</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VBG.Backend.Protocollo.AppLogic.Core\VBG.Backend.Protocollo.AppLogic.Core.csproj" />
    <ProjectReference Include="..\VBG.Backend.Protocollo.AppLogic.Shared\VBG.Backend.Protocollo.AppLogic.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Security" Version="4.10.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Duplex" Version="4.10.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="4.10.*" />
    <PackageReference Include="System.ServiceModel.Federation" Version="4.10.*" />
  </ItemGroup>
</Project>