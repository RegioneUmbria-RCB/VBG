<HeadContent>
    <style>
        .bwc-autocomplete {
            position: relative;
        }

        .bwc-autocomplete-input {
            width: 100%;
        }

        .bwc-autocomplete-panel {
            position: absolute;
            left: 0;
            right: 0;
            background-color: #ffffff;
            border: 1px solid #e0e1e4;
            overflow: auto;
            box-sizing: content-box;
        }

        .bwc-autocomplete-items {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .bwc-autocomplete-list-item {
            padding: 0.5em;
            transition: all 0.1s linear;
            cursor: default;
            font-size: 0.9em;
        }

        .bwc-autocomplete-list-item:hover,
        .bwc-autocomplete-items li:hover {
            background-color: rgba(17, 81, 243, 0.16);
            color: #1151F3;
        }
    </style>

    
</HeadContent>

