@using System.Data
@using static Vbg.CoreControls.DataGrid.Enumerators
@typeparam TItem
@inherits MyBaseComponentDataBounded<DataGridRow<TItem>>

<div class="@_cssClasses" id="@UniqueID">
    @if (EnableSearching || !string.IsNullOrEmpty(GridTitle))
    {
        <div class="table-header">
            <div class="row">
                <div class="col-sm-8">
                    @if (!string.IsNullOrEmpty(GridTitle))
                    {
                        <h3 class="panel-title">@GridTitle</h3>
                    }
                </div>
                <div class="col-sm-4">
                    @if (EnableSearching)
                    {
                        <div style="text-align:right;">
                            <label for="@($"{UniqueID}_search")" style="font-weight: normal">Cerca:</label>
                            <input id="@($"{UniqueID}_search")" type="search" value="@CurrentFilter" @onchange="OnFilterAsync" class="form-control input-sm" style="display:inline-block; width:auto;" />
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <table class="table table-striped table-hover">
        @if (_rowsToDisplay == null || !_rowsToDisplay.Any())
        {
            <tbody>
                <tr>
                    <td>
                        @DataSourceEmptyTemplate
                    </td>
                </tr>
            </tbody>
        }
        else
        {
            <thead>
                <tr>
                    @foreach (IDataGridColumn c in _rowsToDisplay != null && _rowsToDisplay.Any() ? _rowsToDisplay.FirstOrDefault().Columns : Enumerable.Empty<object>())
                    {
                        if (c.ShowHeader)
                        {
                            if (string.IsNullOrEmpty(c.Width))
                            {
                                <th class="@getOrderedCssClass(c.Key)" @onclick="() => OnSortAsync(c.Key)" @onclick:preventDefault>
                                    @c.HeaderText
                                </th>
                            }
                            else
                            {
                                <th class="@getOrderedCssClass(c.Key)" style="width:@c.Width" @onclick="() => OnSortAsync(c.Key)" @onclick:preventDefault>
                                    @c.HeaderText
                                </th>
                            }
                        }
                        else
                        {
                            if (string.IsNullOrEmpty(c.Width))
                            {
                                <td style="border-bottom: 2px solid #ddd;"></td>
                            }
                            else
                            {
                                <td style="border-bottom: 2px solid #ddd; width:@c.Width"></td>
                            }
                        }
                    }

                    @if (EnableEditing)
                    {
                        <td style="border-bottom: 2px solid #ddd; width:150px;"></td>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DataGridRow<TItem> r in _rowsToDisplay != null ? _rowsToDisplay : Enumerable.Empty<object>())
                {
                    <tr @key="r">
                        @foreach (IDataGridColumn c in r.Columns)
                        {
                            @switch (c)
                            {
                                case DataGridButtonColumn buttonCol:

                                    <td class="@buttonCol.CssClass_row">
                                        <DataGridButtonGroup>
                                            @foreach (GridButton button in buttonCol.Buttons)
                                            {
                                                <DataGridButton Text="@button.Text" OnClick="@button.OnClick"></DataGridButton>
                                            }
                                        </DataGridButtonGroup>
                                    </td>
                                    break;

                                case DataGridScaricaOggettoColumn downloadCol:

                                    <td class="@downloadCol.CssClass_row">
                                        <ScaricaOggettoComponent CodiceOggetto="@downloadCol.CodiceOggetto" Text="@downloadCol.Text"></ScaricaOggettoComponent>
                                    </td>
                                    break;

                                case DataGridColumn column:

                                    <td class="@column.CssClass_row">
                                        @if (column.IdTemplate >= 0)
                                        {
                                            if (r.EditMode)
                                            {
                                                @EditingItemTemplates[column.IdTemplate](column)
                                            }
                                            else
                                            {
                                                @ItemTemplates[column.IdTemplate](column)
                                            }
                                        }
                                        else
                                        {

                                            @if (string.IsNullOrEmpty(column.DataFormatString))
                                            {
                                                @column.Value
                                            }
                                            else
                                            {
                                                @string.Format(column.DataFormatString, column.Value)
                                            }
                                        }
                                    </td>

                                    break;
                            }
                        }

                        @if (EnableEditing)
                        {
                            <td class="editingColumn">
                                <DataGridButtonGroup>
                                    @if (!r.EditMode)
                                    {
                                        <DataGridButton Text="Modifica" Icon="fa fa-pencil" OnClick="() => OnEditAsync(r)"></DataGridButton>

                                        @if (ShowDeleteButton)
                                        {
                                            <DataGridButton Text="Elimina" Icon="fa fa-trash" OnClick="() => OnDeleteAsync(r)"></DataGridButton>
                                        }
                                    }
                                    else
                                    {
                                        <DataGridButton Text="Conferma" Icon="fa fa-check" OnClick="() => OnConfirmAsync(r)"></DataGridButton>
                                        <DataGridButton Text="Annulla" Icon="fa fa-share" OnClick="() => OnUndoAsync(r)"></DataGridButton>
                                    }
                                </DataGridButtonGroup>
                            </td>

                        }
                    </tr>
                }
            </tbody>
        }
    </table>
    @if (EnablePaging && _rows.Count > 0)
    {
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm">
                    <label for="@($"{UniqueID}_itemsPP")" style="font-weight: normal">Elementi per pagina</label>
                    <select id="@($"{UniqueID}_itemsPP")" @onchange="OnChangeItemsPerPageAsync" value="@ItemsPerPage" class="form-control itemsPerPage" style="padding:6px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                @if (_rows.Count > ItemsPerPage)
                {
                    <div class="col-sm d-flex justify-content-center">                        
                        <nav role="navigation" aria-label="Page Navigation">
                            <ul class="pagination">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link lh-inherit" href="#" aria-label="Goto first page" @onclick="GoToFirstAsync" @onclick:preventDefault>
                                        <span class="fa fa-step-backward"></span><span class="sr-only">First</span>
                                    </a>
                                </li>
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link lh-inherit" href="#" aria-label="Goto previous page" @onclick="PreviousPageAsync" @onclick:preventDefault>
                                        <span class="fa fa-chevron-left"></span><span class="sr-only">Previous</span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <span class="page-link lh-inherit">
                                        Pagina <input type="number" value="@CurrentPage" aria-label="Vai a una pagina specifica" title="pagina numero" class="form-control pageInput" @onchange="SetPageAsync" style="text-align: right" /> di @PagesCount
                                    </span>
                                </li>
                                <li class="page-item @(CurrentPage == PagesCount ? "disabled" : "")">
                                    <a class="page-link lh-inherit" href="#" aria-label="Goto next page" @onclick="NextPageAsync" @onclick:preventDefault>
                                        <span class="fa fa-chevron-right"></span><span class="sr-only">Next</span>
                                    </a>
                                </li>
                                <li class="page-item @(CurrentPage == PagesCount ? "disabled" : "")">
                                    <a class="page-link lh-inherit" href="#" aria-label="Goto last page" @onclick="GoToLastAsync" @onclick:preventDefault>
                                        <span class="fa fa-step-forward"></span><span class="sr-only">Last</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }

                <div class="col-sm d-flex justify-content-end">
                    @if (!string.IsNullOrEmpty(CurrentFilter))
                    {
                        <span>Il filtro ha trovato @FilteredItemCount elementi (su @ItemCount totali)</span>
                    }
                    else
                    {
                        <span>Elementi totali: @FilteredItemCount</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string GridTitle { get; set; } = "";

    [Parameter]
    public List<RenderFragment<DataGridColumn>>? ItemTemplates { get; set; }

    [Parameter]
    public List<RenderFragment<DataGridColumn>>? EditingItemTemplates { get; set; }

    [Parameter]
    public RenderFragment? DataSourceEmptyTemplate { get; set; }

    [Parameter]
    public int ItemsPerPage { get; set; } = 10;

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public bool EnablePaging { get; set; } = false;

    [Parameter]
    public bool EnableSorting { get; set; } = false;

    [Parameter]
    public bool EnableSearching { get; set; } = false;

    [Parameter]
    public bool EnableEditing { get; set; } = false;

    [Parameter]
    public bool ShowDeleteButton { get; set; } = false;

    [Parameter]
    public Action<TItem>? OnRowEdit { get; set; }

    [Parameter]
    public Action<TItem>? OnRowConfirm { get; set; }

    [Parameter]
    public Action<TItem>? OnRowDelete { get; set; }

    [Parameter]
    public string CurrentFilter { get; set; } = "";

    [Parameter]
    public string OrderBy { get; set; } = "";

    [Parameter]
    public SortOrder Order { get; set; } = SortOrder.DESCENDING;

    private List<DataGridRow<TItem>> _rows { get; set; } = default!;
    private List<DataGridRow<TItem>> _rowsToDisplay { get; set; } = default!;

    protected int ItemCount => this.Data?.Count() ?? 0;

    protected int FilteredItemCount => this._rows?.Count() ?? 0;

    protected int PagesCount
    {
        get
        {
            int numberOfPages = (int)Math.Ceiling((decimal)(FilteredItemCount / (float)ItemsPerPage));

            if (numberOfPages < 1)
            {
                numberOfPages = 1;
            }

            return numberOfPages;
        }
    }

    private string getOrderedCssClass(string colName)
    {
        if (!EnableSorting)
            return string.Empty;

        if (colName == OrderBy)
        {
            if (Order == SortOrder.ASCENDING)
                return "sorting_asc";
            else
                return "sorting_desc";
        }
        else
            return "sorting";
    }

    //protected override Task OnInitializedAsync()
    //{
    //    if (string.IsNullOrEmpty(OrderBy) && this.Data.Count() > 0)
    //        OrderBy = this.Data.FirstOrDefault().Columns.FirstOrDefault().Key;

    //    filterRows();
    //    sortRows();
    //    displayRows();

    //    return base.OnInitializedAsync();
    //}

    protected override async Task OnParametersSetAsync()
    {
        FilterRows();
        SortRows();
        DisplayRows();

        await base.OnParametersSetAsync();
    }

    private void FilterRows()
    {
        _rows = this.Data.ToList();

        if (EnableSearching)
        {
            _rows = _rows.Where(r => r.Columns.Any(c =>
                c is DataGridColumn &&
                ((DataGridColumn)c).AllowFiltering &&
                ((((DataGridColumn)c).Value != null && ((DataGridColumn)c).Value.ToString().Contains(CurrentFilter, StringComparison.CurrentCultureIgnoreCase)) ||
                (((DataGridColumn)c).Parameters != null && ((DataGridColumn)c).Parameters.Any(p => p.ToString().Contains(CurrentFilter, StringComparison.CurrentCultureIgnoreCase)))))
            ).ToList();
        }
    }

    private void SortRows()
    {
        if (!EnableSorting || _rows.Count == 0 || string.IsNullOrEmpty(OrderBy))
            return;

        IDataGridColumn? c = _rows[0].Columns.FirstOrDefault(x => x is DataGridColumn && x.Key == OrderBy);

        if (c == null)
            return;

        switch (Type.GetTypeCode(((DataGridColumn)c).Value.GetType()))
        {
            case TypeCode.String:
                _rows.Sort((r1, r2) =>
                {
                    int ret = string.Compare(((DataGridColumn)r1.Columns.FirstOrDefault(c => c is DataGridColumn && c.Key == OrderBy)).Value.ToString(), ((DataGridColumn)r2.Columns.FirstOrDefault(c => c is DataGridColumn && c.Key == OrderBy)).Value.ToString());
                    return Order == SortOrder.ASCENDING ? ret : ret * -1;
                });
                break;

            case TypeCode.DateTime:
                _rows.Sort((r1, r2) =>
                {
                    int ret = DateTime.Compare(Convert.ToDateTime(((DataGridColumn)r1.Columns.FirstOrDefault(c => c is DataGridColumn && c.Key == OrderBy)).Value), Convert.ToDateTime(((DataGridColumn)r2.Columns.FirstOrDefault(c => c is DataGridColumn && c.Key == OrderBy)).Value));
                    return Order == SortOrder.ASCENDING ? ret : ret * -1;
                });
                break;

            case TypeCode.Int32:
                _rows.Sort((r1, r2) =>
                {
                    int ret = Convert.ToInt32(((DataGridColumn)r1.Columns.FirstOrDefault(c => c is DataGridColumn && c.Key == OrderBy)).Value).CompareTo(Convert.ToInt32(((DataGridColumn)r2.Columns.FirstOrDefault(c => c is DataGridColumn && c.Key == OrderBy)).Value.ToString()));
                    return Order == SortOrder.ASCENDING ? ret : ret * -1;
                });
                break;
        }


    }

    private void DisplayRows()
    {
        if (EnablePaging)
        {
            int start = ItemsPerPage * (CurrentPage - 1);
            int stop = CurrentPage != PagesCount ? ItemsPerPage : FilteredItemCount - start;

            _rowsToDisplay = _rows.GetRange(start, stop);
        }
        else
        {
            _rowsToDisplay = _rows;
        }
    }

    private async Task OnFilterAsync(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;

        CurrentFilter = e.Value?.ToString() ?? String.Empty;
        CurrentPage = 1;

        FilterRows();
        SortRows();
        DisplayRows();

        await Task.CompletedTask;
    }

    private async Task OnSortAsync(string colName)
    {
        if (colName == OrderBy)
        {
            Order = Order == SortOrder.ASCENDING ? SortOrder.DESCENDING : SortOrder.ASCENDING;
        }
        else
        {
            Order = SortOrder.DESCENDING;
            OrderBy = colName;
        }

        SortRows();
        DisplayRows();

        await Task.CompletedTask;
    }

    private async Task NextPageAsync()
    {
        if (CurrentPage != PagesCount)
        {
            CurrentPage++;
            DisplayRows();
        }

        await Task.CompletedTask;
    }

    private async Task PreviousPageAsync()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            DisplayRows();
        }

        await Task.CompletedTask;
    }

    private async Task SetPageAsync(ChangeEventArgs e)
    {
        int page = 1;

        if (e.Value != null && e.Value.ToString() != string.Empty)
            page = Convert.ToInt32(e.Value);

        if (page > PagesCount)
            page = PagesCount;

        if (page < 1)
            page = 1;

        CurrentPage = page;
        DisplayRows();

        await Task.CompletedTask;
    }

    private async Task GoToFirstAsync()
    {
        CurrentPage = 1;
        DisplayRows();

        await Task.CompletedTask;
    }

    private async Task GoToLastAsync()
    {
        CurrentPage = PagesCount;
        DisplayRows();

        await Task.CompletedTask;
    }

    protected async Task OnChangeItemsPerPageAsync(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            int.TryParse(e.Value.ToString(), out int itemsPerPage);
            ItemsPerPage = itemsPerPage;
            CurrentPage = 1;

            DisplayRows();
        }

        await Task.CompletedTask;
    }

    private async Task OnEditAsync(DataGridRow<TItem> r)
    {
        r.EditMode = true;

        if (OnRowEdit != null)
        {
            if (r.RowData == null)
                throw new Exception("La proprietà RowData della DataGridRow non è stata valorizzata");

            OnRowEdit.Invoke(r.RowData);
        }

        await Task.CompletedTask;
    }

    private async Task OnDeleteAsync(DataGridRow<TItem> r)
    {
        if (OnRowDelete != null)
            OnRowDelete.Invoke(r.RowData);

        await Task.CompletedTask;
    }

    private async Task OnConfirmAsync(DataGridRow<TItem> r)
    {
        r.EditMode = false;

        if (OnRowConfirm != null)
            OnRowConfirm.Invoke(r.RowData);

        await Task.CompletedTask;
    }

    private async Task OnUndoAsync(DataGridRow<TItem> r)
    {
        r.EditMode = false;

        await Task.CompletedTask;
    }
}
