@* @using Init.SIGePro.DatiDinamici *@
@using Vbg.CoreControls
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

@inject Vbg.CoreControls.ComponentCallback componentCallback
@*
<h4>Modello: @ModelliDinamici.Titolo</h4>


<table>
@foreach (RigaModelloDinamico r in ModelliDinamici.Righe)
{
    int colonna = 1;

    @if (r..IsEmpty)
    {
        <tr><td>&nbsp;</td></tr>
    }
    else
    {
        <tr>
        @foreach (CampoDinamico campo in r.Campi)
        {
            @if(r.RigaMultipla)
            {                
                <td>                        
                    <table class="table table-bordered table-responsive-md table-striped text-center">
                        <thead class="thead-dark">
                            <tr>
                                @for (int col=0; col < @r.IndiceUltimaColonna; col++)
                                {
                                    <th scope="col" class="text-center">
                                        @r.Campi[@col].Etichetta
                                    </th>
                                }
                                <th><a href="#" class="text-success" @onclick="@(e => @OnAddNewRow(@r))" @onclick:preventDefault><i class="fa fa-plus fa-2x" aria-hidden="true"></i></a></th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (int row=0; row<@r.NumeroMassimoValori; row++)
                        {
                            <tr>
                                @for (int col=0; col < r.IndiceUltimaColonna; col++)
                                {
                                    <td scope="row" class="pt-3-half">
                                        <DynamicComponent Type="@GetTipoCampo(@r.Campi[@col].Tipo)" Parameters="@GetCampoParameters(@r.Campi[@col], @row)"></DynamicComponent>
                                    </td>
                                }

                                <td>
                                    <span class="table-remove">
                                    @{int tempRow = row;}
                                        <button type="button" class="btn btn-danger btn-sm my-0" @onclick=@(e => @OnDeleteRow(@r, @tempRow))>Remove</button>
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </td>
                break;
            }
            else
            {
                while (campo.Colonna != colonna)
                {
                    <td></td>
                    colonna++;
                }                

                <td>                            
                    <DynamicComponent Type="@GetTipoCampo(campo.Tipo)" Parameters="@GetCampoParameters(campo, 0)"></DynamicComponent>
                </td>

                colonna++;
            }
        }
        </tr>
    }
}
</table>
*@

