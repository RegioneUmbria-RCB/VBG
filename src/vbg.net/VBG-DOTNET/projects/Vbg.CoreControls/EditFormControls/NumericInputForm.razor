@using Microsoft.AspNetCore.Components.Forms
@using Vbg.CoreControls
@using System.Linq.Expressions
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@typeparam TValue
@inherits MyBaseFormComponent<TValue>

<div class="mb-3 @CssClassContainer" id="@UniqueID">
    @if (ShowLabel)
    {
        <LabelContainerComponent RelativeControlId="@this.Id" ResourceId="@this.ResourceId" Value="@this.Label" Required="@this.Required" CanEditResourceText="@this.CanEditResourceText"></LabelContainerComponent>
    }
    
    <input type="number" id="@this.Id" class="form-control @this.CssClass @cssErrorClass" 
        @attributes="this.AdditionalAttributes" disabled="@this.IsDisabled"
        @onchange="Changed" value="@BindConverter.FormatValue(CurrentValueAsString)"
        aria-describedby="@(string.IsNullOrEmpty(HelpText) ? "" : $"{this.Id}_HelpDescription")"
        maxlength="@MaxLength" step="@step" style="@getStyle()" Culture="@Culture" />

    @if (!string.IsNullOrEmpty(HelpText))
    {
        <small id="@($"{this.Id}_HelpDescription")" class="help-block">
            @HelpText
        </small>
    }
    @if (ValidationFor != null)
    {
        <div class="form-control-validation help-block">
            <ValidationMessage For="@ValidationFor" />
        </div> 
    }
</div>

@code {
    public enum TextAlign
    {
        Right = 0,
        Left = 1
    }

    [Parameter]
    public string Culture { get; set; } = "it-IT";

    [Parameter] 
    public string ParsingErrorMessage { get; set; } = "The {0} field must be a number.";

    [Parameter]
    public TextAlign? TextAlignement { get; set; } = null;

    [Parameter]
    public string? ValoreMin { get; set; }

    [Parameter]
    public string? ValoreMax { get; set; }

    /// <summary>
    /// Set input MaxLength property
    /// </summary>
    [Parameter]
    public int? MaxLength { get; set; } = null;

    private string _formattedValue
    {
        get
        {
            if (Value == null)
            {
                return "";
            }

            return BindConverter.FormatValue(Value.ToString(), new CultureInfo(Culture));
        }
    }

    /// <summary>
    /// Set the increase/decrease step
    /// Default: "any"
    /// </summary>
    private string step { get; set; } = "any";

    private async Task Changed(ChangeEventArgs e)
    {
        TValue convertedVal;
        BindConverter.TryConvertTo<TValue>(e.Value, new CultureInfo(Culture), out convertedVal);
        Value = convertedVal;

        if (e.Value == null)
            await ValueChanged.InvokeAsync((TValue?)(object)null);
        else if (e.Value.ToString() == string.Empty)
            await ValueChanged.InvokeAsync((TValue?)(object)null);
        else if (typeof(TValue) == typeof(Int16) || typeof(TValue) == typeof(Int16?))
            await ValueChanged.InvokeAsync((TValue?)(object)Convert.ToInt16(e.Value));
        else if (typeof(TValue) == typeof(Int32) || typeof(TValue) == typeof(Int32?))
            await ValueChanged.InvokeAsync((TValue?)(object)Convert.ToInt32(e.Value));
        else if (typeof(TValue) == typeof(Int64) || typeof(TValue) == typeof(Int64?))
            await ValueChanged.InvokeAsync((TValue?)(object)Convert.ToInt64(e.Value));
        else if (typeof(TValue) == typeof(double) || typeof(TValue) == typeof(double?))
        {
            CultureInfo c = new CultureInfo(Culture);
            string valueToString = c.NumberFormat.NumberDecimalSeparator == "." ? e.Value.ToString() : e.Value.ToString().Replace(".", c.NumberFormat.NumberDecimalSeparator);
            double val = double.Parse(valueToString, new CultureInfo(Culture));

            await ValueChanged.InvokeAsync((TValue?)(object)val);
        }
        else if (typeof(TValue) == typeof(decimal) || typeof(TValue) == typeof(decimal?))
        {
            CultureInfo c = new CultureInfo(Culture);
            string valueToString = c.NumberFormat.NumberDecimalSeparator == "." ? e.Value.ToString() : e.Value.ToString().Replace(".", c.NumberFormat.NumberDecimalSeparator);
            decimal val = decimal.Parse(valueToString, new CultureInfo(Culture));

            await ValueChanged.InvokeAsync((TValue?)(object)val);
        }

        if (FieldIdentifier.FieldName != null)
        {
            EditContext?.NotifyFieldChanged(FieldIdentifier);
        }
    }

    private string getStyle()
    {
        string style = "";

        if (TextAlignement != null)
        {
            style += TextAlignement == TextAlign.Right ? "text-align: right;" : "text-align: left;";
        }

        return style;
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.InvariantCulture, out result))
        {
            validationErrorMessage = null;
            return true;
        }
        else
        {
            validationErrorMessage = string.Format(CultureInfo.InvariantCulture, ParsingErrorMessage, Label ?? DisplayName ?? FieldIdentifier.FieldName);
            return false;
        }
    }

    protected override string? FormatValueAsString(TValue? value)
    {
        // Avoiding a cast to IFormattable to avoid boxing.
        switch (value)
        {
            case null:
                return null;

            case int @int:
                step = "any";
                return BindConverter.FormatValue(@int, CultureInfo.InvariantCulture);

            case long @long:
                step = "any";
                return BindConverter.FormatValue(@long, CultureInfo.InvariantCulture);

            case short @short:
                step = "any";
                return BindConverter.FormatValue(@short, CultureInfo.InvariantCulture);

            case float @float:
                step = "0.01";
                return BindConverter.FormatValue(@float, CultureInfo.InvariantCulture);

            case double @double:
                step = "0.01";
                return BindConverter.FormatValue(@double, CultureInfo.InvariantCulture);

            case decimal @decimal:
                step = "0.01";
                return BindConverter.FormatValue(@decimal, CultureInfo.InvariantCulture);

            default:
                throw new InvalidOperationException($"Unsupported type {value.GetType()}");
        }
    }

    protected override bool PerformCustomValidation(FieldIdentifier fieldIdentifier, ValidationMessageStore messageStore)
    {
        if (string.IsNullOrEmpty(this.ValoreMin) && string.IsNullOrEmpty(this.ValoreMax))
            return true;

        var min = double.MinValue;
        var max = double.MaxValue;
        var val = 0.0d;

        var formatProvider = CultureInfo.InvariantCulture.NumberFormat;
        var numberStyles = NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite | NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint;

        if (!String.IsNullOrEmpty(this.ValoreMin))
        {
            if (!double.TryParse(this.ValoreMin, numberStyles, formatProvider, out min))
            {
                messageStore.Add(this.FieldIdentifier, $"Il valore minimo del campo {this.FieldIdentifier.FieldName} non è un numero valido (valore={this.ValoreMin}), verrà usato double.MinValue come valore minimo");
                min = double.MinValue;
            }
        }

        if (!String.IsNullOrEmpty(this.ValoreMax))
        {
            if (!double.TryParse(this.ValoreMax, numberStyles, formatProvider, out max))
            {
                messageStore.Add(this.FieldIdentifier, $"Il valore massimo del campo {this.FieldIdentifier.FieldName} non è un numero valido (valore={this.ValoreMax}), verrà usato double.MaxValue come valore massimo");
                max = double.MaxValue;
            }
        }

        if (!double.TryParse(this.CurrentValueAsString, numberStyles, formatProvider, out val))
        {
            messageStore.Add(this.FieldIdentifier, $"Il valore del campo {this.FieldIdentifier.FieldName} non è un numero valido (valore={this.CurrentValueAsString}), non verrà effettuata la verifica di appartenenza ad un range di valori");
            return true;
        }

        return min <= val && val <= max;
    }
}
