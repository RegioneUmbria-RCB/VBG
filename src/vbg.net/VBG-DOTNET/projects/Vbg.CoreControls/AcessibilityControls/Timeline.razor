
<div class="calendar-vertical mb-3" data-element="service-calendar-list">
    @foreach (var item in Items)
    {
        <div class="calendar-date">
            <h3 class="calendar-date-day">
                <small class="calendar-date-day__year">@item.Date.Year</small>
                <span class="title-xxlarge-regular d-flex justify-content-center">@item.Date.Day</span>
                <small class="calendar-date-day__month">@item.Date.ToString("MMMM")</small>
            </h3>
            <div class="calendar-date-description rounded">
                <div class="calendar-date-description-content">
                    @if (!string.IsNullOrEmpty(item.TitleLinkUrl))
                    {
                        <a href="@item.TitleLinkUrl"><h4 class="h5 mb-0">@item.Title</h4></a>
                    }
                    else
                    {
                        <h4 class="h5 mb-0">@item.Title</h4>
                    }

                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <div>@item.Description</div>
                    }
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter]
    public List<TimelineItem> Items { get; set; }
}
