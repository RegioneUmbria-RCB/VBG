<style>
    .form-check small {
        padding-left: 36px;
    }

    .form-check.form-check-right small {
        padding-left: 0px;
    }

    .form-check.form-check-right [type=checkbox] + label, 
    .form-check.form-check-right [type=radio] + label {
        position: static;
        padding-left: 0;
        padding-right: 52px;
    }

    .form-check.form-check-right [type=checkbox] + label::after,
    .form-check.form-check-right [type=checkbox] + label::before,
    .form-check.form-check-right [type=radio] + label::after,
    .form-check.form-check-right [type=radio] + label::before {
        right: 15px;
        left: auto;
    }

    .form-check.form-check-right [type=checkbox]:checked + label::before {
        right: 26px;
    }

    .form-check.form-check-right input.semi-checked:not(:checked) + label::before {
        right: 19px;
        left: auto;
    }
</style>

<div class="@GetFormCheckClass()">
    <input type="checkbox" id="@Id" class="@GetInputClass()" @bind="Checked" @oninput="OnInput" disabled="@(!Enabled)">
    <label for="@Id" class="@GetDisabledClass()">@Label</label>
    @if (!string.IsNullOrEmpty(HelperText))
    {
        <small id="@($"{Id}-help")" class="form-text d-block">@HelperText</small>
    }
</div>

@code {
    /// <summary>
    /// The checkbox id
    /// </summary>
    [Parameter, EditorRequired]
    public string Id { get; set; }

    /// <summary>
    /// The componet label
    /// </summary>
    [Parameter]
    public string Label { get; set; }

    /// <summary>
    /// A small description displayed under the Label
    /// </summary>
    [Parameter]
    public string HelperText { get; set; }

    /// <summary>
    /// Is checkbox checked
    /// </summary>
    private bool _checked = false;
    [Parameter]
    public bool Checked
    {
        get => _checked;
        set
        {
            if (_checked == value) return;

            _checked = value;
            CheckedChanged.InvokeAsync(value);
        }
    }

    /// <summary>
    /// Set to true to display a semiChecked state. (Works only if Checked property is false)
    /// </summary>
    [Parameter]
    public bool SemiChecked { get; set; } = false;

    /// <summary>
    /// Set to false to disable the checkbox
    /// </summary>
    [Parameter]
    public bool Enabled { get; set; } = true;

    /// <summary>
    /// Set to true if you want to display the Checkbox on the right of the Label
    /// </summary>
    [Parameter]
    public bool OnTheRightSide { get; set; } = false;

    /// <summary>
    /// Internal Event for binding. To assign a custom function Use OnClick event instead
    /// </summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// Optional Event to be called on click
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnClick { get; set; }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    private string GetDisabledClass()
    {
        return Enabled ? "" : "disabled";
    }

    private string GetFormCheckClass()
    {
        return OnTheRightSide ? "form-check form-check-right" : "form-check";
    }

    private string GetInputClass()
    {
        return SemiChecked ? "semi-checked" : "";
    }
}
