<CascadingValue Value="this">
    <div class="accordion">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// AccordionItem element
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }

    List<AccordionItem> items = new List<AccordionItem>();

    internal void AddItem(AccordionItem item)
    {
        items.Add(item);
    }
}
