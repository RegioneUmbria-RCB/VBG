@using Microsoft.JSInterop;
@inject IJSRuntime _jsRuntime
@inject NavigationManager _navigationManager

<div data-bs-toggle="sticky" data-bs-stackable="true">
    <nav class="navbar it-navscroll-wrapper navbar-expand-lg" aria-label="@Title" data-bs-navscroll="">
        <div class="navbar-custom" id="navbarNavProgress">
            <div class="menu-wrapper">
                <div class="link-list-wrapper">
                    <div class="accordion">
                        <div class="accordion-item">
                            <span class="accordion-header" id="navscroll-title">
                                <button class="accordion-button pb-10 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapsible" aria-expanded="true" aria-controls="collapsible" data-focus-mouse="false">
                                    @Title
                                    <svg class="icon icon-xs right">
                                        <use href="@($"{SvgFilePath}#it-expand")"></use>
                                    </svg>
                                </button>
                            </span>
                            <div class="progress">
                                <div class="progress-bar it-navscroll-progressbar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%;"></div>
                            </div>
                            <div id="collapsible" class="accordion-collapse collapse show" role="region" aria-labelledby="navscroll-title">
                                <div class="accordion-body">
                                    <ul class="link-list" data-element="page-index">
                                        @foreach (var item in Items)
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" href="@($"{GetUriWithoutFragment()}#{item.Id}")">
                                                    <span class="title-medium">@item.Label</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</div>

@code {
    /// <summary>
    /// Title of the page navigation scroller
    /// </summary>
    [Parameter]
    public string Title { get; set; }

    /// <summary>
    /// The sprites.svg file path used for icons
    /// </summary>
    [Parameter]
    public string SvgFilePath { get; set; } = "css/bootstrap-italia/svg/sprites.svg";

    /// <summary>
    /// Page Bookmarks collection
    /// NavScrollItem.Label: the string to display in the NavScroller
    /// NavScrollItem.Id: the html element id to scroll to
    ///
    /// Remember to use a container <div> element with class="it-page-sections-container" having child elements with class="it-page-section" for each bookmark
    /// </summary>
    [Parameter]
    public List<NavScrollItem> Items { get; set; }

    private string GetUriWithoutFragment()
    {
        if (!_navigationManager.Uri.Contains('#'))
            return _navigationManager.Uri;

        return _navigationManager.Uri.Split('#')[0];
    }
}
