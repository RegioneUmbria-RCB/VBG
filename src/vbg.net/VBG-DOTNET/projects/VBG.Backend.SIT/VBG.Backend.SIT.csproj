<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerImageLabels>BUILD_DATE=$([System.DateTime]::Now.ToString("yyyy.MM.dd"))</DockerImageLabels>
		<DockerfileContext>..\..</DockerfileContext>
		<DockerfileTag>vbg.sit</DockerfileTag>
		<DockerfileBuildArguments>--build-arg PAT=$(PAT)</DockerfileBuildArguments>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UserSecretsId>a8139c96-a1cc-42a0-8e42-98d9dd21c827</UserSecretsId>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="CoreWCF.Http" Version="1.9.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VBG.Backend.SIT.AppLogic\VBG.Backend.SIT.AppLogic.csproj" />
		<!--<ProjectReference Include="..\VBG.Shared.Infrastructure\VBG.Shared.Infrastructure.csproj" />-->
	</ItemGroup>

	<ItemGroup>
	  <None Update="logs\copiami">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
