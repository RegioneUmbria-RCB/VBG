<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..</DockerfileContext>
		<DockerfileBuildArguments>--build-arg PAT=$(PAT)</DockerfileBuildArguments>
		<DockerfileTag>vbg.generatore-riepiloghi-ar</DockerfileTag>
		<UserSecretsId>92caec1b-e829-49b7-90be-dfad5b94897c</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Gotenberg.Sharp.API.Client" Version="3.0.0" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.16.13" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.*" />
		<PackageReference Include="Serilog.Sinks.Graylog" Version="3.1.1" />
		<PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
		<PackageReference Include="VBG.DatiDinamici.Agid" Version="10.1.10" />
		<PackageReference Include="VBG.SecurityLibrary" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VBG.DatiDinamici.Agid.HtmlRendering\VBG.DatiDinamici.Agid.HtmlRendering.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="TemplatesHtml\singola-scheda.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="TemplatesHtml\template-schede-dinamiche.html">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="TemplatesHtml\template-schede-dinamiche-css.html">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
